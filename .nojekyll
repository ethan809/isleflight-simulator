  return null});
 return{triangles,min,max,imageBlobs};
}
// Downloaded, third-party CC0 geometry by tevy (https://tevy.dev/models/).
// None of the driveable vehicle shapes are generated by this simulator.
const licensedCarNames={
 'family-sedan':{file:'family-sedan.glb',name:'Family Sedan',length:4.76,width:1.88,height:1.57},
 'five-door-hatchback':{file:'five-door-hatchback.glb',name:'5-door Hatchback',length:4.13,width:1.79,height:1.54},
 'mid-size-suv':{file:'mid-size-suv.glb',name:'Mid-size SUV',length:4.88,width:1.96,height:1.89},
 'mid-engine-supercar':{file:'mid-engine-supercar.glb',name:'Mid-engine Supercar',length:4.48,width:2.02,height:1.19}
};
const licensedCars=new Map();
async function loadCarModels(){
 for(const [id,info] of Object.entries(licensedCarNames)){
  try{
   const response=await fetch('assets/'+info.file);if(!response.ok)throw Error('HTTP '+response.status);
   const source=decodeAirframeGLB(await response.arrayBuffer());
   const span=source.max.map((v,i)=>Math.max(.001,v-source.min[i]));
   // The meshes are Y-up. Preserve real body, wheel and interior proportions.
   const scales=[info.width/span[0],info.height/span[1],info.length/span[2]];
   const center=[(source.min[0]+source.max[0])*.5,source.min[1],(source.min[2]+source.max[2])*.5];
   const stride=Math.max(1,Math.ceil(source.triangles.length/7900));
   const geometry=[];
   for(let j=0;j<source.triangles.length;j+=stride){
    const t=source.triangles[j],color=t.colour||'#cdd2ce';
    const channels=[1,3,5].map(k=>Math.round(255*Math.pow(parseInt(color.slice(k,k+2),16)/255,1/2.2)));
    const bright='#'+channels.map(c=>c.toString(16).padStart(2,'0')).join('');
    geometry.push({points:t.p.map(v=>[(v[0]-center[0])*scales[0],(v[1]-center[1])*scales[1]+.05,(v[2]-center[2])*scales[2]]),color:bright});
   }
   licensedCars.set(id,geometry);
  }catch(error){console.warn('Unable to load licensed car '+id,error)}
  const loading=document.getElementById('driveLoading');
  if(loading)loading.textContent=licensedCars.size+' / '+Object.keys(licensedCarNames).length+' real 3D car models ready'+(licensedCars.size?' · Choose a vehicle and drive!':'');
 }
}
void loadCarModels();
function artistLiveryImage(source){
 const name=paint.value||'Isleflight';let cache=artistPaintCache.get(source.image);
 if(!cache){cache=new Map();artistPaintCache.set(source.image,cache)}if(cache.has(name))return cache.get(name);
 const base=source.image,canvas=document.createElement('canvas');canvas.width=base.width;canvas.height=base.height;
 const g=canvas.getContext('2d');g.drawImage(base,0,0);
 if(typeof g.getImageData==='function'){
  const pixels=g.getImageData(0,0,canvas.width,canvas.height),d=pixels.data;
  const primary=artistBodyColours[name]||'#f0f2f1',channels=[1,3,5].map(k=>parseInt(primary.slice(k,k+2),16));
  for(let i=0;i<d.length;i+=4){
   const r=d[i],green=d[i+1],blue=d[i+2],sat=green-r;
   // Repaint only the model's blank green airline-colour panels; preserve
   // photographed fans, cockpit windows, metal and anti-icing boundaries.
   // The A320/A350 authors used cyan as well as green for blank paint.
   // Leave dark blue cockpit glazing intact while replacing both colours.
   const greenPaint=green>r*1.21&&green>blue*1.14&&sat>15&&r<155;
   const cyanPaint=green>95&&blue>105&&green>r*1.25&&blue>r*1.25&&green+blue>255;
   const x=(i/4)%canvas.width,y=Math.floor(i/(4*canvas.width));
   const a220Marking=source.kind==='A220'&&((y>canvas.height*.31&&y<canvas.height*.53)||y>canvas.height*.63)&&blue>r*1.3&&blue>green*1.2&&blue>42&&r<125;
   if(greenPaint||cyanPaint||a220Marking){
    const light=clamp((r+green+blue)/120,.57,1.25);
    for(let j=0;j<3;j++)d[i+j]=clamp(channels[j]*light,0,255);
   }
  }
  g.putImageData(pixels,0,0);
 }
 if(source.kind==='A220'){
  // The authored A220 UV atlas contains Korean Air lettering and roundels.
  // Clear only their known atlas rectangles, preserving the cockpit glass,
  // cabin window rows, doors, metallic engine fans and wing details.
  // Normalized atlas coordinates accommodate alternative source resolutions.
  const body=artistBodyColours[name]||'#f1f4f3';
  const erase=(x0,y0,x1,y1,color=body)=>{g.fillStyle=color;g.fillRect(x0*canvas.width/1024,y0*canvas.height/1024,(x1-x0)*canvas.width/1024,(y1-y0)*canvas.height/1024)};
  for(const box of [[630,704,810,746],[174,837,406,878],[164,917,430,988],
   [576,357,666,433],[877,359,944,434],[670,190,723,239],[849,190,908,240],
   [98,438,125,473],[193,438,227,475],[352,438,384,474],[447,438,481,476],
   [163,14,285,81],[416,16,491,55],[630,433,661,453],[927,432,954,453]])erase(...box);
 }
 cache.set(name,canvas);return canvas;
}
function artistFighterPaint(image){
 const name=paint.value,cache=artistPaintCache.get(image)||new Map();
 artistPaintCache.set(image,cache);
 if(cache.has(name))return cache.get(name);
 const canvas=document.createElement('canvas');canvas.width=image.width;canvas.height=image.height;
 const g=canvas.getContext('2d');g.drawImage(image,0,0);
 const pixels=g.getImageData(0,0,canvas.width,canvas.height),d=pixels.data;
 const colors=displayPaint[name]||displayPaint['Silver / orange'];
 const target=colors.map(hex=>[1,3,5].map(i=>parseInt(hex.slice(i,i+2),16)));
 for(let i=0;i<d.length;i+=4){const r=d[i],green=d[i+1],blue=d[i+2];
  // Repaint the authored fighter's distinct blue and yellow panels; leave
  // its cockpit, shading, panel seams, and photographic detail visible.
  const navy=blue>r*1.23&&blue>green*1.16&&blue>65;
  const gold=Math.min(r,green)>125&&blue<Math.min(r,green)*.75;
  if(!navy&&!gold)continue;
  const light=clamp((r+green+blue)/(navy?260:385),.62,1.38),t=target[navy?0:1];
  for(let j=0;j<3;j++)d[i+j]=clamp(t[j]*light,0,255);
 }
 g.putImageData(pixels,0,0);cache.set(name,canvas);return canvas;
}
// Project an airline marking onto the artist's ORIGINAL triangles. The old
// billboard-like quads passed through curved fuselages and the wing roots,
// leaving floating copies of airline names visible from the chase camera.
// Clipping in the fuselage's longitudinal/vertical plane ensures that each
// decal follows its actual painted metal surface, not a rectangular sheet.
function b744ConformalDecal(surface,side,art,front,back,top,bottom){
 // The imported 747 contains several overlapping side-skin layers. Project
 // one continuous decal onto the OUTERMOST fuselage skin so repeated donor
 // triangles cannot stamp the same wordmark twice.
 const candidates=[];
 for(const obj of surface){if(obj.points.length!==3)continue;
  const p=obj.points,mid=p.reduce((v,q)=>v.map((a,k)=>a+q[k]/3),[0,0,0]);
  if(mid[0]*side<spec.bodyHeight*.06||Math.max(...p.map(q=>q[2]))<back||Math.min(...p.map(q=>q[2]))>front)continue;
  if(Math.max(...p.map(q=>q[1]))<bottom||Math.min(...p.map(q=>q[1]))>top)continue;
  const a=p[1].map((v,k)=>v-p[0][k]),b=p[2].map((v,k)=>v-p[0][k]);
  if(Math.abs(a[1]*b[2]-a[2]*b[1])<.17*Math.abs(a[2]*b[0]-a[0]*b[2]))continue;
  const area=(p[1][1]-p[2][1])*(p[0][2]-p[2][2])+(p[2][2]-p[1][2])*(p[0][1]-p[2][1]);
  if(Math.abs(area)>.0000001)candidates.push({p,area});
 }
 const nu=44,nv=10,grid=[];
 for(let j=0;j<=nv;j++)for(let i=0;i<=nu;i++){
  const z=mix(back,front,i/nu),y=mix(bottom,top,j/nv);let outer=-Infinity;
  for(const {p,area} of candidates){
   const a=((p[1][1]-p[2][1])*(z-p[2][2])+(p[2][2]-p[1][2])*(y-p[2][1]))/area;
   const b=((p[2][1]-p[0][1])*(z-p[2][2])+(p[0][2]-p[2][2])*(y-p[2][1]))/area,c=1-a-b;
   if(a<-.0001||b<-.0001||c<-.0001)continue;
   const x=side*(a*p[0][0]+b*p[1][0]+c*p[2][0]);if(x>outer)outer=x;
  }
  grid.push(Number.isFinite(outer)?{p:[side*(outer+.17),y,z],uv:[side>0?i/nu:1-i/nu,1-j/nv]}:null);
 }
