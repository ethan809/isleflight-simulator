 for(let x=Math.ceil((cx-w/(2*span))/1000)*1000;x<cx+w/(2*span);x+=1000){g.moveTo(X(x),0);g.lineTo(X(x),h)}
 for(let z=Math.ceil((cz-h/(2*span))/1000)*1000;z<cz+h/(2*span);z+=1000){g.moveTo(0,Y(z));g.lineTo(w,Y(z))}g.stroke();
 const fills=['#a5a69d','#b4b9b8','#b6b8a9','#c6b5a7'];
 g.lineWidth=.35;g.strokeStyle='#304c4d99';
 let renderedBuildings=0;
 for(const [x,z,height,kind,...offsets] of realBuildingFootprints){
  if(Math.abs(x-cx)>8500||Math.abs(z-cz)>7000||offsets.length<6)continue;
  g.beginPath();for(let k=0;k<offsets.length;k+=2){const px=X(x+offsets[k]),py=Y(z+offsets[k+1]);if(k)g.lineTo(px,py);else g.moveTo(px,py)}
