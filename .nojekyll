  const n=d.nose*front;
  z-=L*.20*n;
  y-=H*.70*n+H*.16*n*ripple;
  x*=1-.17*n;
  // Both wings can twist, fold down and shorten independently.
  const fold=wing*outer;
  y-=S*.24*fold;
  x-=Math.sign(x)*S*.135*fold;
  z-=L*.055*fold+H*.19*wing*ripple;
