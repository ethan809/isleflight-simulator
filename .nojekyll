 else for(const i of regionalIslands[activeMap]){ctx.fillStyle='#254c46';ctx.beginPath();for(let k=0;k<36;k++){const a=tau*k/36,rr=shore(i,a),x=mx+(i.x+i.rx*rr*Math.cos(a))*scale,y=mz-(i.z+i.rz*rr*Math.sin(a))*scale;if(k)ctx.lineTo(x,y);else ctx.moveTo(x,y)}ctx.closePath();ctx.fill()}
 for(let f of regionalFields[activeMap]){let x=mx+f.x*scale,y=mz-f.z*scale;if(x<-20||x>170||y<18||y>139)continue;const half=Math.max(1.5,Math.min(7,1200*scale));ctx.fillStyle=f===target?'#ffda65':'#89d7d4';ctx.fillRect(x-1,y-half,2,half*2);if(f===target||range<45000)label(f.name.slice(0,7),x+4,y+4,'#9ce8da',8)}
 ctx.strokeStyle='#d38bd9';ctx.setLineDash([3,3]);ctx.beginPath();ctx.moveTo(mx+p.x*scale,mz-p.z*scale);ctx.lineTo(mx+target.x*scale,mz-target.z*scale);ctx.stroke();ctx.setLineDash([]);
 for(const t of traffic){let x=mx+t.x*scale,y=mz-t.z*scale,col=['#a0dce2','#ffcb50','#ff615b'][t.level];shape([[x,y-3],[x+3,y],[x,y+3],[x-3,y]],col);if(t.level)label((t.dy>=0?'+':'')+Math.round(t.dy*.0328),x+3,y-2,col,8)}
