  if((paint.value==='British Airways'||paint.value==='Isleflight')&&h<-.38)base=belly;
  base=airlinerPaint(paint.value,h,z,base);
  if(isProp?z>9&&z<11.5&&h>.22&&h<.72:z>25.5&&z<29.5&&h>.64&&h<.93)base='#294352';
  return shade(base,a);
 },28);
 for(const side of [-1,1]){
  const mirror=points=>points.map(([x,y,z])=>[x*side,y,z]);
  const wing=(points,depth,c='#d8e0de')=>panelWing(mirror(points),depth,c,'#89999e');
  const fin=(points,c)=>part(points.map(([y,z])=>[side*.13,y,z]),c);
  if(isProp){
   wing([[.65,1.15,2.4],[9.5,1.25,1.32],[13.45,1.38,.12],[13.25,1.38,-1.21],[1,1.16,-1.82]],.18);
   wing([[1.5,1.18,-.84],[12.8,1.42,-.56],[12.8,1.42,-1.2],[1.5,1.18,-1.73]],.045,'#b6c6c7');
   fin([[.7,-8],[4.95,-11.65],[5.1,-13.2],[1,-12.35]],tail);
   wing([[.05,4.87,-11.3],[4.9,4.91,-12.4],[4.76,4.91,-13.5],[.05,4.87,-12.84]],.11);
   shell([[-3.1,.10,.10,.65],[-1.45,.55,.65,.55],[1.8,.67,.70,.60],[2.68,.46,.47,.61]],side*4.25,a=>shade(accent,a),16);
   shell([[2.65,.34,.34,.61],[3.26,.025,.025,.61]],side*4.25,a=>shade('#49545a',a),12);
   shell([[-4.25,.10,.1,-.8],[-2.2,.51,.54,-.72],[.38,.41,.44,-.76],[1.75,.08,.08,-.8]],side*1.24,a=>shade('#bac4c6',a),12);
   cabinWindows(side,1.34,.23,-6.7,20,.68,.31);
  }else{
   wing([[1.7,-.62,8],[11.4,-.35,3.65],[31.4,1.55,-11.8],[30.9,1.53,-14.1],[12,.05,-5.5],[2,-.58,-5.4]],.37);
   wing([[30.9,1.55,-14.1],[31.45,1.57,-11.8],[32.05,4.2,-13.18],[32.03,4.0,-14.15]],.07,accent);
   wing([[4,-.10,-3.1],[12,.19,-3.6],[28,1.47,-12.05],[12,.17,-5.34],[4,-.11,-5.18]],.10,'#b3c2c4');
   fin([[1.4,-17],[11.9,-28.9],[12.1,-31.8],[1.6,-30.8]],tail);
   wing([[1.1,1.2,-21],[10.9,2.2,-28],[10.65,2.22,-30],[1.0,1.25,-27]],.20);
   for(const [mount,z] of [[10.4,2.8],[19.1,-2.8]]){
    const x=side*mount;
    shell([[z-4.1,.46,.46,-1.8],[z-3.4,.93,.97,-1.83],[z-1.9,1.40,1.42,-1.73],[z+1.9,1.55,1.53,-1.70],[z+2.18,1.35,1.36,-1.70]],x,(a,k)=>shade(k===4?'#d5dedd':accent,a),20);
    disk(x,-1.7,z+2.19,1.33,'#23323b');disk(x,-1.7,z+2.21,.27,'#91a1a4');
    wing([[mount-.25,-1.6,z+1.2],[mount-.26,.06,z+.3],[mount+.30,.11,z-2.6],[mount+.31,-1.3,z-2.3]],.12,'#a3b1b6');
   }
   cabinWindows(side,3.16,.30,-18,64,.626,.40);
   cabinWindows(side,2.45,2.86,12.8,17,.64,.36);
  }
  if(airline||airlineCodes[paint.value]){
   const x=isProp?1.33:3.10,front=isProp?7.0:21.4,back=isProp?1.7:8.0;
   patchSide(side,x,front,back,isProp?1.12:2.72,isProp?.49:1.2,insignia[(airline||airlineCodes[paint.value])+'title']);
  }else if(paint.value!=='Isleflight'){
   patchSide(side,isProp?1.34:3.10,isProp?7:21.4,isProp?1.7:8,isProp?1.12:2.72,isProp?.49:1.2,airlineText(paint.value));
  }
  if(paint.value==='British Airways'||paint.value==='Isleflight'){
   fin(isProp?[[2.8,-10.45],[3.45,-10.66],[4.25,-13.0],[3.6,-12.92]]:[[5,-21.8],[7,-23.65],[10.3,-31.45],[8.3,-31.2]],stripe);
  }
