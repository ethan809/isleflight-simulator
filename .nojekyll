   const touchdownIAS=p.speed*Math.sqrt(density);
   if(touchdownIAS>landingSpeed()*1.16||p.flap<.38){
    damage(p,'gearHP',touchdownIAS>landingSpeed()*1.4?28:11,'Excessive touchdown speed');
