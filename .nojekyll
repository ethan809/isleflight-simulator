   part([[s*4.25+.16*Math.cos(a),.61+.16*Math.sin(a),3.27],[s*4.25+.31*Math.cos(a+.28),.61+.31*Math.sin(a+.28),3.27],[s*4.25+.57*Math.cos(a+.15),.61+.57*Math.sin(a+.15),3.22]],i%2?'#c6cbcc':'#55646b');
