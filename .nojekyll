   s([[side*(half-.70),1.36,z-pitch*.48],[side*(half-.70),1.36,z+pitch*.48],[side*(half-.70),1.47,z+pitch*.48],[side*(half-.70),1.47,z-pitch*.48]],'#d5cabe');
