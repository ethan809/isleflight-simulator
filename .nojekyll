const highlandAirports=[{"name":"Inverness","code":"EGPE","lat":57.5425,"lon":-4.0475,"x":56580,"z":-23074,"elevation":9},{"name":"Wick John O'Groats","code":"EGPC","lat":58.4589,"lon":-3.09306,"x":113276,"z":78830,"elevation":38},{"name":"Stornoway","code":"EGPO","lat":58.215599,"lon":-6.33111,"x":-79071,"z":51775,"elevation":8},{"name":"Benbecula","code":"EGPL","lat":57.481098,"lon":-7.36278,"x":-140354,"z":-29902,"elevation":6},{"name":"Barra","code":"EGPR","lat":57.0228,"lon":-7.44306,"x":-145123,"z":-80865,"elevation":2},{"name":"Oban","code":"EGEO","lat":56.463501,"lon":-5.39967,"x":-23741,"z":-143059,"elevation":6},{"name":"Broadford Airstrip","code":"EGEI","lat":57.253131,"lon":-5.827755,"x":-49170,"z":-55252,"elevation":7},{"name":"Plockton Airstrip","code":"GB-1273","lat":57.335499,"lon":-5.67308,"x":-39982,"z":-46093,"elevation":69},{"name":"Dornoch","code":"GB-DOC","lat":57.868999,"lon":-4.023,"x":58036,"z":13233,"elevation":0},{"name":"Kirkwall","code":"EGPA","lat":58.957903,"lon":-2.905077,"x":124443,"z":134319,"elevation":15},{"name":"Tiree","code":"EGPU","lat":56.499199,"lon":-6.86917,"x":-111032,"z":-139089,"elevation":12},{"name":"RAF Lossiemouth","code":"EGQS","lat":57.7052,"lon":-3.33917,"x":98657,"z":-4982,"elevation":13},{"name":"Glenforsa","code":"GB-ULL","lat":56.517202,"lon":-5.91401,"x":-54294,"z":-137087,"elevation":5},{"name":"Fort Augustus Airstrip","code":"GB-0442","lat":57.127577,"lon":-4.670706,"x":19561,"z":-69213,"elevation":140},{"name":"Achnasheen Airstrip","code":"GB-0539","lat":57.5708442,"lon":-5.1888389,"x":-11217,"z":-19922,"elevation":0},{"name":"Knockbain Farm Airstrip","code":"GB-0402","lat":57.589189,"lon":-4.466958,"x":31664,"z":-17882,"elevation":182},{"name":"Tain Ultralight Airstrip","code":"GB-0949","lat":57.81513,"lon":-3.969569,"x":61210,"z":7242,"elevation":0},{"name":"Glensanda Airstrip","code":"GB-0541","lat":56.5610514,"lon":-5.5474649,"x":-32520,"z":-132211,"elevation":0},{"name":"Coll","code":"EGEL","lat":56.601898,"lon":-6.61778,"x":-96099,"z":-127669,"elevation":6},{"name":"Easterton Glider Field","code":"GB-0441","lat":57.5874,"lon":-3.30685,"x":100576,"z":-18081,"elevation":110},{"name":"Glasgow","code":"EGPF","lat":55.871899,"lon":-4.43306,"x":33677,"z":-208845,"elevation":8}];
const highlandRaster={x0:-178200,z0:-234300,step:1100,width:310,height:379,data:''};
/* END REAL HIGHLANDS DATA */
// 8 by 8 geographical terrain chunks; metres are derived from real lat/lon.
const highlandBytes=Uint8Array.from(atob(highlandRaster.data),v=>v.charCodeAt(0));
const highlandSamples=new Uint16Array(highlandBytes.buffer);
highlandRaster.data='';
const highlandMapImage=document.createElement('canvas');
highlandMapImage.width=highlandRaster.width;highlandMapImage.height=highlandRaster.height;
{const ctx=highlandMapImage.getContext('2d'),pixels=ctx.createImageData(highlandRaster.width,highlandRaster.height);
 for(let z=0;z<highlandRaster.height;z++)for(let x=0;x<highlandRaster.width;x++){
  const h=highlandSamples[z*highlandRaster.width+x],p=((highlandRaster.height-1-z)*highlandRaster.width+x)*4;
  if(!h)continue;
  const t=Math.min(1,Math.max(0,(h-1)/1700));
  pixels.data[p]=Math.round(66+94*t);pixels.data[p+1]=Math.round(104+67*t);
  pixels.data[p+2]=Math.round(79+70*t);pixels.data[p+3]=255;
 }ctx.putImageData(pixels,0,0)}
function highlandElevationAt(x,z){
 const a=highlandRaster,fx=(x-a.x0)/a.step,fz=(z-a.z0)/a.step;
 if(fx<0||fz<0||fx>=a.width-1||fz>=a.height-1)return 0;
 const ix=Math.floor(fx),iz=Math.floor(fz),u=fx-ix,v=fz-iz;
 const at=(xx,zz)=>highlandSamples[zz*a.width+xx];
 const q00=at(ix,iz),q10=at(ix+1,iz),q01=at(ix,iz+1),q11=at(ix+1,iz+1);
 const coverage=(q00>0? (1-u)*(1-v):0)+(q10>0?u*(1-v):0)+(q01>0?(1-u)*v:0)+(q11>0?u*v:0);
 if(coverage<.42)return 0;
 const value=(q00*(1-u)*(1-v)+q10*u*(1-v)+q01*(1-u)*v+q11*u*v)/coverage;
 return Math.max(.02,(value-1)*.5);
}
const HIGHLAND_COLS=8,HIGHLAND_ROWS=8;
const highlandSpanX=(highlandRaster.width-1)*highlandRaster.step;
const highlandSpanZ=(highlandRaster.height-1)*highlandRaster.step;
const highlandChunkX=highlandSpanX/HIGHLAND_COLS,highlandChunkZ=highlandSpanZ/HIGHLAND_ROWS;
const highlandCentresKm=Array.from({length:HIGHLAND_COLS*HIGHLAND_ROWS},(_,j)=>[
 (highlandRaster.x0+(j%HIGHLAND_COLS+.5)*highlandChunkX)/1000,
 (highlandRaster.z0+(Math.floor(j/HIGHLAND_COLS)+.5)*highlandChunkZ)/1000]);
