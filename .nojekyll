let activeMap=0;
function refreshAirports(){airport.replaceChildren(...fields.filter(f=>f.region===activeMap).map(f=>new Option(f.name,f.name)));airport.value=fields.find(f=>f.region===activeMap).name}
refreshAirports();
homeX=fields[0].x;homeZ=fields[0].z;homeY=fields[0].elevation;reset();
regionSelect.onchange=()=>{
 activeMap=Number(regionSelect.value);refreshAirports();const start=destination();
 homeX=start.x;homeZ=start.z;homeY=start.elevation;reset();
 cityTourLabel.hidden=cityTourButton.hidden=landmarkLabel.hidden=landmarkTourButton.hidden=activeMap!==0&&activeMap!==4;
 townLabel.hidden=townTourButton.hidden=activeMap!==0;
 if(activeMap===4){
  cityTourTitle.textContent='England & Wales city flyover';
  cityTourSelect.replaceChildren(...englandCities.map(c=>new Option(c.name,c.name)));
  landmarkSelect.replaceChildren(...englandLandmarks.map(l=>new Option(l.name,l.name)));
  cityTourButton.textContent='Fly above 3D city';landmarkTourButton.textContent='Explore landmark model';
 }else{
  cityTourTitle.textContent='Real town flyover';
  cityTourSelect.replaceChildren(...Object.keys(cityTourStops).map(name=>new Option(name,name)));
  landmarkSelect.replaceChildren(...realCityLandmarks.map(l=>new Option(l.city+' · '+l.name,l.name)));
  cityTourButton.textContent='Fly over mapped buildings';landmarkTourButton.textContent='Fly to real landmark';
 }
 regionSelect.blur();
};
function launchMappedFlyover(lat,lon,code){
 regionSelect.value='0';activeMap=0;refreshAirports();
 const x=(lon+5)*111320*Math.cos(57.75*Math.PI/180),z=(lat-57.75)*111200;
 const field=realFields.find(f=>f.code===code);
 airport.value=field.name;homeX=field.x;homeZ=field.z;homeY=field.elevation;reset();
 Object.assign(plane,{x,z,y:terrainHeight(x,z,0)+260,air:true,speed:Math.max(spec.stall*1.7,100),heading:.55,
  throttle:.62,power:.62,vs:0,pitch:.025,bank:0,flap:0,flapTarget:0,gear:0,gearTarget:0});
 cockpit=false;passenger=false;centreOrbit();updateViewButtons();hideSetup();
}
function launchEnglandFlyover(name){
 const place=englandCities.find(c=>c.name===name)||englandLandmarks.find(l=>l.name===name);if(!place)return;
 regionSelect.value='4';activeMap=4;refreshAirports();
 const nearest=englandFields.reduce((best,f)=>Math.hypot(f.x-place.x,f.z-place.z)<Math.hypot(best.x-place.x,best.z-place.z)?f:best,englandFields[0]);
 airport.value=nearest.name;homeX=nearest.x;homeZ=nearest.z;homeY=nearest.elevation;reset();
 Object.assign(plane,{x:place.x,z:place.z-620,y:terrainHeight(place.x,place.z,4)+330,air:true,
  speed:Math.max(spec.stall*1.8,115),heading:.05,throttle:.65,power:.65,
  vs:0,pitch:.015,bank:0,flap:0,flapTarget:0,gear:0,gearTarget:0});
 cockpit=false;passenger=false;centreOrbit();orbit.yaw=-.12;orbit.elev=.42;updateViewButtons();hideSetup();
}
cityTourButton.onclick=()=>{if(activeMap===4){launchEnglandFlyover(cityTourSelect.value);return}const [lat,lon]=cityTourStops[cityTourSelect.value],code={Wick:'EGPC',Inverness:'EGPE',Glasgow:'EGPF'}[cityTourSelect.value];launchMappedFlyover(lat,lon,code)};
landmarkTourButton.onclick=()=>{if(activeMap===4){launchEnglandFlyover(landmarkSelect.value);return}const landmark=realCityLandmarks.find(l=>l.name===landmarkSelect.value);if(!landmark)return;
 launchMappedFlyover(landmark.lat,landmark.lon,landmark.airportCode);
 if(landmark.name==='Caledonian Stadium'){
  // Approach the pitch from the southwest, with a downwards-looking chase
  // camera: spawning directly above the centre hides it below the plane.
  const d=700;plane.x-=Math.sin(plane.heading)*d;plane.z-=Math.cos(plane.heading)*d;
  plane.y=Math.max(terrainHeight(plane.x,plane.z,0)+160,180);
  camHeading=plane.heading;orbit.yaw=0;orbit.elev=.54;orbit.dist=spec.camera*1.8;
 }
};
townTourButton.onclick=()=>{const town=scottishRouteTowns.find(t=>t.name===townSelect.value);if(town)launchMappedFlyover(town.lat,town.lon,town.airportCode)};
// Inverness Airport is about 12 km northeast of the town. Put a direct
// city-centre jump in the persistent toolbar so the mapped town is discoverable.
const invernessJump=document.getElementById('invernessJump');
invernessJump.onclick=()=>launchMappedFlyover(...cityTourStops.Inverness,'EGPE');
const islands=[];
for(let r=0;r<maps.length;r++)for(let i=0;i<islandCentresKm[r].length;i++){
 const [x,z]=islandCentresKm[r][i],[rx,rz]=r===0?[highlandChunkX/2000,highlandChunkZ/2000]:r===3?[usaTileWidth/2000,usaTileWidth/2000]:r===4?[englandTileWidth/2000,englandTileWidth/2000]:islandRadiiKm[i],m=maps[r];
 islands.push({x:m.x+x*1000,z:m.z+z*1000,rx:rx*1000,rz:rz*1000,region:r,index:i,real:r===0,seed:2.83*i+1.31*r,fields:fields.filter(f=>f.region===r&&f.cluster===i),land:[],far:[],decor:[],grid:new Map()});
}
const regionalIslands=maps.map((_,r)=>islands.filter(i=>i.region===r));
const regionalFields=maps.map((_,r)=>fields.filter(f=>f.region===r));
