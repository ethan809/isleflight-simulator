  s([[x,1.41,-n],[x,1.41,n],[side*(half-.49),1.74,n],[side*(half-.49),1.74,-n]],'#d4ccbf');box(side*(half-.40),1.48,0,.60,.23,n*2,ivory);box(side*(half-.65),1.347,0,.12,.026,n*2,['#fff2ce','#f5dec0','#f5dfbb','#fff0d3']);
