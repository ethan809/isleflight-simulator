   // wordmark forward onto the nose section instead of wrapping the wing.
   if(title)artistSkinDecal(surface,side,title,L*(key==='E190'?.4:.32),L*(key==='E190'?.2:.055),nameTop,nameBottom);
   if(mark)artistSkinDecal(surface,side,mark,-L*.255,-L*.45,H*2.55,H*.96,true);
   // Small aft registrations complete the airline paint scheme without
   // sticking out of the fuselage when the pilot rotates the camera.
