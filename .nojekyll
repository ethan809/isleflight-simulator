// Localized mesh compression is permanent for the flight. It changes the real
// imported GLB triangles; the aircraft is never replaced with a box or an
// explosion sprite. Keep six independent crush zones for asymmetrical impacts.
function compressAirframe(p,zone,amount,note){
 if(!p.crush)p.crush={nose:0,belly:0,wingL:0,wingR:0,tail:0,engine:0};
 const before=p.crush[zone]||0,after=clamp(before+Math.max(0,amount)*(1-before*.24),0,1);
 if(after>before+.001){p.crush[zone]=after;p.crushRevision=(p.crushRevision||0)+1}
