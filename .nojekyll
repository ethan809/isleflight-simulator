 const transformNormal=(p,m)=>{const v=[m[0]*p[0]+m[4]*p[1]+m[8]*p[2],m[1]*p[0]+m[5]*p[1]+m[9]*p[2],m[2]*p[0]+m[6]*p[1]+m[10]*p[2]];const len=Math.hypot(...v)||1;return v.map(n=>n/len)};
 const triangles=[];let min=[Infinity,Infinity,Infinity],max=[-Infinity,-Infinity,-Infinity];
 function visit(id,parent){
  const node=doc.nodes[id],matrix=multiply(parent,localMatrix(node));
  if(node.mesh!==undefined)for(const primitive of doc.meshes[node.mesh].primitives){
   if(primitive.mode!==undefined&&primitive.mode!==4)continue;
   const vertices=read(primitive.attributes.POSITION),uv=primitive.attributes.TEXCOORD_0===undefined?null:read(primitive.attributes.TEXCOORD_0);
