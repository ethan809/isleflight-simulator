 const centreX=f.x+5200,centreZ=f.z-500,mesh=sceneryGroup(f,centreX,centreZ,11500);
 const height=terrainHeight(centreX,centreZ,3),big=['KJFK','KORD','KATL','KSFO','KLAX'].includes(f.code);
 const street=(x0,z0,x1,z1,w)=>{
  const roadY=(x,z)=>terrainHeight(x,z,3)+.55;
  face([[x0-w,roadY(x0-w,z0),z0],[x0-w,roadY(x0-w,z1),z1],[x1+w,roadY(x1+w,z1),z1],[x1+w,roadY(x1+w,z0),z0]],'#414e53',mesh);
 };
 for(let row=-6;row<=6;row++){
  const x=centreX+row*330;
  street(x,centreZ-2250,x,centreZ+2250,8.5);
 }
 for(let col=-6;col<=6;col++){
  const z=centreZ+col*330;
  const y0=terrainHeight(centreX-2250,z,3)+.58,y1=terrainHeight(centreX+2250,z,3)+.58;
  face([[centreX-2250,y0,z-8],[centreX-2250,y0,z+8],[centreX+2250,y1,z+8],[centreX+2250,y1,z-8]],'#455357',mesh);
 }
 for(let row=-6;row<6;row++)for(let col=-6;col<6;col++){
  if((row+col+23)%11===0)continue;
  const x=centreX+(row+.48)*330,z=centreZ+(col+.48)*330;
  const y=terrainHeight(x,z,3),dist=Math.hypot(row,col),tower=big&&dist<3;
  const floors=tower?9+(row*row+col*col+25)%20:2+(Math.abs(row*9+col*17)%6);
  const h=floors*3.35;
  const w=80+Math.abs(row*19+col*11)%48,d=85+Math.abs(col*13-row*7)%52;
  const colr=tower?'#82959b':(row+col)%3?'#a9b4ae':'#9aab9e';
  prism(mesh,x,y,z,w,h,d,colr,'#cad0c9');
  // Window ribbons break up the plain towers without coplanar z-fighting.
  if(tower)for(let level=1;level<floors;level++){
   const yy=y+level*3.35,shade=level%2?'#344e5e':'#4a6979';
   face([[x-w-.035,yy,z-d+3],[x-w-.035,yy+1.55,z-d+3],[x-w-.035,yy+1.55,z+d-3],[x-w-.035,yy,z+d-3]],shade,mesh);
  }
 }
