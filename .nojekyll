   const f=(front,back,t)=>front.map((v,i)=>mix(v,back[i],t));
   wing([f(a,c,.75).map((v,i)=>i===1?v+.027:v),f(b,d,.79).map((v,i)=>i===1?v+.028:v),d.map((v,i)=>i===1?v+.025:v),c.map((v,i)=>i===1?v+.025:v)],j?'#a4b9c1':'#bacad0');
   wing([a.map((v,i)=>i===1?v+.025:v),b.map((v,i)=>i===1?v+.025:v),f(b,d,.08).map((v,i)=>i===1?v+.03:v),f(a,c,.09).map((v,i)=>i===1?v+.03:v)],'#c5d2d6');
