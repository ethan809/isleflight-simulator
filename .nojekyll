  label('HDG',10,37,'#7da9a0',9);label(heading+' DEG',70,37,'#e6efde',12);
  label('ALT',10,53,'#7da9a0',9);label(Math.round(p.y*3.281)+' FT',70,53,'#e6efde',12);
  label('IAS',10,69,'#7da9a0',9);label(knots(indicatedSpeed(p))+' KT',70,69,'#e6efde',12);
  label('DEST',10,86,'#7da9a0',9);label(dest.name.slice(0,17),44,101,'#c6deb6',10);
  label('DIST '+km.toFixed(1)+' KM',10,116,'#afd5c8',10);
  const strip=(name,value,y,colour)=>{
   label(name,9,y,'#92b0a8',9);ctx.fillStyle='#173431';ctx.fillRect(61,y-9,97,7);
   ctx.fillStyle=colour;ctx.fillRect(61,y-9,97*clamp(value,0,1),7);
  };
  strip('ENGINE',p.engineHP/100,135,p.engineHP<45?'#dc866b':'#7dccaa');
  strip('AIRFRM',p.health/100,151,p.health<45?'#dc866b':'#7dccaa');
  label(p.gear>.95?'GEAR DOWN':p.gear<.05?'GEAR UP':'GEAR MOVING',9,164,p.gear>.95?'#a3e8b4':'#efbf72',8);
  ctx.restore();
 }
