function bentAirframe(p){
 const d=p.crush;if(!d||!Object.values(d).some(v=>v>.001))return model;
 if(bentAirframeCache.base===model&&bentAirframeCache.revision===p.crushRevision)return bentAirframeCache.mesh;
 const L=spec.length,S=spec.span,H=spec.bodyHeight;
 const mesh=model.map(face=>({...face,normals:undefined,points:face.points.map(([ox,oy,oz])=>{
  let x=ox,y=oy,z=oz;
  const front=clamp((oz-L*.14)/(L*.36),0,1),rear=clamp((-oz-L*.20)/(L*.29),0,1);
  const outer=clamp((Math.abs(ox)-S*.16)/(S*.32),0,1),wing=outer*(ox<0?d.wingL:d.wingR);
  const belly=clamp((H*.30-oy)/(H*1.26),0,1)*clamp(1-Math.abs(ox)/(H*2.5),0,1);
  const ripple=Math.sin(oz*1.7+ox*2.2+oy*.9)*Math.cos(oz*.82-ox*1.3);
