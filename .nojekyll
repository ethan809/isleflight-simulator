  g.fillStyle='#111f2b';g.fillRect(x,y,w,h);g.strokeStyle='#526677';g.lineWidth=.8;g.strokeRect(x+.5,y+.5,w-1,h-1);
  g.fillStyle='#d1dddb';g.font='bold 7px monospace';g.textAlign='center';g.fillText(title,x+w/2,y+10);
 };
 const led=(x,y,on)=>{g.fillStyle=on?'#90ffab':'#a98354';g.fillRect(x-1.9,y-2,3.8,2.9)};
 const toggle=(x,y,on)=>{
  g.strokeStyle='#8196a4';g.lineWidth=1;g.beginPath();g.moveTo(x,y+6);g.lineTo(x,y-4);g.stroke();
  g.fillStyle=on?'#d7e1d7':'#83949f';g.fillRect(x-2,y+(on?-4:0),4,4);led(x-5,y-6,on);
 };
 // Panel legends remain legible when the pilot turns to look at the overhead.
 g.fillStyle='#07141e';g.fillRect(-2,-2,174,174);
 const cells=[['ELEC',1],['GEN / BUS',1],['BATTERY',1],['APU',p.power>.2],['FUEL PUMPS',p.throttle>.1],['HYDRAULIC',1],['ANTI ICE',0],['BLEED AIR',1],['PRESSURE',1],['EXT LIGHTS',1],['LAND LIGHTS',p.gear>.6],['SIGNS',1]];
 cells.forEach(([name,on],i)=>{
  const x=3+(i%3)*55.1,y=4+Math.floor(i/3)*39.9;
  panel(x,y,52,37,name);
  for(let n=0;n<3;n++)toggle(x+12+n*14,y+22,Boolean(on)&&n!==1);
  g.fillStyle='#677f8b';g.fillRect(x+7,y+30,38,1);
 });
 g.fillStyle='#1c4350';g.fillRect(3,164,164,4);
 // The centre-pedestal tile has real radio frequency, trim and throttle cues.
 g.translate(180,0);g.fillStyle='#101c27';g.fillRect(-2,-2,174,174);
 panel(3,4,164,40,'RADIO / COMMUNICATIONS');
 g.fillStyle='#0b3138';g.fillRect(9,16,73,23);g.fillRect(88,16,73,23);
 g.fillStyle='#baf7b5';g.font='bold 12px monospace';g.textAlign='center';g.fillText('121.500',45,31);g.fillText('124.850',124,31);
 panel(3,47,76,50,'SPEEDBRAKE');panel(90,47,77,50,'FLAP CONTROL');
 g.strokeStyle='#8c9da5';g.lineWidth=3;g.beginPath();g.moveTo(40,64);g.lineTo(40,88);g.moveTo(127,64);g.lineTo(127,88);g.stroke();
 g.fillStyle='#d8e3e3';g.fillRect(35,82,10,5);g.fillRect(122,86-12*p.flapTarget/2,10,5);
 g.fillStyle='#9ad8b3';g.font='bold 8px monospace';g.fillText('ARM',60,90);g.fillText(flapNames[p.flapTarget],149,90);
 panel(3,100,164,63,'ENGINE THROTTLE QUADRANT');
 for(let n=0;n<2;n++){
  const x=57+n*58;
  g.fillStyle='#263e48';g.fillRect(x-10,115,20,39);
  g.strokeStyle='#8da1a7';g.lineWidth=2;g.beginPath();g.moveTo(x,116);g.lineTo(x,153);g.stroke();
  g.fillStyle='#d2d7d3';g.fillRect(x-8,148-p.throttle*26,16,7);
  g.fillStyle='#82d6a2';g.font='bold 7px monospace';g.fillText('ENG '+(n+1),x,111);
 }
 g.fillStyle='#d4e8da';g.font='bold 7px monospace';g.fillText('TRIM',20,117);g.fillText((p.pitch*20).toFixed(1),20,128);
 g.fillStyle='#6c8c92';g.fillRect(4,166,162,2);
 g.restore();
}
const eye={};function centreEye(){if(passenger){const l=cabinLayout();Object.assign(eye,{x:-l.half+.34,y:.80,z:(l.rows%2===0?.5:0)*l.pitch,yaw:-1.50,pitch:-.08});return}Object.assign(eye,{x:spec.kind==='fighter'?0:-.67,y:spec.kind==='fighter'?1.27:1.36,z:spec.kind==='fighter'?-.09:-.65,yaw:0,pitch:spec.kind==='fighter'?-.12:-.075})}centreEye();cockpitReady=true;
let drag=null,cockpitZoom=1;
canvas.onpointerdown=e=>{drag=[e.clientX,e.clientY];canvas.setPointerCapture(e.pointerId)};
canvas.onpointermove=e=>{if(!drag)return;const dx=e.clientX-drag[0],dy=e.clientY-drag[1];if(driving){driver.cameraYaw+=dx*.007;driver.cameraPitch=clamp(driver.cameraPitch-dy*.005,-1.25,.65)}else if(onFoot){walker.yaw+=dx*.006;walker.pitch=clamp(walker.pitch-dy*.005,-1.22,1.22)}else if(cockpit){eye.yaw+=dx*.0036;eye.pitch=clamp(eye.pitch-dy*.0036,-1.18,1.18)}else{orbit.yaw+=dx*.008;orbit.elev=clamp(orbit.elev+dy*.006,.045,1.38)}drag=[e.clientX,e.clientY]};
canvas.onwheel=e=>{e.preventDefault();if(driving)driver.cameraDistance=clamp(driver.cameraDistance*Math.exp(clamp(e.deltaY,-200,200)*.002),4.3,38);else if(cockpit)cockpitZoom=clamp(cockpitZoom*Math.exp(-clamp(e.deltaY,-200,200)*.0019),.70,1.55);else orbit.dist=clamp(orbit.dist*Math.exp(clamp(e.deltaY,-200,200)*.002),spec.camera*.54,spec.camera*3.2)};
canvas.onlostpointercapture=canvas.onpointercancel=canvas.onpointerup=()=>drag=null;
function moveEye(dt){const forward=+keys.has('i')-keys.has('k'),side=+keys.has('l')-keys.has('j'),sn=Math.sin(eye.yaw),cs=Math.cos(eye.yaw);
 if(passenger){const l=cabinLayout(),bound=l.rows*l.pitch/2-.32;eye.x=clamp(eye.x+dt*1.8*(forward*sn+side*cs),-l.half+.19,l.half-.19);eye.z=clamp(eye.z+dt*1.8*(forward*cs-side*sn),-bound,bound);return}
 // Keep the pilot's head inside the flight deck instead of entering side
 // panels, rear bulkhead and dashboard when using the walk controls.
 const lateral=spec.kind==='fighter'?.26:1.05;eye.x=clamp(eye.x+dt*(forward*sn+side*cs),-lateral,lateral);eye.z=clamp(eye.z+dt*(forward*cs-side*sn),spec.kind==='fighter'?-.44:-.96,spec.kind==='fighter'?.12:.03)}
function moveWalker(dt){
 const forward=Number(keys.has('w')||keys.has('arrowup'))-Number(keys.has('s')||keys.has('arrowdown'))+walker.stickZ;
 const sideways=Number(keys.has('d')||keys.has('arrowright'))-Number(keys.has('a')||keys.has('arrowleft'))+walker.stickX;
 const length=Math.hypot(forward,sideways);if(!length)return;
 const speed=keys.has('shift')?7:3.8,mult=dt*speed/Math.max(1,length),sn=Math.sin(walker.yaw),cs=Math.cos(walker.yaw);
 const x=walker.x+mult*(forward*sn+sideways*cs),z=walker.z+mult*(forward*cs-sideways*sn);
 // Do not walk into water or kilometres away from the parked aircraft.
 if(Math.hypot(x-plane.x,z-plane.z)<240&&landMask(x,z,activeMap)){
  walker.x=x;walker.z=z;
 }
}
function eyeBasis(){let a=Math.cos(eye.yaw),b=Math.sin(eye.yaw),c=Math.cos(eye.pitch),d=Math.sin(eye.pitch);return [[a,0,-b],[-b*d,c,-a*d],[b*c,d,a*c]]}
const cabin=[];
function surface(pts,color,screen=-1,group=cabin){group.push({pts,color,screen})}
