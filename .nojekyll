 for(let i=0;i<20;i++){const a=tau*i/20,b=tau*(i+1)/20,pt=(t,rr)=>[x+rr*Math.cos(t),y+rr*Math.sin(t),z];
  surface([pt(a,r),pt(b,r),pt(b,r*.79),pt(a,r*.79)],i%5===0?'#a4abb0':'#343d43');
