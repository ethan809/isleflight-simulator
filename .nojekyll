function damage(p,part,amount,note){
 if(p.hitGrace>0)return;
 p.hitGrace=1.3;p[part]=clamp(p[part]-amount,0,100);if(part!=='health')p.health=clamp(p.health-amount*.24,0,100);
 if(part==='wingL'||part==='wingR')compressAirframe(p,part,amount/125);
 else if(part==='gearHP')compressAirframe(p,'belly',amount/240);
 else if(part==='engineHP')compressAirframe(p,'engine',amount/145);
 else if(note==='Tail scrape')compressAirframe(p,'tail',amount/95);
 p.damageNote=note;
 if(p.health<=0){p.health=1;p.crashed=true;p.engineHP=Math.min(p.engineHP,18);
  compressAirframe(p,'belly',.5);compressAirframe(p,'nose',.45);p.damageNote='Major structural damage · try to land';}
}
function skid(p,note){p.skid=true;p.damageNote=note;p.air=false;p.vs=0;p.gearTarget=0;const paved=regionalFields[activeMap].find(f=>onPavement(p,f));p.y=paved?paved.elevation:terrainHeight(p.x,p.z,activeMap);p.throttle=0;p.power=0}
function crashImpact(p,note,kind='ground'){
 const downward=Math.max(0,-p.vs),speed=p.speed,side=Math.abs(Math.sin(p.bank));
 const forward=clamp(speed/180,0,1),vertical=clamp(downward/24,0,1);
 const headOn=kind==='building'||kind==='hill';
 const nose=headOn ? .36+.64*forward : .12+.40*forward+(p.pitch<0?.24:0);
 compressAirframe(p,'nose',nose);
 compressAirframe(p,'belly',.21+.65*vertical+(kind==='ground'?.12:0));
 compressAirframe(p,'wingL',.06+.38*vertical+side*(p.bank>0?.36:.09));
 compressAirframe(p,'wingR',.06+.38*vertical+side*(p.bank<0?.36:.09));
 compressAirframe(p,'engine',.12+.40*vertical);
 if(p.pitch>.13)compressAirframe(p,'tail',.24+.35*vertical);
 p.crashed=true;p.health=Math.max(1,p.health-(28+30*forward+33*vertical));
 p.gearHP=Math.max(0,p.gearHP-(35+55*vertical));p.engineHP=Math.max(0,p.engineHP-(20+47*forward));
 p.speed*=kind==='ground'?.53:.34;p.pitch=clamp(p.pitch,-.15,.13);p.bank*=.65;
 p.hitGrace=1.2;p.landing='';p.arrived=false;p.noseLoad=p.wheelLoad=0;
 skid(p,note+' · airframe crumpled');
}
function onPavement(p,f){const x=p.x-f.x,z=p.z-f.z;
