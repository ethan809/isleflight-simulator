/* END OSM BUILDING FOOTPRINTS */
// Actual OSM building footprints, positioned in the real Highlands coordinate
// system. Heights are taken from OSM when provided, otherwise estimated.
// Ear-clipped roofs preserve L-shaped and concave building outlines; a simple
// triangle fan would incorrectly fill the gaps between their real-world wings.
function footprintRoof(mesh,pts,upper,colour){
 const n=pts.length,ids=Array.from({length:n},(_,i)=>i);
 const signed=pts.reduce((a,p,i)=>a+p[0]*pts[(i+1)%n][1]-pts[(i+1)%n][0]*p[1],0);
 const direction=signed<0?-1:1;
 const cross=(a,b,c)=>(pts[b][0]-pts[a][0])*(pts[c][1]-pts[a][1])-(pts[b][1]-pts[a][1])*(pts[c][0]-pts[a][0]);
 const inside=(p,a,b,c)=>direction*cross(a,b,p)>=-.001&&direction*cross(b,c,p)>=-.001&&direction*cross(c,a,p)>=-.001;
 let safety=0;
 while(ids.length>3&&safety++<n*n){
  let clipped=false;
  for(let j=0;j<ids.length;j++){
   const a=ids[(j+ids.length-1)%ids.length],b=ids[j],c=ids[(j+1)%ids.length];
   if(direction*cross(a,b,c)<.05||ids.some(p=>p!==a&&p!==b&&p!==c&&inside(p,a,b,c)))continue;
   face([upper[a],upper[b],upper[c]],colour,mesh);ids.splice(j,1);clipped=true;break;
  }
  if(!clipped)break;
 }
 if(ids.length===3)face(ids.map(i=>upper[i]),colour,mesh);
 else if(ids.length>3)face(ids.map(i=>upper[i]),colour,mesh);
}
const realBuildingGroups=new Map(),realBuildingFarGroups=new Map(),realBuildingObjectGroups=new Map();
let realBuildingCount=0;
for(const raw of [...realBuildingFootprints,...(window.broraBuildingFootprints||[])]){
 const [x,z,h,kind,...offsets]=raw;
 if(offsets.length<6||!landMask(x,z,0))continue;
 // Keep the airport game assets clear; OSM town buildings stay at real positions.
 if(realFields.some(f=>Math.abs(x-f.x)<(f.code==='GB-DOC'?1450:690)&&Math.abs(z-f.z-180)<(f.code==='GB-DOC'?2700:1700)))continue;
 const groupX=Math.floor(x/1700)*1700+850,groupZ=Math.floor(z/1700)*1700+850;
 const key=Math.floor(x/1700)+','+Math.floor(z/1700);
 let mesh=realBuildingGroups.get(key);
 if(!mesh){
  mesh=sceneryGroup({region:0},groupX,groupZ,95000);realBuildingGroups.set(key,mesh);
  // Keep the same footprint, roof and external walls at either detail level.
  // Only glass/window decoration may vanish with distance.
  const group=scenicGroups[0][scenicGroups[0].length-1];
  group.farMesh=[];group.ultraFarMesh=[];group.nearRange=8600;group.farRange=32000;group.extent=1250;
  realBuildingFarGroups.set(key,group.farMesh);realBuildingObjectGroups.set(key,group);
 }
 const pts=[];for(let k=0;k<offsets.length;k+=2)pts.push([x+offsets[k],z+offsets[k+1]]);
 // A roof based only on the centre elevation can disappear inside a hillside.
 // Raise the whole mapped footprint above its highest surveyed ground corner;
 // the masonry still extends down to the terrain at every individual corner.
 const base=Math.max(renderedHighlandGround(x,z),...pts.map(([px,pz])=>renderedHighlandGround(px,pz)))+.38,n=pts.length;
 // Winding tells us which side of each wall faces outside the building.
 // Window planes need a small real-world offset, otherwise the window glass
 // and masonry occupy exactly the same 3D surface and flicker as we fly past.
 const winding=Math.sign(pts.reduce((sum,a,j)=>{const b=pts[(j+1)%n];return sum+a[0]*b[1]-b[0]*a[1]},0))||1;
 const walls=['#b8afa0','#aab3b8','#b0b0a2','#c4b9a4'];
 const roofs=['#715b54','#656c71','#6f777d','#777c72'];
 const variation=((Math.abs(Math.round(x*.3)+Math.round(z*.7))%11)-5)*2;
 const wall=hexRGB([1,3,5].map(j=>parseInt(walls[kind].slice(j,j+2),16)+variation));
 const roof=roofs[kind],upper=pts.map(([a,b])=>[a,base+h,b]),wallStart=mesh.length;
 const farMesh=realBuildingFarGroups.get(key),farStart=farMesh.length;
 // Above flight altitude, a low-density OSM silhouette reveals settlements
 // 40–75 km away without uploading every tiny house at that distance.
 const group=realBuildingObjectGroups.get(key),ultra=group.ultraFarMesh;
 const corridor=z>21000&&z<44000&&x>45000&&x<87000;
 const stride=corridor?3:6,ultraVisible=(Math.abs(Math.round(x*.31)^Math.round(z*.73))%stride===0)||h>=17;
 const ultraStart=ultraVisible?ultra.length:-1;
 for(let k=0;k<n;k++){
  const l=(k+1)%n,a=pts[k],b=pts[l],lowA=[a[0],renderedHighlandGround(a[0],a[1])+.06,a[1]],lowB=[b[0],renderedHighlandGround(b[0],b[1])+.06,b[1]];
  face([lowA,lowB,upper[l],upper[k]],wall,mesh);
  face([lowA,lowB,upper[l],upper[k]],wall,farMesh);
  if(ultraVisible)face([lowA,lowB,upper[l],upper[k]],wall,ultra);
  if(k%2===0&&h>5&&Math.hypot(b[0]-a[0],b[1]-a[1])>11){
   // Window strips are cosmetic; walls use the actual surveyed outline.
   const first=mix(.18,.24,kind/3),last=.75;
   const length=Math.hypot(b[0]-a[0],b[1]-a[1]),outX=(b[1]-a[1])/length*winding*.14,outZ=-(b[0]-a[0])/length*winding*.14;
   const at=(v,t)=>[mix(a[0],b[0],v)+outX,mix(base+.07,base+h,t),mix(a[1],b[1],v)+outZ];
   face([at(.18,first),at(.82,first),at(.82,last),at(.18,last)],'#536b72',mesh);
   mesh[mesh.length-1].material=4;
  }
 }
 // Mark survey-derived facades for masonry, slate and glass shading; their
 // silhouettes remain the original OSM polygons, not invented generic blocks.
 for(let j=wallStart;j<mesh.length;j++)if(!mesh[j].material)mesh[j].material=6;
 const roofStart=mesh.length;
 const concave=pts.some((_,k)=>{
  const a=pts[(k+n-1)%n],b=pts[k],c=pts[(k+1)%n];
  return (b[0]-a[0])*(c[1]-b[1])-(b[1]-a[1])*(c[0]-b[0])<-1;
 })&&pts.some((_,k)=>{
  const a=pts[(k+n-1)%n],b=pts[k],c=pts[(k+1)%n];
  return (b[0]-a[0])*(c[1]-b[1])-(b[1]-a[1])*(c[0]-b[0])>1;
 });
 if(kind===0&&n<=8&&h<13&&!concave){
  const peak=[x,base+h+Math.min(1.9,h*.22),z];
  for(let k=0;k<n;k++)face([upper[k],upper[(k+1)%n],peak],roof,mesh);
 }else footprintRoof(mesh,pts,upper,roof);
 for(let j=roofStart;j<mesh.length;j++)mesh[j].material=7;
 // LOD uses the identical OSM walls and roof; window strips are near-only.
 if(kind===0&&n<=8&&h<13&&!concave){
  const peak=[x,base+h+Math.min(1.9,h*.22),z];
  for(let k=0;k<n;k++){
   face([upper[k],upper[(k+1)%n],peak],roof,farMesh);
   if(ultraVisible)face([upper[k],upper[(k+1)%n],peak],roof,ultra);
  }
 }else{
  footprintRoof(farMesh,pts,upper,roof);
  if(ultraVisible)footprintRoof(ultra,pts,upper,roof);
 }
 for(let j=farStart;j<farMesh.length;j++)farMesh[j].material=j<farStart+n?6:7;
 if(ultraVisible)for(let j=ultraStart;j<ultra.length;j++)ultra[j].material=j<ultraStart+n?6:7;
 registerBuilding(0,group,pts,base,h,wallStart,farStart,ultraStart);
 realBuildingCount++;
}
// Caledonian Stadium was absent from the OSM building extract, leaving the
// empty pitch looking submerged in the terrain. Locate the actual ground at
// its surveyed coordinates, then put the pitch, terraces and stand roofs above
// the highest sampled terrain point. Geometry follows its real stadium layout.
const caledonian=realCityLandmarks.find(l=>l.name==='Caledonian Stadium');
let stadiumSurface=0;
if(caledonian){
 const cx=caledonian.x,cz=caledonian.z,stadium=sceneryGroup({region:0},cx,cz,18000);
 const angle=.12,ca=Math.cos(angle),sa=Math.sin(angle);
 const local=(x,y,z)=>[cx+x*ca-z*sa,y,cz+x*sa+z*ca];
 const poly=(coords,col)=>face(coords.map(p=>local(...p)),col,stadium);
 const slab=(x0,x1,z0,z1,y,col)=>poly([[x0,y,z0],[x0,y,z1],[x1,y,z1],[x1,y,z0]],col);
 const block=(x0,x1,z0,z1,y0,y1,col)=>{
  const a=[x0,y0,z0],b=[x1,y0,z0],c=[x1,y0,z1],d=[x0,y0,z1],
   A=[x0,y1,z0],B=[x1,y1,z0],C=[x1,y1,z1],D=[x0,y1,z1];
  for(const p of [[a,b,B,A],[b,c,C,B],[c,d,D,C],[d,a,A,D],[A,B,C,D]])poly(p,col);
 };
 let high=-Infinity;
 for(let x=-85;x<=85;x+=10)for(let z=-100;z<=100;z+=10){
  const p=local(x,0,z);high=Math.max(high,renderedHighlandGround(p[0],p[2]));
 }
 const base=high+1.8;stadiumSurface=base;
 block(-75,75,-96,96,base-1.1,base,'#696f72');
 for(let x=-55;x<55;x+=7)slab(x,x+7,-83,83,base+.13,(Math.round(x/7)&1)?'#427b46':'#4b854b');
 // Marked football pitch, center circle and goals.
 const line=(x0,x1,z0,z1)=>slab(x0,x1,z0,z1,base+.20,'#f0f4e8');
 line(-35.5,-35,-54,54);line(35,35.5,-54,54);line(-35.5,35.5,-54,-53.5);line(-35.5,35.5,53.5,54);
 line(-35.5,35.5,-.22,.22);
 for(const side of [-1,1]){
  const z=side*54;
  line(-20,20,z-side*16,z-side*15.6);line(-20,-19.6,Math.min(z,z-side*16),Math.max(z,z-side*16));line(19.6,20,Math.min(z,z-side*16),Math.max(z,z-side*16));
  block(-3.9,3.9,z-side*.7,z+side*.7,base+.2,base+.30,'#f4f6ef');
  for(const end of [-3.65,3.65])block(end-.08,end+.08,z-side*.7,z+side*.7,base+.2,base+2.7,'#edf2e8');
 }
 for(let j=0;j<36;j++){const t=j*Math.PI*2/36,u=(j+1)*Math.PI*2/36,r=9.2;
  const a=[Math.cos(t)*r,Math.sin(t)*r],b=[Math.cos(u)*r,Math.sin(u)*r];
