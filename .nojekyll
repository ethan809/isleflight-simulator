function radial(i,x,z){const dx=(x-i.x)/i.rx,dz=(z-i.z)/i.rz;return Math.hypot(dx,dz)/shore(i,Math.atan2(dz,dx))}
// Coarse continental coastline in lon/lat. This is intentionally labelled
// stylised: it is a navigable contiguous region, not a high-res US coast scan.
const usaOutline=[[-124.7,48.5],[-124.1,46.0],[-124.1,42.0],[-123.5,40.6],[-122.4,37.6],[-120.4,34.5],[-117.1,32.5],[-111.0,31.3],[-108.2,31.3],[-106.5,31.8],[-103.0,29.5],[-97.1,25.8],[-96.1,28.1],[-90.3,29.1],[-87.9,30.3],[-85.0,30.3],[-82.2,27.6],[-80.5,25.0],[-80.1,28.5],[-81.0,31.2],[-79.9,33.5],[-76.5,35.2],[-75.4,37.0],[-74.0,40.6],[-72.5,41.4],[-70.1,42.6],[-69.3,44.1],[-67.0,45.4],[-71.9,45.1],[-74.8,45.0],[-79.0,43.2],[-83.2,42.5],[-83.7,45.8],[-88.0,46.2],[-92.5,46.8],[-95.0,49.0],[-111.0,49.0],[-117.0,49.0],[-124.7,48.5]];
function usaLand(x,z){const lon=x/85000-99,lat=z/111200+39;
 if(lon< -126||lon> -66||lat<24||lat>50)return 0;
 // The terminal apron is protected even when a coarse coastline crosses it.
 if(usaFields.some(f=>Math.abs(f.x-x)<3600&&Math.abs(f.z-z)<3900))return 1;
 let inside=false;for(let i=0,j=usaOutline.length-1;i<usaOutline.length;j=i++){
  const a=usaOutline[i],b=usaOutline[j];if((a[1]>lat)!==(b[1]>lat)&&lon<(b[0]-a[0])*(lat-a[1])/(b[1]-a[1])+a[0])inside=!inside;
 }return inside?1:0;
}
function usaHeight(x,z){if(!usaLand(x,z))return 0;
 const lon=x/85000-99,lat=z/111200+39;
 const bell=(v,c,w)=>Math.exp(-Math.pow((v-c)/w,2));
 const ridge=(Math.sin(lon*1.72+lat*.55)*.25+Math.cos(lat*2.2-lon*.56)*.20+.58);
 const rockies=bell(lon,-108,7)*bell(lat,40,11)*ridge*2300;
 const sierra=bell(lon,-119,2.2)*bell(lat,38,7)*ridge*1600;
 const appalachia=bell(lon,-81,3.3)*bell(lat,37,7)*ridge*740;
 const plains=smooth(-120,-98,lon)*280;
 let h=Math.max(.5,16+rockies+sierra+appalachia+plains+38*(Math.sin(x*.00012)*Math.cos(z*.00015)+1));
 for(const f of usaFields){const d=Math.hypot(x-f.x,z-f.z);if(d<14000)h=mix(f.elevation,h,smooth(3500,14000,d))}
 return h;
