 for(let a=-1;a<=1;a++)for(let b=-1;b<=1;b++){
  const cx=x+a*120+b*20,cz=z+b*95-a*23,point=(u,v,off)=>{const X=cx+u+v*.18,Z=cz+v-u*.18;return[X,terrainHeight(X,Z,i.region)+off,Z]};
