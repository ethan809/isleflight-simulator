<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Isleflight · Britain &amp; USA Flight Simulator</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#91cddd;color:white;font:15px system-ui,sans-serif;overflow:hidden}canvas{width:100vw;height:100dvh;display:block}header,footer{position:fixed;left:0;right:0;display:flex;align-items:center;justify-content:space-between;padding:20px 3vw;pointer-events:none}header{top:0;background:linear-gradient(#15354477,transparent)}h1{margin:0;font-size:23px;letter-spacing:-1px}small{display:block;font:10px monospace;letter-spacing:1.5px;margin-top:3px}button{pointer-events:auto;cursor:pointer;background:#183846dc;border:1px solid #a3c2c3;border-radius:6px;color:white;padding:8px 12px}footer{bottom:0;align-items:flex-end;background:linear-gradient(transparent,#122e3dc9);gap:12px}.hud{display:flex;gap:22px}.number{font:600 24px monospace}#cue{position:fixed;top:16%;left:50%;transform:translateX(-50%);background:#153643e8;padding:9px 16px;border-radius:24px;font-weight:600;max-width:94vw;text-align:center}.controls{font:12px monospace;text-align:right}kbd{font-weight:bold;color:#fff3a1}@media(max-width:650px){footer{flex-wrap:wrap}.hud{gap:15px}.controls{width:100%;text-align:left}}
[hidden]{display:none!important}#scene{touch-action:none}#walkHelp{margin-top:4px;color:#ffeaad}select{pointer-events:auto;background:#183846;color:white;border-radius:5px;padding:7px}header>div:last-child{text-align:right}#scene{cursor:grab}#scene:active{cursor:grabbing}header,footer{padding:12px 2vw}button,select{font:600 12px system-ui}button:hover,select:hover{background:#256071}button[aria-pressed=true]{outline:2px solid #7ad9c1}#scope{position:fixed;left:2vw;bottom:86px;width:min(540px,90vw);height:auto;pointer-events:none;border:4px solid #293439;border-radius:6px;box-shadow:0 5px 14px #12272d65}#cue{font-size:13px}@media(max-width:850px){header{align-items:flex-start}header button,header select{padding:5px}#scope{bottom:110px}}header label{font:10px monospace;display:inline-flex;flex-direction:column;align-items:flex-start;vertical-align:middle;gap:2px}header{gap:12px}header>div:last-child{max-width:82vw}header select{max-width:135px}@media(max-width:900px){header button,header select{font-size:10px;padding:4px}}:root{--glass:#112b37ed;--edge:#d7ebe145;--gold:#ffd085;--muted:#c2d3d1}body{font-family:Inter,system-ui,sans-serif;background:#81a5b2;color:#f5f8f1}header{padding:14px 22px;align-items:center;background:linear-gradient(180deg,#102b3799,transparent);z-index:3}header>div:last-child{max-width:none}.brand{display:flex;align-items:center;gap:10px}.brandMark{height:35px;width:35px;border-radius:50%;border:1px solid #c7ddcf9e;display:grid;place-items:center;color:#ffdc96;background:#163340c9}.brandMark span{display:block;transform:rotate(-28deg);font:700 23px system-ui}h1{font:650 23px/1 system-ui;letter-spacing:-1.2px;text-shadow:0 1px 6px #14323a}small{font:600 10px/1.2 ui-monospace,monospace;letter-spacing:1px}.brand small{color:#eef4e5;letter-spacing:.45px;font-size:9px;margin-top:4px}.toptools,.flightbar{display:flex;align-items:center;gap:5px}.toptools button,.flightbar button,.panel button{padding:8px 12px;border-radius:8px;background:var(--glass);border:1px solid var(--edge);color:#f1f7f1}.toptools button:hover,.flightbar button:hover,.panel button:hover,.panel select:hover{background:#315a66}.toptools .key,.flightbar .key{font:600 10px ui-monospace,monospace;color:var(--gold);margin-right:4px}.panel{pointer-events:auto;position:fixed;z-index:6;background:#112a35f7;border:1px solid #8faeaa65;border-radius:13px;box-shadow:0 15px 45px #081b2570;color:#edf3eb}.panelHead{display:flex;align-items:center;justify-content:space-between;gap:12px}.panelHead h2{font:650 18px/1.2 system-ui;letter-spacing:-.5px;margin:0}.panelHead button{padding:4px 11px}.panel small,.panel label{color:var(--muted)}#setupPanel{top:60px;right:20px;width:min(370px,calc(100vw - 24px));padding:17px;max-height:calc(100dvh - 78px);overflow:auto}.setupGrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px 0}.setupGrid label{display:flex;flex-direction:column;gap:4px;font:600 11px system-ui;align-items:stretch}.setupGrid select{max-width:100%;min-width:0;width:100%;background:#203f4b;color:white;border:1px solid #799c9c70;padding:8px;border-radius:6px}.setupActions{display:flex;gap:8px}.panel button.primary{background:#f1cd8e;color:#22363a}.flightbar{position:fixed;bottom:84px;right:20px;z-index:3}.flightbar button{font:600 11px system-ui;padding:6px 9px}#cue{z-index:2;top:69px;font:600 12px/1.3 system-ui;color:#fff7dd;background:#193b49ee;border:1px solid #c4d8cb47;border-radius:7px;padding:6px 12px;margin:0}footer{padding:13px 22px 15px;background:linear-gradient(transparent,#092533db)}.hud{gap:0;align-items:center;background:#0f2935df;border:1px solid var(--edge);border-radius:10px;padding:9px 3px}.hud>div{padding:0 12px;border-right:1px solid #bad2d031}.hud>div:last-child{border:0}.hud small{color:#a8c8c7;font-size:9px;margin:0 0 2px}.number{display:block;min-width:2ch;font:650 21px/1 ui-monospace,monospace;letter-spacing:-.8px;color:#f0f5e8}.controls{font:11px/1.45 system-ui;color:#edf6ec;text-shadow:0 1px 3px #17333a}kbd{font:650 11px ui-monospace,monospace;color:var(--gold)}#walkHelp{color:#ffda95}#scope{bottom:87px}#chartPanel{inset:8% max(4%,calc((100vw - 1080px)/2));display:flex;flex-direction:column;overflow:hidden;padding:16px 18px}#chartCanvas{position:relative;flex:1;min-height:0;display:block;width:100%;height:100%;border:1px solid #47636a;border-radius:7px;cursor:crosshair;margin:10px 0;background:#112b36}.chartline{display:flex;flex-wrap:wrap;justify-content:space-between;gap:5px;font:12px system-ui;color:#c9d9d4}.chartline{align-items:center}.chartline b{color:#ffd695}.chartline button{padding:5px 9px;font-size:11px}.panelHead small{margin-top:3px}button:focus-visible,select:focus-visible{outline:2px solid #ffd58d;outline-offset:2px}
@media(max-width:740px){header{padding:9px 10px}.toptools button{padding:6px 7px;font-size:11px}.brand{gap:6px}.brandMark{display:none}.brand small{max-width:145px;font-size:8px}h1{font-size:20px}#cue{top:55px;max-width:90vw}.hud>div{padding:0 7px}.number{font-size:16px}.hud small{font-size:8px}.controls{font-size:9px}.flightbar{bottom:85px;right:9px;gap:3px}.flightbar button{padding:4px 6px}footer{padding:8px;gap:3px}.hud{padding:6px 2px}#chartPanel{inset:8px;padding:10px}#scope{bottom:106px;width:71vw}#setupPanel{top:48px;right:9px}}@media(max-height:520px){.controls{display:none}.flightbar{bottom:13px}.hud{padding:5px}#cue{top:45px}#chartPanel{inset:5px}#setupPanel{top:45px;max-height:calc(100dvh - 50px)}}
#quickSwapPanel{position:fixed;right:18px;top:68px;z-index:9;width:min(335px,calc(100vw - 24px));padding:16px;background:#112c38f2;border:1px solid #81b8b4;border-radius:12px;box-shadow:0 10px 35px #001d27a6}
#quickSwapPanel h2{font-size:16px;margin:0 0 8px}#quickSwapPanel p{font-size:12px;color:#b8d6d4;line-height:1.5;margin:5px 0 10px}#quickSwapPanel label{font-size:12px;display:block;margin:9px 0}#quickSwapPanel select{width:100%;margin-top:5px;font-size:13px}#quickSwapPanel button{margin-top:8px}
@media(max-width:850px){#quickSwapPanel{top:76px;right:8px}#quickSwapBtn{padding:5px 7px}}
/* Flight actions must clear the three-line help and controller status. */
.flightbar{bottom:122px}
@media(max-width:740px){.flightbar{bottom:142px;right:8px;max-width:calc(100vw - 16px);flex-wrap:wrap;justify-content:flex-end}}
@media(max-height:630px){.flightbar{bottom:101px}.controls{font-size:10px}}
#drivePanel{top:66px;right:20px;width:min(355px,calc(100vw - 20px));padding:17px;max-height:calc(100dvh - 78px);overflow:auto}
#drivePanel p{font-size:12px;line-height:1.5;color:#bddbd9;margin:9px 0}
#drivePanel label{display:flex;flex-direction:column;gap:5px;font:600 12px system-ui;margin:12px 0}
#drivePanel select{width:100%;border:1px solid #83adb66b;background:#244653;padding:10px}
#drivePanel .driveButtons{display:flex;gap:8px;flex-wrap:wrap}
#drivePanel .credit{font-size:10px;color:#9cbdba}
#drivePanel a{color:#b4e7ff}
body.driving .flightbar #flapBtn,body.driving .flightbar #gearBtn,body.driving .flightbar #cabinBtn,body.driving .flightbar #displays{display:none}
body.driving footer .controls{display:none}
body.driving footer #carControlGuide{display:block}
@media(max-width:740px){#drivePanel{right:8px;top:53px}}
</style>
<canvas id="scene" aria-label="3D flight and driving simulator with Scottish Highlands, England and Wales, fictional islands and the continental USA"></canvas><canvas id="interior" hidden aria-hidden="true" style="position:fixed;inset:0;pointer-events:none"></canvas><header><div class="brand"><div class="brandMark" aria-hidden="true"><span>✈</span></div><div><h1>Isleflight</h1><small id="typeBadge">BOEING 737</small></div></div><nav class="toptools" aria-label="Flight and driving tools"><button id="driveBtn" aria-controls="drivePanel" aria-expanded="false">🚗 Drive</button><button id="quickSwapBtn" aria-controls="quickSwapPanel" aria-expanded="false">✈ Change plane</button><button id="invernessJump" title="Fly directly over mapped Inverness city centre">🏙 Inverness city</button><button id="setupButton" aria-controls="setupPanel" aria-expanded="false">Flight setup</button><button id="chartButton" aria-pressed="false"><span class="key">N</span> Chart</button><button id="viewBtn">V · Cockpit</button></nav></header>
<section id="quickSwapPanel" role="dialog" aria-label="Change aircraft and livery during flight" hidden><h2>Change aircraft in flight</h2><p>Your position, altitude, flight progress and damage stay the same.</p><label>Aircraft<select id="quickFleet" aria-label="Change aircraft while flying"></select></label><label>Livery<select id="quickPaint" aria-label="Change livery while flying"></select></label><button id="quickClose">Back to flying</button></section>
<section id="drivePanel" class="panel" role="dialog" aria-label="Drive a real 3D car" hidden><div class="panelHead"><h2>Drive around the world</h2><button id="driveClose" aria-label="Close driving menu">×</button></div><p>Switch from flying to driving on mapped roads. These are actual third-party 3D models, not handmade substitutes.</p><label>Car model<select id="carChoice"><option value="family-sedan">Family Sedan · Navy</option><option value="five-door-hatchback">5-door Hatchback · Red</option><option value="mid-size-suv">Mid-size SUV · Burgundy</option><option value="mid-engine-supercar">Mid-engine Supercar · Orange</option></select></label><label>Drive from<select id="carTown"><option value="near">Nearest road to my aircraft</option><option value="Wick">Wick · Caithness</option><option value="Brora">Brora · Sutherland</option><option value="Golspie">Golspie · Sutherland</option><option value="Dornoch">Dornoch · Sutherland</option><option value="Inverness">Inverness city</option><option value="Glasgow">Glasgow city</option></select></label><div class="driveButtons"><button class="primary" id="driveStart">🚗 Start driving</button><button id="driveReturn" hidden>✈ Back to my plane</button></div><p id="driveLoading" role="status">Loading licensed 3D cars…</p><p class="credit">Models by <a href="https://tevy.dev/models/family-sedan" target="_blank" rel="noopener noreferrer">tevy</a>, released CC0. Car driving uses simplified handling and open map data; not a vehicle physics simulator.</p></section>
<section id="setupPanel" class="panel" hidden aria-label="Flight setup"><div class="panelHead"><h2>Flight setup</h2><button id="setupClose" aria-label="Close flight setup">×</button></div><div class="setupGrid" id="setupGrid"><label>Aircraft<select id="fleet"><optgroup label="Airliners"><option>Boeing 737</option><option>Airbus A320neo</option><option>Airbus A321neo</option><option>Boeing 747-400</option></optgroup><optgroup label="Turboprops"><option>ATR 72-600</option></optgroup><optgroup label="Fighter jets"><option>F-16 Fighting Falcon</option><option>F/A-18 Hornet</option></optgroup></select></label><label>Livery<select id="paint"><option>Isleflight</option><option>easyJet</option><option>British Airways</option><option>Lufthansa</option></select></label><label>Destination<select aria-label="Destination and practice airport" id="airport"><option>SABLE</option><option selected>TERN</option><option>KELP</option><option>REEF</option><option>SKERRY</option><option>LOMOND</option><option>HAVEN</option></select></label><label>Practice exercise<select id="exercise" aria-label="Practice exercise"><option value="landing">Landing</option><option value="stall">Stall recovery</option><option value="cruise">Airborne cruise</option><option value="traffic">Traffic encounter</option></select></label><label>Wind<select id="weather"><option value="0">Calm</option><option value="1">Sea breeze</option><option value="2">Gusty crosswind</option></select></label><label>Light<select id="daylight"><option value="day">Clear daylight</option><option value="gold">Golden hour</option></select></label></div><div class="setupActions"><button class="primary" id="approach">Start practice</button><button id="restart">Restart on runway</button></div></section>
<div class="flightbar" aria-label="Aircraft controls"><button id="rateBtn" title="T changes simulation speed">T · 1×</button><button id="cabinBtn">H · Cabin</button><button id="displays" aria-pressed="false">M · Instruments</button><button id="flapBtn">F · Flaps</button><button id="gearBtn">G · Gear down</button><button id="exitBtn" title="Exit the stopped aircraft, or board it again">E · Exit</button></div>
<section id="chartPanel" class="panel" hidden aria-label="Flight chart"><div class="panelHead"><div><h2>Flight chart</h2><small id="chartRegion"></small></div><button id="chartClose" aria-label="Close flight chart">Close</button></div><canvas id="chartCanvas" aria-label="Flight chart. Select an airport to set the destination, or use Flight setup."></canvas><div class="chartline"><span>Choose a runway to set your destination</span><b id="chartDest"></b><button id="chartDepart">Start on this runway</button></div></section><canvas id="scope" width="540" height="180" hidden aria-label="Enlarged flight instruments"></canvas><div id="cue"></div><footer><div class="hud"><div id="condition" hidden><small>AIRFRAME</small><b class="number" id="integrity"></b></div><div><small>GS · KT</small><b class="number" id="gsVal"></b></div><div><small>THRUST</small><b class="number" id="thrust"></b></div><div><small>IAS · KT</small><b class="number" id="spd"></b></div><div><small>ALTITUDE · FT</small><b class="number" id="alt"></b></div><div><small>HEADING</small><b class="number" id="hdg"></b></div></div><div class="controls"><kbd>W/S</kbd> Throttle · <kbd>↓/↑</kbd> Nose up/down<br><kbd>A/D</kbd> Bank / steer · <kbd>Z/X</kbd> Rudder · <kbd>Space</kbd> Wheel brakes<span id="rollHelp" hidden> · <kbd>Q/E</kbd> Roll</span><br>Drag to orbit / look · Scroll to zoom · C to centre<div id="walkHelp" hidden>Drag to look · I/J/K/L move · C centre</div></div></footer>
<script src="assets/england-osm.js"></script>
<script src="assets/brora-osm.js"></script>
<script>
'use strict';
const canvas=document.querySelector('canvas'),ctx=canvas.getContext('2d'),keys=new Set(),tau=Math.PI*2;
const clamp=(n,a,b)=>Math.min(b,Math.max(a,n)),mix=(a,b,t)=>a+(b-a)*t;
// Game handling profiles use metres and seconds. The transport profiles share the
// same equations; their power, wing loading and control response differ.
const transport = {
 kind:'transport', engines:2, stall:59, acceleration:4.5, spool:1.9, drag:.032,
 induced:.067, liftSlope:4.8, maxLift:1.45, rollRate:.65, rollLag:.32, pitchRate:.19,
 pitchLag:.22, maxBank:.71, maxPitch:.48, maxSpeed:225, maxLoad:2.6,
 brakes:6.9, span:36, length:35, bodyHeight:2.95, pilotZ:12, gearTrack:3, mainZ:-1.7, noseZ:11,
 camera:56, wheel:.40
};
const displayJet = {
 ...transport,kind:'fighter',engines:1,stall:56,acceleration:9.5,spool:.95,drag:.026,
 induced:.087,liftSlope:4.2,maxLift:1.52,rollRate:2.72,rollLag:.15,pitchRate:.43,
 pitchLag:.14,maxBank:1.25,maxPitch:.96,maxSpeed:325,maxLoad:5.7,brakes:7.7,
 span:10,length:15,bodyHeight:1.72,pilotZ:3.2,gearTrack:1.28,mainZ:-.8,noseZ:3.3,
 camera:23,wheel:.31
};
const profiles={
 'Boeing 737':transport,
 'Airbus A320neo':{...transport,stall:57,acceleration:4.28,rollRate:.71,rollLag:.28,spool:2,drag:.030,pitchRate:.174},
 'Airbus A321neo':{...transport,length:43,stall:62,acceleration:4.12,spool:2.2,rollRate:.57,rollLag:.41,pitchRate:.15,mainZ:-2.2,noseZ:14,camera:66},
 'Boeing 747-400':{...transport,engines:4,stall:71,acceleration:3.72,spool:3.3,rollRate:.40,rollLag:.70,pitchRate:.12,pitchLag:.46,maxBank:.64,drag:.029,induced:.064,brakes:5.4,span:64,length:69,bodyHeight:5.1,pilotZ:23,gearTrack:5.4,mainZ:-4.4,noseZ:21.3,camera:104,wheel:.67},
 'ATR 72-600':{...transport,kind:'prop',stall:44,acceleration:4.05,spool:.73,drag:.043,induced:.071,rollRate:.82,rollLag:.27,pitchRate:.23,maxBank:.75,maxSpeed:151,brakes:6.2,span:27,length:27,bodyHeight:2.22,pilotZ:9.8,gearTrack:2.2,mainZ:-1.8,noseZ:8.7,camera:43,wheel:.38},
 'F-16 Fighting Falcon':displayJet,
 'F/A-18 Hornet':{...displayJet,engines:2,stall:54,acceleration:8.6,spool:1.12,rollRate:2.28,rollLag:.18,pitchRate:.40,drag:.029,induced:.078,liftSlope:4.45,maxLift:1.60,maxSpeed:300,span:12.2,length:17.2,bodyHeight:1.96,pilotZ:3.6,gearTrack:1.67,noseZ:4.25,camera:27},
 'Boeing 787-9':{...transport,stall:67,acceleration:3.8,spool:2.7,rollRate:.49,pitchRate:.14,span:60,length:63,bodyHeight:4.8,pilotZ:23,camera:97,gearTrack:4.7,mainZ:-3.5,noseZ:21,maxSpeed:270},
 'Airbus A350-900':{...transport,stall:69,acceleration:3.65,spool:2.8,rollRate:.46,pitchRate:.135,span:65,length:67,bodyHeight:4.9,pilotZ:24,camera:105,gearTrack:5.1,mainZ:-3.8,noseZ:23,maxSpeed:270},
 'Airbus A380-800':{...transport,engines:4,stall:76,acceleration:3.42,spool:3.4,rollRate:.37,rollLag:.8,pitchRate:.11,span:79.8,length:72.7,bodyHeight:6.15,pilotZ:23,camera:121,gearTrack:6.5,mainZ:-4.6,noseZ:25,maxSpeed:260,brakes:5.1},
 'Embraer E190':{...transport,stall:49,acceleration:4.7,spool:1.5,rollRate:.85,pitchRate:.23,span:28,length:36,bodyHeight:2.5,pilotZ:12,camera:49,gearTrack:2.5},
 'Airbus A220-300':{...transport,stall:52,acceleration:4.55,spool:1.7,rollRate:.75,pitchRate:.205,span:35,length:39,bodyHeight:2.8,pilotZ:13,camera:56},
 'Concorde':{...transport,engines:4,stall:76,acceleration:7.2,spool:1.8,drag:.021,induced:.058,liftSlope:4.3,maxLift:1.38,rollRate:.46,rollLag:.39,pitchRate:.17,pitchLag:.27,maxBank:.78,maxPitch:.42,maxSpeed:590,maxLoad:2.8,brakes:7.6,span:25.6,length:61.66,bodyHeight:3.1,pilotZ:24.5,gearTrack:3.65,mainZ:-7.5,noseZ:21,camera:91,wheel:.54},
 'Dash 8 Q400':{...transport,kind:'prop',stall:48,acceleration:4.25,spool:.7,rollRate:.77,span:28,length:33,bodyHeight:2.5,pilotZ:11.5,camera:51,maxSpeed:184}
};
const airlineChoices=fleet.querySelector('optgroup[label="Airliners"]');
for(const name of ['Boeing 787-9','Airbus A350-900','Airbus A380-800','Embraer E190','Airbus A220-300','Concorde'])airlineChoices.append(new Option(name));
fleet.querySelector('optgroup[label="Turboprops"]').append(new Option('Dash 8 Q400'));
for(const [value,label] of [['3','Rain showers'],['4','Heavy storm'],['5','Highland snow']])weather.append(new Option(label,value));
daylight.append(new Option('Night flying','night'));
let spec=profiles[fleet.value]||transport;
const flapNames=['UP','TAKEOFF','LAND'];
const knots=v=>Math.round(v*1.94384);
const densityAt=height=>Math.max(.45,Math.exp(-Math.max(0,height)/9500));
function referenceSpeed(setting){
 return spec.stall*Math.sqrt(spec.maxLift/(spec.maxLift+.36*setting));
}
function rotateSpeed(){return referenceSpeed(plane.flap)*1.19}
function landingSpeed(){return referenceSpeed(1)*1.34}
function cycleFlaps(){if(!plane.stop&&!plane.skid)plane.flapTarget=(plane.flapTarget+1)%3}
function wrapAngle(angle){return Math.atan2(Math.sin(angle),Math.cos(angle))}
function thrustAt(speed,density){
 const lapse=spec.kind==='prop'?1/(1+Math.pow(speed/66,1.7)):1-.28*clamp(speed/spec.maxSpeed,0,1);
 return spec.acceleration*lapse*Math.pow(density,.66);
}
function aero(p,density){
 const gamma=Math.asin(clamp(p.vs/Math.max(1,p.speed),-.94,.94));
 const alpha=clamp(p.pitch-gamma,-1.35,1.35);
 const clZero=.30+.37*p.flap,clMax=spec.maxLift+.36*p.flap;
 const stallAngle=(clMax-clZero)/spec.liftSlope;
 const liftLimit=clamp((Math.abs(alpha)-stallAngle)/.24,0,1);
 const wingFactor=.76+.24*(p.wingL+p.wingR)/200;
 const pressureRatio=density*(p.speed/spec.stall)**2/spec.maxLift;
 const cl=clamp(clZero+spec.liftSlope*alpha,-1.05,clMax)*(1-.78*liftLimit*liftLimit);
 const liftG=cl*pressureRatio*wingFactor;
 const groundEffect=clamp(1-Math.max(0,p.y-(p.terrain||0))/(spec.span*.32),0,1)**2;
 const cd=spec.drag+.021*p.gear+.043*p.flap**2+.32*liftLimit*liftLimit+spec.induced*cl*cl*(1-.35*groundEffect);
 return {gamma,alpha,stallAngle,liftLimit,liftG,drag:9.81*pressureRatio*cd};
}

let cockpit=false,passenger=false,onFoot=false,driving=false,carInside=false,simRate=1,encounterAnchor=null,trafficSample=-1;
const driver={x:0,y:0,z:0,heading:0,speed:0,steering:0,accel:0,brake:0,handbrake:false,stick:0,trigger:0,reverse:0,model:'family-sedan',cameraYaw:0,cameraPitch:-.14,cameraDistance:10,damage:0};
let carControlGuide=null;
const walker={x:0,z:0,yaw:0,pitch:0,stickX:0,stickZ:0};
const exitBtn=document.getElementById('exitBtn');
function changeRate(){simRate=simRate===1?2:simRate===2?4:1;rateBtn.textContent='T · '+simRate+'×'}rateBtn.onclick=changeRate;

const orbit={};function centreOrbit(){Object.assign(orbit,{yaw:-.38,elev:.235,dist:spec.camera*1.14})}
let homeX=0,homeZ=0,homeY=0;
let plane,camHeading,camPitch,last=0;
let trafficTime=0, traffic=[], advisory="";
const destroyedBuildings=[];
function reset(){encounterAnchor=null;trafficSample=-1;trafficTime=0;traffic=[];advisory="";centreOrbit();plane={x:homeX,z:homeZ-780,y:homeY,speed:0,heading:0,bank:0,pitch:0,pitchRate:0,rollRate:0,loadFactor:1,flap:.5,flapTarget:1,propPhase:0,air:false,stalled:false,stallMargin:1,throttle:0,power:0,vs:0,landing:'',health:100,gearHP:100,wingL:100,wingR:100,engineHP:100,hitGrace:0,damageNote:"",skid:false,ditching:false,crashed:false,crush:{nose:0,belly:0,wingL:0,wingR:0,tail:0,engine:0},crushRevision:0,sinkTime:0,wheelLoad:0,noseLoad:0,grip:1,windX:0,windZ:0,groundSpeed:0,groundVX:0,groundVZ:0,rudder:0,arrived:false,impact:0,gear:1,gearTarget:1,stop:''};camHeading=0;camPitch=-.14;keys.clear()}
const resetFlight=reset;
let cockpitReady=false;
reset=function(){driving=false;carInside=false;document.body.classList.remove('driving');onFoot=false;exitBtn.textContent='E · Exit';resetFlight();if(destroyedBuildings.length)repairBuildings();if(cockpitReady)centreEye();if(typeof updateViewButtons==='function')updateViewButtons()};
reset();restart.onclick=()=>{const field=destination();homeX=field.x;homeZ=field.z;homeY=field.elevation;reset();hideSetup()};
restart.textContent='Start at selected airport';
function toggleView(){if(driving){carInside=!carInside;driver.cameraYaw=0;driver.cameraPitch=-.09;updateViewButtons();return}if(onFoot)return;if(passenger){passenger=false;cockpit=true;centreEye()}else cockpit=!cockpit;updateViewButtons()}
function exitPosition(){const side=spec.span*.76+6,fore=spec.length*.08;return{x:plane.x+Math.cos(plane.heading)*side+Math.sin(plane.heading)*fore,z:plane.z-Math.sin(plane.heading)*side+Math.cos(plane.heading)*fore,yaw:plane.heading+Math.atan2(-side,-fore)}}
function distanceToBoard(){const pos=exitPosition();return Math.hypot(walker.x-pos.x,walker.z-pos.z)}
function toggleFoot(){
 if(driving){if(Math.abs(driver.speed)>1.4){cue.hidden=false;cue.textContent='Stop the car before getting out';return}driving=false;onFoot=true;cockpit=false;passenger=false;walker.x=driver.x+Math.cos(driver.heading)*2.6;walker.z=driver.z-Math.sin(driver.heading)*2.6;walker.yaw=driver.heading;walker.pitch=0;driver.speed=0;keys.clear();exitBtn.textContent='E · Board car';updateViewButtons();return}
 if(onFoot&&Math.hypot(walker.x-driver.x,walker.z-driver.z)<5.6&&driver.y){driving=true;onFoot=false;driver.speed=0;keys.clear();exitBtn.textContent='E · Exit car';updateViewButtons();return}
 if(onFoot){if(distanceToBoard()>14){
  cue.hidden=false;cue.textContent='Walk closer to the aircraft to board';return;
 }onFoot=false;exitBtn.textContent='E · Exit';centreOrbit();updateViewButtons();keys.clear();return}
 if(plane.air||plane.speed>2.4||plane.ditching){cue.hidden=false;cue.textContent='Stop the plane on the ground before exiting';return}
 plane.throttle=plane.power=plane.speed=plane.groundSpeed=0;
 // Start beyond the wingtip, with an unobstructed view of the entire plane.
 const exit=exitPosition();walker.x=exit.x;walker.z=exit.z;
 walker.yaw=wrapAngle(exit.yaw);walker.pitch=.03;
 walker.stickX=walker.stickZ=0;onFoot=true;cockpit=false;passenger=false;
 exitBtn.textContent='E · Board';keys.clear();updateViewButtons();
}
exitBtn.onclick=toggleFoot;
function toggleGear(){if(plane.air&&!plane.stop&&!plane.wheelLoad&&!plane.noseLoad)plane.gearTarget=1-plane.gearTarget}
for(const [name,value] of [['Free flight from runway','free'],['Crosswind landing','crosswind'],['Engine failure','emergency'],['Highland city sightseeing','sightseeing'],['Impact test · crumple the plane','impacttest']])exercise.append(new Option(name,value));
approach.onclick=()=>{
 if(exercise.value==='free'){const field=destination();homeX=field.x;homeZ=field.z;homeY=field.elevation}
 reset();hideSetup();
 if(exercise.value==='free')return;
 if(exercise.value==='sightseeing'&&activeMap===0){launchMappedFlyover(...cityTourStops.Inverness,'EGPE');return}
 if(exercise.value==='crosswind')weather.value='2';
 const field=destination(),v=landingSpeed(),path=-.052;
 const trimmedPitch=(speed,gamma,flap,density=1)=>gamma+(spec.maxLift*Math.cos(gamma)*(spec.stall/speed)**2/density-.30-.37*flap)/spec.liftSlope;
 Object.assign(plane,{air:true,grip:0,x:field.x,z:field.z-2000,y:field.elevation+108,speed:v,vs:v*Math.sin(path),pitch:trimmedPitch(v,path,1,densityAt(field.elevation+108)),flap:1,flapTarget:2});
 if(exercise.value==='stall')Object.assign(plane,{z:field.z-3200,y:field.elevation+860,speed:spec.stall*.96,vs:-5,pitch:.23,stalled:true,gear:0,gearTarget:0,flap:0,flapTarget:0});
 if(exercise.value==='emergency')Object.assign(plane,{z:field.z-3800,y:field.elevation+680,speed:spec.stall*1.55,vs:-1.4,pitch:.02,gear:0,gearTarget:0,flap:0,flapTarget:0,engineHP:12,damageNote:'Engine power loss · plan a glide'});
 if(exercise.value==='impacttest')Object.assign(plane,{x:field.x+7,z:field.z-210,y:field.elevation+43,speed:Math.max(78,spec.stall*1.55),vs:-24,pitch:-.12,bank:.12,gear:0,gearTarget:0,flap:0,flapTarget:0,damageNote:'Impact test · watch the nose and wings crumple'});
 if(exercise.value==='cruise'){const dest=destination(),start=regionalFields[activeMap][0],cruise=Math.min(spec.maxSpeed*.70,spec.stall*2.4),x=start.x-2600,z=start.z-5100,h=1600;Object.assign(plane,{x,z,y:h,heading:Math.atan2(dest.x-x,dest.z-z),pitch:trimmedPitch(cruise,0,0,densityAt(h)),speed:cruise,vs:0,gear:0,gearTarget:0,flap:0,flapTarget:0});camHeading=plane.heading}
 if(exercise.value==='traffic'){
  const cruise=Math.max(90,spec.stall*1.5);
  encounterAnchor={x:field.x,z:field.z-800,y:field.elevation+480,distance:cruise*15};
  Object.assign(plane,{x:encounterAnchor.x,z:encounterAnchor.z,y:encounterAnchor.y,speed:cruise,vs:0,pitch:trimmedPitch(cruise,0,0,densityAt(encounterAnchor.y)),gear:0,gearTarget:0,flap:0,flapTarget:0});
 }
 const density=densityAt(plane.y),initial=aero(plane,density);
 const power=exercise.value==='stall'?.14:clamp((initial.drag+9.81*Math.sin(initial.gamma))/thrustAt(plane.speed,density),.08,.94);
 plane.power=plane.throttle=power;
 if(exercise.value==='emergency')plane.power=plane.throttle=.18;
 if(exercise.value==='impacttest')plane.power=plane.throttle=0;
 updateTraffic(plane,0);
};
flapBtn.onclick=cycleFlaps;
viewBtn.onclick=toggleView;gearBtn.onclick=toggleGear;
function toggleDisplays(){svgScopeVisible=!svgScopeVisible;svgScope.style.display=svgScopeVisible?'block':'none';scope.hidden=true;displays.setAttribute("aria-pressed",String(svgScopeVisible))}displays.onclick=toggleDisplays;
// Browser Gamepad API: standard Xbox / PlayStation controller mapping.
// Keep the keyboard working alongside analog sticks and triggers.
const gamepadFlight={connected:false,roll:0,pitch:0,rudder:0,throttle:0,brake:false,previous:[],index:-1};
const controllerStatus=document.createElement('div');controllerStatus.id='controllerStatus';controllerStatus.setAttribute('role','status');
controllerStatus.style.cssText='margin-top:6px;padding:5px 7px;border-radius:6px;background:#1438448c;color:#b9e8d6;font:11px system-ui;max-width:420px';
controllerStatus.textContent='🎮 Controller: press a button to connect · Xbox / PlayStation supported';
document.querySelector('footer .controls')?.append(controllerStatus);
carControlGuide=document.createElement('div');carControlGuide.hidden=true;carControlGuide.className='controls';carControlGuide.id='carControlGuide';
carControlGuide.innerHTML='<kbd>W / ↑</kbd> Accelerate · <kbd>S / ↓</kbd> Brake/reverse · <kbd>A/D</kbd> Steer<br><kbd>Space</kbd> Handbrake · <kbd>V</kbd> View · <kbd>E</kbd> Exit car · Drag to look · Scroll zoom<br>🎮 Left stick steer · RT accelerate · LT brake · Y camera · X exit';
document.querySelector('footer')?.append(carControlGuide);
function pollController(dt){
 const pads=typeof navigator!=='undefined'&&typeof navigator.getGamepads==='function'?navigator.getGamepads():[];
 const pad=Array.from(pads||[]).find(p=>p&&p.connected!==false&&(p.mapping==='standard'||p.axes?.length>=2));
 if(!pad){
  if(gamepadFlight.connected){controllerStatus.textContent='🎮 Controller disconnected · keyboard still works'}
  driver.stick=driver.trigger=driver.reverse=0;driver.handbrake=false;
  Object.assign(gamepadFlight,{connected:false,roll:0,pitch:0,rudder:0,throttle:0,brake:false,previous:[],index:-1});return;
 }
 const axis=i=>Number(pad.axes?.[i]||0),button=i=>{const b=pad.buttons?.[i];return typeof b==='number'?b:Math.max(Number(b?.value||0),b?.pressed?1:0)},pressed=i=>button(i)>.5;
 const dead=v=>Math.abs(v)<.14?0:Math.sign(v)*(Math.abs(v)-.14)/.86;
 if(!gamepadFlight.connected||gamepadFlight.index!==pad.index){
  controllerStatus.textContent='🎮 Connected · Left stick: steer/fly · RT/LT: accelerate/brake · Y: camera · Right stick: look';
  gamepadFlight.previous=[];
 }
 gamepadFlight.connected=true;gamepadFlight.index=pad.index;
 // Aviation convention: pull the stick back (positive Y) to raise the nose.
 gamepadFlight.roll=dead(axis(0));gamepadFlight.pitch=dead(axis(1));
 gamepadFlight.rudder=Number(pressed(5))-Number(pressed(4));
 gamepadFlight.throttle=button(7)-button(6);gamepadFlight.brake=pressed(1);
 const rising=i=>pressed(i)&&!gamepadFlight.previous[i];
 if(driving){
  driver.stick=dead(axis(0));driver.trigger=button(7);driver.reverse=button(6);driver.handbrake=pressed(1);
  if(rising(3))toggleView();if(rising(2))toggleFoot();if(rising(10)){driver.cameraYaw=0;driver.cameraPitch=-.14}
  driver.cameraYaw+=dead(axis(2))*dt*1.45;driver.cameraPitch=clamp(driver.cameraPitch-dead(axis(3))*dt*.9,-1.1,.6);
  gamepadFlight.previous=Array.from({length:17},(_,i)=>pressed(i));return;
 }
 // Start and Select toggle menus even while a menu pauses the simulation.
 if(rising(9))setupButton.onclick();
 if(rising(8))chartOpen(chartPanel.hidden);
 if(rising(11))quickSwapBtn.onclick();
 const inQuickMenu=!quickSwapPanel.hidden;
 if(inQuickMenu){
  // D-pad left/right chooses a plane; up/down chooses a livery. A or B closes.
  function cycleSelect(select,delta,change){const options=Array.from(select.options).filter(o=>o.value);if(!options.length)return;
   const index=options.findIndex(o=>o.value===select.value),next=(index+delta+options.length)%options.length;
   select.value=options[next].value;change()}
  if(rising(14))cycleSelect(quickFleet,-1,()=>quickFleet.onchange());
  if(rising(15))cycleSelect(quickFleet,1,()=>quickFleet.onchange());
  if(rising(12))cycleSelect(quickPaint,-1,()=>quickPaint.onchange());
  if(rising(13))cycleSelect(quickPaint,1,()=>quickPaint.onchange());
  if(rising(0)||rising(1))quickClose.onclick();
 }
 if(onFoot){
  walker.stickX=dead(axis(0));walker.stickZ=-dead(axis(1));
  walker.yaw+=dead(axis(2))*dt*1.85;
  walker.pitch=clamp(walker.pitch-dead(axis(3))*dt*1.35,-1.22,1.22);
  if(rising(2))toggleFoot();
  gamepadFlight.previous=Array.from({length:17},(_,i)=>pressed(i));return;
 }
 if(setupPanel.hidden&&chartPanel.hidden&&quickSwapPanel.hidden&&!inQuickMenu){
  if(rising(0))cycleFlaps();if(rising(2))toggleGear();if(rising(3))toggleView();
  if(rising(10)){if(cockpit)centreEye();else centreOrbit()}
  const lookX=dead(axis(2)),lookY=dead(axis(3));
  if(cockpit){eye.yaw+=lookX*dt*1.8;eye.pitch=clamp(eye.pitch-lookY*dt*1.35,-1.35,1.35)}
  else{orbit.yaw+=lookX*dt*1.8;orbit.elev=clamp(orbit.elev+lookY*dt*.94,.045,1.38)}
 }
 gamepadFlight.previous=Array.from({length:17},(_,i)=>pressed(i));
}
onkeydown=e=>{const k=e.key.toLowerCase();
 if(k==='escape'){if(!drivePanel.hidden)driveClose.onclick();else if(!quickSwapPanel.hidden)quickClose.onclick();else if(!chartPanel.hidden)chartOpen(false);else hideSetup();return}
 if(e.target&&['SELECT','INPUT','TEXTAREA'].includes(e.target.tagName))return;
 if(driving){if(k==='e'){e.preventDefault();if(!e.repeat)toggleFoot();return}if(k==='v'||k==='c'){e.preventDefault();if(!e.repeat){if(k==='v')toggleView();else{driver.cameraYaw=0;driver.cameraPitch=-.14}}return}if(['w','a','s','d','arrowup','arrowdown','arrowleft','arrowright',' ','shift'].includes(k)){e.preventDefault();keys.add(k)}return}
 if(k==='e'&&(onFoot||!plane.air&&plane.speed<2.4)){e.preventDefault();if(!e.repeat)toggleFoot();return}
 if(onFoot){if(['w','a','s','d','shift','arrowup','arrowdown','arrowleft','arrowright'].includes(k)){e.preventDefault();keys.add(k)}return}
 if(k==='n'){e.preventDefault();if(!e.repeat)chartOpen(chartPanel.hidden);return}
 if(!setupPanel.hidden||!chartPanel.hidden||!quickSwapPanel.hidden)return;
 if(k==='t'||k==='h'){e.preventDefault();if(!e.repeat)(k==='t'?changeRate:switchPassenger)();return}
 if(k==='f'){e.preventDefault();if(!e.repeat)cycleFlaps();return}if(k==='m'){if(!e.repeat)toggleDisplays();return}
 if(cockpit&&'ijkl'.includes(k)&&k.length===1){e.preventDefault();keys.add(k);return}
 if(k==='c'){cockpit?centreEye():centreOrbit();return}
 if(k==='v'||k==='g'){e.preventDefault();if(!e.repeat)(k==='v'?toggleView:toggleGear)();return}
 if(['w','a','s','d','r','arrowup','arrowdown','q','e','z','x',' '].includes(k)){e.preventDefault();if(k==='r')reset();else keys.add(k)}
};onkeyup=e=>keys.delete(e.key.toLowerCase());onblur=()=>keys.clear();
// Positions below are in kilometres. Aircraft, runways and the flight model use metres.
