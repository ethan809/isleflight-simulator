svgScope.style.cssText='position:fixed;left:2vw;bottom:86px;width:min(540px,90vw);height:auto;z-index:5;pointer-events:none;display:none;border:3px solid #243941;border-radius:11px;box-shadow:0 8px 22px #091c29a8;background:#08171f';
