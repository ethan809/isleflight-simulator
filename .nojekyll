const chartPanel=document.getElementById('chartPanel'),chartCanvas=document.getElementById('chartCanvas'),chartButton=document.getElementById('chartButton'),setupPanel=document.getElementById('setupPanel');
// Free-flight route shortcuts: real airport pairs on the surveyed Scotland map.
const routePanel=document.createElement('div');routePanel.style.cssText='padding:13px 2px 3px;border-top:1px solid #416777;margin-top:10px';
const routeHeading=document.createElement('div');routeHeading.textContent='QUICK HIGHLANDS FLIGHTS';routeHeading.style.cssText='font:bold 11px system-ui;letter-spacing:.12em;color:#8be0d1;margin-bottom:8px';routePanel.append(routeHeading);
const routeButtons=document.createElement('div');routeButtons.style.cssText='display:flex;flex-wrap:wrap;gap:7px';
for(const [from,to] of [['Inverness','Wick'],['Wick','Inverness'],['Glasgow','Inverness'],['Inverness','Dornoch']]){
 const button=document.createElement('button');button.textContent=from+' → '+to;button.style.cssText='border:1px solid #467f91;border-radius:7px;padding:8px 10px;background:#163e50;color:#d9f4ee;font:600 12px system-ui';
 button.onclick=()=>{
  regionSelect.value='0';activeMap=0;refreshAirports();const fields=regionalFields[0];
  const match=(f,label)=>f.name.toLowerCase()===label.toLowerCase()||f.name.toLowerCase().startsWith(label.toLowerCase()+' ');
  const start=fields.find(f=>match(f,from)),end=fields.find(f=>match(f,to));
  if(!start||!end)return;
  homeX=start.x;homeZ=start.z;homeY=start.elevation;airport.value=end.name;reset();hideSetup();
 };
 routeButtons.append(button);
}routePanel.append(routeButtons);setupPanel.append(routePanel);
const chartTargets=[];let chartView=null;
let chartCityMode=false;
const chartCitySelect=document.createElement('select');chartCitySelect.id='chartCitySelect';chartCitySelect.setAttribute('aria-label','Detailed real-world city map');
chartCitySelect.replaceChildren(...Object.keys(cityTourStops).map(name=>new Option(name,name)));chartCitySelect.value='Inverness';
const chartCityLabel=document.createElement('label');chartCityLabel.textContent='Real city map ';chartCityLabel.append(chartCitySelect);
const chartDetailButton=document.createElement('button');chartDetailButton.textContent='City detail';chartDetailButton.setAttribute('aria-pressed','false');
chartPanel.querySelector('.chartline').append(chartCityLabel,chartDetailButton);
chartDetailButton.onclick=()=>{if(activeMap!==0)return;chartCityMode=!chartCityMode;chartDetailButton.textContent=chartCityMode?'Scotland overview':'City detail';chartDetailButton.setAttribute('aria-pressed',String(chartCityMode));drawChart()};
chartCitySelect.onchange=()=>{chartCityMode=true;chartDetailButton.textContent='Scotland overview';chartDetailButton.setAttribute('aria-pressed','true');drawChart()};
function hideSetup(){setupPanel.hidden=true;setupButton.setAttribute('aria-expanded','false')}
function chartOpen(open){chartPanel.hidden=!open;chartButton.setAttribute('aria-pressed',String(open));keys.clear();if(open){hideSetup();quickSwapPanel.hidden=true;quickSwapBtn.setAttribute('aria-expanded','false');drawChart();chartClose.focus()}else chartButton.focus()}
chartButton.onclick=()=>chartOpen(chartPanel.hidden);chartClose.onclick=()=>chartOpen(false);
setupButton.onclick=()=>{if(!chartPanel.hidden)chartOpen(false);const opening=setupPanel.hidden;setupPanel.hidden=!opening;setupButton.setAttribute('aria-expanded',String(opening));if(opening){quickSwapPanel.hidden=true;quickSwapBtn.setAttribute('aria-expanded','false')}keys.clear()};
