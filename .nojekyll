 for(let [n,ids] of [[0,[0,1,3,2]],[1,[4,6,7,5]],[2,[0,2,6,4]],[2,[1,5,7,3]],[1,[0,4,5,1]],[3,[2,3,7,6]]])surface(ids.map(i=>corners[i]),col[n],-1,group)
