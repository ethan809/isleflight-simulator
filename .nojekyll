const registrationCache=new Map();
function aircraftRegistration(){
 const name=paint.value;
 if(registrationCache.has(name))return registrationCache.get(name);
 const registrations={Ryanair:'EI-DCL',easyJet:'G-EZTX','British Airways':'G-TTNA',Lufthansa:'D-AIXX',Emirates:'A6-EQH',KLM:'PH-BXA',Qantas:'VH-OQA',Delta:'N821DN',Jet2:'G-JZBA',Loganair:'G-LMTA',TUI:'G-TUMF','Virgin Atlantic':'G-VLUX','Aer Lingus':'EI-DVJ','Air France':'F-HTYA',SWISS:'HB-JBA',SAS:'SE-ROJ'};
 const c=document.createElement('canvas');c.width=384;c.height=96;const g=c.getContext('2d');
 g.font='600 66px Arial, sans-serif';g.textBaseline='middle';g.textAlign='center';g.fillStyle='#253848';g.fillText(registrations[name]||'ISLEFLIGHT',192,48,370);
 registrationCache.set(name,c);return c;
}
const tailMarkCache=new Map();
function artistTailMark(name){
 if(tailMarkCache.has(name))return tailMarkCache.get(name);
 const original=insignia[(airlineCodes[name]||'')+'mark'];
 // For the imported models the fin colour is painted in the mesh. The symbol
 // alone is a transparent image placed on the actual stabiliser triangles.
 const c=document.createElement('canvas');c.width=512;c.height=512;
 const g=c.getContext('2d');g.textAlign='center';g.textBaseline='middle';
 if(name==='British Airways'){
  // The layered red/white speedmarque is readable on the deep-blue BA fin.
  g.lineCap='round';g.lineJoin='round';
  g.strokeStyle='#f6f7f6';g.lineWidth=82;g.beginPath();g.moveTo(89,323);g.quadraticCurveTo(231,126,444,155);g.stroke();
  g.strokeStyle='#db3345';g.lineWidth=39;g.beginPath();g.moveTo(111,331);g.quadraticCurveTo(245,149,446,170);g.stroke();
 }else if(name==='Lufthansa'){
  // Simplified circular crane badge on a navy Lufthansa fin.
  g.strokeStyle='#f8f9ec';g.lineWidth=22;g.beginPath();g.arc(256,256,173,0,tau);g.stroke();
  g.strokeStyle='#f8f9ec';g.lineWidth=23;g.beginPath();g.moveTo(164,293);g.quadraticCurveTo(245,191,358,165);g.moveTo(231,232);g.lineTo(320,327);g.moveTo(281,201);g.lineTo(361,269);g.stroke();
 }else if(name==='easyJet'){
  g.fillStyle='#fff';g.font='bold 106px Arial, sans-serif';g.fillText('easyJet',256,260,452);
 }else if(name==='TUI'){
  g.strokeStyle='#fdfcf7';g.lineWidth=35;g.lineCap='round';g.beginPath();g.arc(172,207,25,0,tau);g.moveTo(325,207);g.arc(350,207,25,0,tau);g.moveTo(134,280);g.quadraticCurveTo(257,395,378,280);g.stroke();
 }else if(name==='Virgin Atlantic'){
  g.fillStyle='#fff';g.font='italic bold 122px Arial, sans-serif';g.fillText('Virgin',256,255,442);
 }else if(name==='Jet2'){
  g.fillStyle='#fff';g.font='bold 154px Arial, sans-serif';g.fillText('Jet2',246,246,420);
  g.font='bold 61px Arial, sans-serif';g.fillText('.com',322,326,190);
 }else if(name==='Loganair'){
  g.fillStyle='#fff';g.font='bold 92px Arial, sans-serif';g.fillText('Loganair',256,258,460);
 }else if(name==='Isleflight'){
  g.fillStyle='#f7c36a';g.font='bold 130px Arial, sans-serif';g.fillText('IF',256,256);
 }else if(original){
  const margin=72,factor=Math.min((512-margin*2)/original.width,(512-margin*2)/original.height),width=original.width*factor,height=original.height*factor;
  // Most logo artwork was extracted with transparent backgrounds already.
  g.drawImage(original,(512-width)/2,(512-height)/2,width,height);
 }else{
  const words=name==='Air France'?'AIR FRANCE':name.toUpperCase();
  g.fillStyle='#fff';g.font='bold 78px Arial, sans-serif';g.fillText(words,256,255,449);
 }
 tailMarkCache.set(name,c);return c;
}
const fuselageTitleCache=new Map();
function artistFuselageTitle(name){
 if(fuselageTitleCache.has(name))return fuselageTitleCache.get(name);
 const c=document.createElement('canvas');c.width=1200;c.height=180;
 const g=c.getContext('2d');g.clearRect(0,0,c.width,c.height);
 const brandColours={'British Airways':'#203d76',Ryanair:'#123b83',easyJet:'#f16a19',Lufthansa:'#132e59',Emirates:'#bc2637',KLM:'#168fc1',Qantas:'#bd263c',Delta:'#152e59',Jet2:'#bd253b',Loganair:'#343558',TUI:'#e42d38','Virgin Atlantic':'#cf1831','Aer Lingus':'#087260','Air France':'#193e81',SWISS:'#d51d31',SAS:'#1e3973'};
 const words={easyJet:'easyJet',Jet2:'Jet2.com',Loganair:'Loganair',KLM:'KLM',TUI:'TUI','Virgin Atlantic':'Virgin Atlantic'};
 const label=words[name]||name.toUpperCase();
 g.fillStyle=brandColours[name]||'#1b5373';g.font=(name==='easyJet'?'bold ':'700 ')+'130px Arial, Helvetica, sans-serif';g.textAlign='center';g.textBaseline='middle';
 g.fillText(label,600,91,1160);
 fuselageTitleCache.set(name,c);return c;
}
function artistFuselageTitleBand(surface){
 // Different real 3D models have different fuselage heights within their
 // bounding boxes (notably the E190 and A220). Place the wordmark by surveying
 // the actual forward side skin, not a fixed fraction of overall aircraft size.
 const H=spec.bodyHeight,L=spec.length,heights=[];
 // A few donor meshes use an atypical height origin. The Embraer fuselage
 // is below y=0, while its nacelles occupy the usual wordmark survey area.
 if(fleet.value==='Embraer E190')return[H*.16,-H*.22];
 for(const t of surface){
  if(t.points.length!==3)continue;
  const p=t.points,centre=p.reduce((a,b)=>[a[0]+b[0]/3,a[1]+b[1]/3,a[2]+b[2]/3],[0,0,0]);
  if(centre[2]<L*.06||centre[2]>L*.32||centre[0]<H*.14||centre[0]>H*1.42||centre[1]<-H*.43||centre[1]>H*1.2)continue;
  const a=p[1].map((n,i)=>n-p[0][i]),b=p[2].map((n,i)=>n-p[0][i]);
  const nx=a[1]*b[2]-a[2]*b[1],ny=a[2]*b[0]-a[0]*b[2];
  if(Math.abs(nx)<Math.abs(ny)*.8)continue;
  heights.push(centre[1]);
 }
 if(heights.length<7)return[H*.7,H*.24];
 heights.sort((a,b)=>a-b);
 const upper=heights[Math.floor((heights.length-1)*.87)];
 return[upper+H*.055,upper-H*.42];
}
function useArtistAirframe(){
 const key=artistSources[fleet.value],source=artistAirframes.get(key);if(!source)return false;
 const [foreAxis,sideAxis,foreSign]=artistFrames[key],size=source.max.map((n,i)=>n-source.min[i]);
 const sideCentre=(source.max[sideAxis]+source.min[sideAxis])/2,frontCentre=(source.max[foreAxis]+source.min[foreAxis])/2;
 const scaleX=spec.span/size[sideAxis],scaleZ=spec.length/size[foreAxis];
 const scaleY=spec.bodyHeight*(spec.engines===4?4:spec.span>50?3.55:4.1)/size[1];
 for(const t of source.triangles){
  const points=t.p.map(v=>[(v[sideAxis]-sideCentre)*scaleX,(v[1]-source.min[1])*scaleY-spec.bodyHeight*.92,(v[foreAxis]-frontCentre)*foreSign*scaleZ]);
  const centre=points.reduce((v,p)=>v.map((n,k)=>n+p[k]/3),[0,0,0]);
  const tail=schemes[paint.value]?.[0]||'#266473';
  const verticalTail=spec.kind!=='fighter'&&centre[2]<-spec.length*.34&&centre[1]>spec.bodyHeight*.69&&Math.abs(centre[0])<spec.bodyHeight*.27;
  const blueBelly=paint.value==='Ryanair'&&centre[1]<-spec.bodyHeight*.53&&Math.abs(centre[0])<spec.bodyHeight*.85;
  const winglet=spec.kind!=='fighter'&&Math.abs(centre[0])>spec.span*.443&&centre[1]>-spec.bodyHeight*.4;
  const engineCowling=spec.kind!=='fighter'&&spec.kind!=='prop'&&Math.abs(centre[0])>spec.bodyHeight*1.30&&Math.abs(centre[0])<spec.span*.29&&centre[1]<-spec.bodyHeight*.46&&centre[2]>-spec.length*.14&&centre[2]<spec.length*.25;
  const original=source.images?.[t.imageIndex];
  const tex=original?(key==='F16'||key==='F18'?artistFighterPaint(original):artistLiveryImage({image:original,kind:key})):null;
  const baseColor=key==='A321'?'#eef2f2':t.colour||'#f4f5f3';
  const accent=schemes[paint.value]?.[0]||'#1b5a6e';
  const normals=t.n?.map(v=>{const u=[v[sideAxis]/scaleX,v[1]/scaleY,v[foreAxis]*foreSign/scaleZ],mag=Math.hypot(...u)||1;return u.map(n=>n/mag)});
  model.push({points,uv:t.uv,normals,color:verticalTail?tail:blueBelly?'#193c79':winglet?accent:engineCowling?accent:baseColor,texture:verticalTail||blueBelly||winglet||engineCowling?null:tex});
 }
 // These are individually surface-conformal markings on the third-party mesh.
 // Never add the old free-floating two-sided billboard quads to artist planes.
 if(spec.kind!=='fighter'){
  let title=artistFuselageTitle(paint.value),mark=artistTailMark(paint.value);
  if(title){const c=document.createElement('canvas');c.width=title.width;c.height=title.height;const g=c.getContext('2d');g.drawImage(title,0,0);
   const dark=artistBodyColours[paint.value]||'#f0f2f1',brightness=(parseInt(dark.slice(1,3),16)*.21+parseInt(dark.slice(3,5),16)*.72+parseInt(dark.slice(5,7),16)*.07);
   if(brightness<145){g.globalCompositeOperation='source-in';g.fillStyle='#f6faf5';g.fillRect(0,0,c.width,c.height);g.globalCompositeOperation='source-over'}title=c}
  const surface=model.slice(),H=spec.bodyHeight,L=spec.length;
  const [nameTop,nameBottom]=artistFuselageTitleBand(surface);
  for(const side of [-1,1]){
