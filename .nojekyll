   const texture=pbr.baseColorTexture===undefined?null:doc.textures?.[pbr.baseColorTexture.index];
   const imageIndex=texture?.source??texture?.extensions?.EXT_texture_webp?.source??-1;
   for(let i=0;i<indices.length;i+=3){const ids=indices.slice(i,i+3);
    triangles.push({p:ids.map(j=>points[j]),uv:uv?ids.map(j=>[uv[j*2],uv[j*2+1]]):null,n:smoothNormals?ids.map(j=>smoothNormals[j]):null,colour:hex,imageIndex})}
