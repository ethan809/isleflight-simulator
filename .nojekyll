const islandRadiiKm=[[34,32],[33,32],[32.5,35],[27,23],[27,24],[23,27],[24,21],[11.5,16.5],[15.5,11],[16,13]];
const airportNames=[
 ['Wick John O Groats','Inverness','Kirkwall','Sumburgh','Stornoway','LOMOND','HAVEN','NORTHSTAR','MARLIN','PINEWOOD','WESTHAVEN','BRIAR','NORTHGATE','GLACIER','FALCON','North Minch','Faroe Sound','Cape Wren','Harris Bay','Foula Reach'],
 ['Madeira','Palma de Mallorca','Nice Cote d Azur','Gibraltar','Tenerife South','COVE','BAYPORT','CEDAR','WESTWIND','CORAL','LAGOON','SUNPORT','MERIDIAN','TIDAL','BREEZE','Port Sirocco','Olive Bay','Mirador','Porto Mar','Cala Verde'],
 ['Dubai International','Hamad International','Abu Dhabi International','Muscat International','Cairo International','SEABIRD','PALM','HIGHLAND','HARBOR','CANYON','MESA','DUSTFALL','COPPER','SIERRA','REDROCK','Jabal Ridge','Al Nahar','Dawn Oasis','Zafir Coast','Copper Strait']
];
// Each entry identifies the host island and the offset of the runway from its centre.
const airportSitesKm=[
 [0,-15.8,-9.5],[1,-15,10],[2,-17.8,-8.2],[3,-17,.2],[4,-15.4,-4.2],
 [0,15.6,-11.9],[5,-4.5,-16.3],[6,-16,-3.1],[1,.8,-18.3],[7,1,-1.7],
 [2,.9,18.9],[8,-1.7,.9],[0,-.75,18.4],[9,1.1,2],[1,16.9,10.8],
 [3,15.8,4.4],[5,4.5,15.2],[4,16.7,3.7],[6,15,4.9],[2,17.4,-10.4]
];
const fictionalFields=maps.flatMap((m,region)=>region===0||region>=3?[]:airportNames[region].map((name,j)=>{
 const [cluster,dx,dz]=airportSitesKm[j],[cx,cz]=islandCentresKm[region][cluster];
 return {name,region,cluster,x:m.x+(cx+dx)*1000,z:m.z+(cz+dz)*1000,elevation:0};
