 try{gl=surface.getContext('webgl2',{alpha:true,antialias:true,premultipliedAlpha:true,preserveDrawingBuffer:true,depth:true})||surface.getContext('webgl',{alpha:true,antialias:true,preserveDrawingBuffer:true,depth:true})}catch(e){}
 if(!gl)return null;
 const vs=`precision highp float;attribute vec3 position,colour,normal;attribute vec2 texcoord;attribute float textured;uniform vec3 eye,right,up,forward;uniform vec2 lens;varying vec3 ink,nrm;varying vec2 uv;varying float hasTexture;
 void main(){vec3 d=position-eye;float depth=dot(d,forward);gl_Position=vec4(dot(d,right)*lens.x,dot(d,up)*lens.y,1.00048*depth-.24006,depth);ink=colour;nrm=normal;uv=texcoord;hasTexture=textured;}`;
 const fs=`precision highp float;varying vec3 ink,nrm;varying vec2 uv;varying float hasTexture;uniform sampler2D screens;uniform float evening;
 void main(){vec3 n=normalize(nrm),sun=normalize(vec3(.30,.85,.43));float lit=.83+.22*abs(dot(n,sun));vec3 col=ink*lit;float grain=fract(sin(dot(gl_FragCoord.xy,vec2(12.9898,78.233)))*43758.5453);col*=.98+.035*grain;if(hasTexture>.5){vec3 panel=texture2D(screens,uv).rgb;col=mix(panel*.96,vec3(.72,.86,.88),.025);}col*=mix(vec3(1.),vec3(1.08,.94,.83),evening);gl_FragColor=vec4(col,1.);}`;
 function compile(type,text){const shader=gl.createShader(type);const source=typeof graphicsShaderSource==='function'?graphicsShaderSource(text,type,!!gl.createVertexArray,gl):text;gl.shaderSource(shader,source);gl.compileShader(shader);if(!gl.getShaderParameter(shader,gl.COMPILE_STATUS))throw Error('Cockpit shader: '+gl.getShaderInfoLog(shader));return shader}
 let program;
 try{program=gl.createProgram();gl.attachShader(program,compile(gl.VERTEX_SHADER,vs));gl.attachShader(program,compile(gl.FRAGMENT_SHADER,fs));gl.linkProgram(program);if(!gl.getProgramParameter(program,gl.LINK_STATUS))throw Error('Cockpit link')}catch(e){console.warn(e.message);return null}
 const loc={},uni={};for(const name of ['position','colour','normal','texcoord','textured'])loc[name]=gl.getAttribLocation(program,name);
 for(const name of ['eye','right','up','forward','lens','evening','screens'])uni[name]=gl.getUniformLocation(program,name);
 const cache=new WeakMap(),dynamicBuffer=gl.createBuffer(),texture=gl.createTexture();gl.bindTexture(gl.TEXTURE_2D,texture);
 for(const property of [gl.TEXTURE_MIN_FILTER,gl.TEXTURE_MAG_FILTER])gl.texParameteri(gl.TEXTURE_2D,property,gl.LINEAR);
 for(const property of [gl.TEXTURE_WRAP_S,gl.TEXTURE_WRAP_T])gl.texParameteri(gl.TEXTURE_2D,property,gl.CLAMP_TO_EDGE);
 gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL,true);
 function dataFor(mesh,atlasWidth,atlasHeight){const data=[];
  for(const obj of mesh){const p=obj.pts;if(p.length<3)continue;
   const paint=/^#[0-9a-f]{6}$/i.test(obj.color)?obj.color:'#354650',rgb=[1,3,5].map(k=>parseInt(paint.slice(k,k+2),16)/255);
   const a=p[1].map((n,k)=>n-p[0][k]),b=p[2].map((n,k)=>n-p[0][k]),normal=[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]],len=Math.hypot(...normal)||1;
   for(let j=1;j<p.length-1;j++)for(const index of [0,j,j+1]){const v=p[index],u=(index===1||index===2)?1:0,w=index>=2?1:0;
    data.push(...v,...rgb,...normal.map(k=>k/len),obj.screen>=0?(15+540*obj.screen+u*510)/atlasWidth:0,obj.screen>=0?(15+w*510)/atlasHeight:0,obj.screen>=0?1:0);
   }
  }
