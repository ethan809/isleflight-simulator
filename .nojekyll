function drawChart(){if(chartPanel.hidden)return;const g=chartCanvas.getContext('2d'),w=chartCanvas.clientWidth,h=chartCanvas.clientHeight;if(!w||!h)return;const ratio=Math.min(window.devicePixelRatio||1,1.6);if(chartCanvas.width!==Math.round(w*ratio)||chartCanvas.height!==Math.round(h*ratio)){chartCanvas.width=Math.round(w*ratio);chartCanvas.height=Math.round(h*ratio)}g.setTransform(ratio,0,0,ratio,0,0);
