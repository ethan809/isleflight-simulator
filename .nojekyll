 const sX=32/span,sZ=34/length,sY=6.8/(source.max[1]-source.min[1]);
 const centreX=(source.min[side]+source.max[side])/2,centreZ=(source.min[fore]+source.max[fore])/2;
 const step=Math.max(1,Math.ceil(source.triangles.length/380)),mesh=[];
 for(let j=0;j<source.triangles.length;j+=step){const tri=source.triangles[j];
  const points=tri.p.map(v=>[(v[side]-centreX)*sX,(v[1]-source.min[1])*sY-2.8,(v[fore]-centreZ)*forward*sZ]);
  const c=points.reduce((a,b)=>a.map((n,k)=>n+b[k]/3),[0,0,0]),tail=c[2]<-11&&c[1]>2.4&&Math.abs(c[0])<2;
  mesh.push({points,color:tail?'#285b89':tri.colour||'#e1e6e5'});
