  if(airline==='DLH')patchSide(side,.14,isProp?-11.40:-25.8,isProp?-12.7:-30.1,isProp?4.5:9.8,isProp?3.24:5.6,insignia.DLHmark);
 }
}
const displayPaint={
 'Silver / orange':['#b7c4ca','#ed6734','#374952'],
 'Navy / gold':['#244b72','#ffc346','#dae6e9'],
 'Red / white':['#b73740','#f7f7ef','#343f50']
};
function buildDisplayJet(hornet){
 const [skin,flash,trim]=displayPaint[paint.value];
 const hull=hornet?
  [[-8.45,.13,.35,.12],[-7.28,1.39,.64,.12],[-4.4,1.54,.71,.08],[.5,1.27,.74,.02],[3.66,.83,.85,.02],[5.5,.74,.59,.01],[7.8,.31,.34,-.09],[8.72,.015,.022,-.13]]:
  [[-7.52,.78,.76,.04],[-5.8,.94,.91,.06],[-2.9,1.16,.98,.03],[.4,1.04,.90,.06],[2.7,.77,.83,.05],[4.9,.69,.58,.015],[6.43,.40,.33,-.06],[7.62,.015,.02,-.11]];
 shell(hull,0,(a,k,z)=>shade(z>(hornet?6.3:5.3)?trim:skin,a),24);
 const canopy=hornet?[[1.3,.10,.12,.68],[2.2,.58,.57,.70],[3.2,.65,.76,.70],[4.26,.57,.67,.65],[5.12,.26,.26,.55],[5.45,.02,.035,.54]]:
 [[.68,.04,.08,.80],[1.36,.53,.52,.78],[2.55,.64,.86,.73],[3.48,.55,.77,.68],[4.24,.40,.44,.64],[4.85,.025,.045,.61]];
 shell(canopy,0,(a,k)=>shade(k===1?'#394452':Math.sin(a)>.80?'#b3d4db':Math.sin(a)>.1?'#527789':'#324759',a),20);
 for(const side of [-1,1]){
  const m=pts=>pts.map(([x,y,z])=>[side*x,y,z]);
  const wing=(pts,c=skin,thick=.09)=>panelWing(m(pts),thick,c,shade(skin,4.6));
  const root=hornet?1.18:.72,tip=hornet?6.03:4.95;
  wing([[root,.03,hornet?1.65:1.15],[tip,.01,-2.44],[tip-.11,.01,-3.61],[root+.10,.02,-4.10]]);
  wing([[tip-1.11,.044,-1.54],[tip,.045,-2.44],[tip-.12,.045,-3.59],[tip-1.22,.043,-3.67]],flash,.025);
  wing([[root+.45,.05,-3.07],[tip-1.23,.04,-3.00],[tip-1.22,.04,-3.62],[root+.43,.05,-4.04]],shade(skin,3.7),.018);
  wing([[.65,.20,hornet?4.31:3.48],[hornet?2.52:1.45,.13,-.64],[1.06,.14,-1.14]],skin,.12);
  wing([[.6,.03,-4.34],[hornet?3.63:3.07,-.19,-6.57],[hornet?3.36:2.94,-.19,hornet?-7.88:-7.15],[.72,.02,-6.70]]);
  const x=hornet?side*.74:0,z=hornet?-7.49:-7.54,r=hornet?.59:.77;
  if(hornet||side===1){
   shell([[z-.1,r*.86,r*.86,0],[z+.30,r,r,0],[z+1.25,r*1.11,r*1.11,.02]],x,(a,k)=>shade(k===1?'#52606b':'#70808a',a),18);
   disk(x,0,z-.12,.84*r,'#1e262d');disk(x,0,z-.14,.53*r,'#353f46');
  }
  if(hornet){
   wing([[.95,.53,-3.85],[1.86,3.17,-6.12],[1.98,3.28,-7.35],[1.11,.55,-6.92]],skin,.07);
   wing([[1.71,2.80,-5.78],[1.86,3.18,-6.12],[1.98,3.28,-7.35],[1.86,2.89,-7.27]],flash,.025);
   wing([[.99,.04,2.14],[1.51,-.09,1.33],[1.38,-.58,1.36],[.93,-.55,2.11]],'#243640',.05);
  }else{
   const fin=(pts,c)=>part(pts.map(([y,z])=>[side*.065,y,z]),c);
   fin([[.54,-1.95],[3.33,-4.99],[3.57,-6.22],[.62,-6.46]],skin);
   fin([[2.86,-4.48],[3.36,-4.99],[3.57,-6.22],[3.08,-6.26]],flash);
   wing([[.6,-.52,-4.17],[.94,-1.18,-5.73],[.86,-.64,-6.02]],trim,.04);
  }
  part(m([[.78,.30,4.18],[.80,.24,3.36],[1.08,.22,-.34],[1.04,.34,-.28]]),flash);
 }
 if(!hornet){
  shell([[-2.4,.56,.32,-.53],[.8,.68,.47,-.65],[2.31,.61,.42,-.64],[2.48,.55,.33,-.65]],0,a=>shade(skin,a),16);
  part(Array.from({length:16},(_,i)=>[.55*Math.cos(tau*i/16),-.65+.33*Math.sin(tau*i/16),2.49]),'#252f38');
 }
}
// Trailing-edge surfaces rotate about their spanwise hinges as the flaps travel.
function flapPanels(p){
 if(p.flap<.01)return [];
 let inner,outer,depth;
 if(spec.kind==='fighter'){
  inner=[1.46,.04,-4.0];outer=[spec.span*.35,.04,-3.66];depth=.30;
 }else if(spec.kind==='prop'){
  inner=[1.52,1.16,-1.71];outer=[8.7,1.28,-1.42];depth=.43;
 }else if(spec.engines===4){
  inner=[3.55,-.53,-5.18];outer=[14.3,.19,-6.4];depth=1.12;
 }else{
  const stretch=fleet.value==='Airbus A321neo'?1.24:fleet.value==='Airbus A320neo'?1.04:1;
  inner=[2.1,-.36,-4.15*stretch];outer=[10,.22,-6.32*stretch];depth=.68;
 }
 const angle=.69*p.flap,extension=depth*(.38+.62*p.flap);
 const dz=-extension*Math.cos(angle),dy=-extension*Math.sin(angle),mesh=[];
 for(let side of [-1,1]){
  const pos=(v,y=0,z=0)=>[side*v[0],v[1]+y,v[2]+z];
  face([pos(inner),pos(outer),pos(outer,dy,dz),pos(inner,dy,dz)],spec.kind==='fighter'?displayPaint[paint.value][0]:'#b4c3c4',mesh);
 }
 return mesh;
}
function propellers(p){
 const parts=[],phase=(p.propPhase||0);
 for(const side of [-1,1]){
  for(let i=0;i<6;i++){
   const a=phase*side+i*tau/6;
   const blade=(r,t)=>[side*4.25+r*Math.sin(a)+t*Math.cos(a),.61+r*Math.cos(a)-t*Math.sin(a),2.90+.03*r];
   face([blade(.25,-.07),blade(1.65,-.24),blade(1.86,-.18),blade(1.78,.05),blade(.60,.14)],'#29363d',parts);
   face([blade(1.62,-.24),blade(1.86,-.18),blade(1.78,.05),blade(1.59,.07)],'#f1d997',parts);
  }
 }
 return parts;
}

function addAircraftDetails(){
 if(spec.kind==='fighter'){
  // Raked radar nose, intake lips and segmented engine exhaust petals.
  for(let s of [-1,1]){
   part([[s*.16,.15,5.9],[s*.38,.08,5.4],[s*.53,-.18,4.45],[s*.2,-.25,4.7]],'#889aa4');
   part([[s*.56,-.55,1.65],[s*1.05,-.50,1.3],[s*1.08,-.79,.35],[s*.59,-.88,.55]],'#273943');
  }
  for(let i=0;i<20;i++){let a=i*tau/20,b=(i+1)*tau/20;
   part([[.60*Math.cos(a),.60*Math.sin(a),-spec.length*.46],[.73*Math.cos(a),.73*Math.sin(a),-spec.length*.46],[.73*Math.cos(b),.73*Math.sin(b),-spec.length*.46],[.60*Math.cos(b),.60*Math.sin(b),-spec.length*.46]],i%2?'#687982':'#435361');
