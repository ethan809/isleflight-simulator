function jetControls(p){
 const movable=[],stickX=spec.engines===1?.52:0;
 solid(stickX+p.rollRate*.024,.53,.39-p.pitchRate*.09,.07,.34,.08,dark,movable,-p.rollRate*.10);
 solid(-.55,.71,.14+p.throttle*.21,.13,.085,.10,metal,movable);
 return movable;
}

function movingParts(p){
 const m=[],airbus=fleet.value.startsWith('Airbus');
 if(airbus)for(const x of [-1.22,1.22]){
  const z=.54-p.pitch*.18;
  solid(x,.35,.54,.32,.18,.32,slate,m);
  solid(x-p.bank*.065,.56,z,.085,.34,.09,dark,m,-p.bank*.45);
  solid(x-p.bank*.065,.78,z-.025,.15,.12,.13,metal,m,-p.bank*.45);
  solid(x-p.bank*.065,.75,z+.051,.065,.058,.04,['#d08f68','#8d593a','#e3ab78','#f3c49b'],m);
 }
 // The Boeing-style steering yokes are modeled as elliptical grip rings with
 // spokes, and they move with roll and pitch instead of sitting motionless.
 for(const x of airbus?[]:[-.68,.68]){
  const angle=-p.bank*1.1,ca=Math.cos(angle),sa=Math.sin(angle),z=.99-p.pitch*.58,cy=.65;
  const point=(dx,dy,depth=0)=>[x+dx*ca-dy*sa,cy+dx*sa+dy*ca,z+depth];
  solid(x,.29,z,.085,.48,.085,dark,m,-angle*.28);
  for(let j=0;j<18;j++){
   const a=tau*j/18,b=tau*(j+1)/18;
   const on=(t,k)=>point(.31*k*Math.cos(t),.18*k*Math.sin(t));
   surface([on(a,1),on(b,1),on(b,.70),on(a,.70)],j%5===0?'#59646a':'#252e33',-1,m);
  }
  surface([point(-.255,-.005),point(.255,-.005),point(.255,.055),point(-.255,.055)],'#303c41',-1,m);
  surface([point(-.065,-.13),point(.065,-.13),point(.065,.12),point(-.065,.12)],'#374249',-1,m);
  solid(x,cy,z+.055,.145,.115,.07,metal,m,-angle*.7);
  for(const side of [-1,1])solid(x+side*.25*ca,cy+side*.25*sa,z+.03,.062,.16,.12,dark,m,-angle);
 }
 for(let n=0;n<spec.engines;n++){
  const x=(n-(spec.engines-1)*.5)*(spec.engines===4?.075:.14),z=.11+p.throttle*.30;
  solid(x,.49,z,.036,.22,.042,metal,m);
  solid(x,.61,z,.138,.09,.10,dark,m);
  solid(x,.665,z,.105,.018,.082,['#b7b8ae','#999a8d','#d2d3c8','#e1dfd1'],m);
 }
 // Flap lever, speed-brake lever and physical gear indicator follow the plane.
 solid(.33,.43,-.38+p.flapTarget*.075,.032,.29,.055,metal,m,-.3);
 solid(.33,.585,-.38+p.flapTarget*.075,.13,.045,.085,dark,m);
 solid(-.36,.43,-.39+p.flapTarget*.03,.031,.29,.052,metal,m,.24);
 solid(-.36,.58,-.39+p.flapTarget*.03,.125,.05,.083,slate,m);
 solid(1.17,.59,1.55,.044,.31,.065,metal,m,p.gear>.6?-.6:.6);
 for(const [j,x] of [-.077,0,.077].entries())solid(1.10+x,.805,1.51,.047,.026,.026,p.gear>.95?['#73c998','#37765a','#9fe1b1','#c0e8c9']:['#b57d4a','#805131','#d5a467','#e3b989'],m);
 return m;
}
// The default airliner flight deck is a separate, sightline-first model.
// Its low glareshield, thin window posts and broad glass displays replace
// the old high block consoles, oversized yokes and bulky overhead obstruction.
const modernCabin=[];
const modernShell=['#263844','#14242f','#314553','#405567'];
const modernPanel=['#142631','#0c1a23','#1d303b','#283c49'];
const modernTrim=['#506677','#344a59','#617786','#83919b'];
const modernMetal=['#89999f','#647985','#acb9b8','#c7ceca'];
const modernSeat=['#374958','#243642','#455b69','#536c7a'];
const mb=(x,y,z,w,h,d,col=modernPanel,rot=0)=>solid(x,y,z,w,h,d,col,modernCabin,rot);
const ms=(v,c,screen=-1)=>surface(v,c,screen,modernCabin);
// Cabin envelope is mostly below eye height. The thin roof and rear bulkhead
// are visible on a look-around without obscuring the forward windscreen.
mb(0,-.17,-.24,3.75,.18,4.6,modernPanel);
mb(0,2.34,-1.65,3.66,.10,1.55,modernShell);
mb(0,1.05,-2.37,3.65,2.42,.10,modernShell);
for(const side of [-1,1]){
 mb(side*1.80,.35,-.04,.13,.94,4.37,modernShell);
 // Open side windows: solid upper walls made looking sideways feel like
 // staring into a grey box, even though the aircraft was outside in daylight.
 mb(side*1.80,2.27,-1.04,.11,.075,2.60,modernTrim);
 for(const z of [-1.85,-.65,.22])mb(side*1.80,1.60,z,.09,1.34,.067,modernShell);
 // A narrow, padded sill follows each side window; the flat old slabs are gone.
 mb(side*1.59,.56,1.06,.31,.10,1.25,modernPanel);
 mb(side*1.68,1.01,1.21,.22,.07,1.83,modernTrim);
 // Front window pillars with a tapered inner edge and slim top cross-member.
 ms([[side*1.67,1.05,2.18],[side*1.73,1.05,2.18],[side*1.73,2.22,2.18],[side*1.63,2.22,2.18]],'#415462');
 mb(side*1.70,2.25,2.04,.17,.09,.25,modernTrim);
 mb(side*1.43,.76,.22,.30,.08,.66,modernPanel);
 for(let row=0;row<2;row++)for(let c=0;c<7;c++){
  const hue=(row*7+c)%6===0?['#b8b26c','#98814b','#e5d29b','#e3d8b7']:modernMetal;
  mb(side*(1.25+c*.062),.809,.07+row*.19,.043,.022,.064,hue);
 }
 // Pilot and first-officer seats sit behind the camera rather than beside the displays.
 mb(side*.69,.33,-1.13,.66,.20,.66,modernSeat);
 mb(side*.69,.73,-1.47,.67,.91,.16,modernSeat);
 mb(side*.69,1.26,-1.49,.34,.22,.17,modernPanel);
}
mb(0,2.23,2.09,3.43,.09,.14,modernShell);
mb(.11,1.68,2.12,.057,1.12,.085,modernTrim);
// The overhead electrical, lights and APU panels are actual geometry above
// the pilots' heads. Looking up reveals tactile switches and guarded toggles.
mb(0,2.07,.35,2.18,.105,1.53,modernShell);
mb(0,1.992,.35,1.97,.022,1.39,modernPanel);
ms([[-.964,1.955,-.322],[.964,1.955,-.322],[.964,1.955,1.022],[-.964,1.955,1.022]],'#0d1b26',4);
for(const x of [-.65,0,.65]){
 for(let k=0;k<5;k++){
  const z=-.16+k*.225;
  mb(x,1.944,z,.29,.028,.066,k===1?['#215448','#1a3b35','#3d7b66','#57a583']:['#182c37','#101f28','#314856','#476171']);
  mb(x+.087,1.913,z,.031,.072,.031,k%3===0?['#caa76e','#805f36','#f2d39a','#f9e3b4']:modernMetal);
 }
}
for(let k=0;k<9;k++)mb(-.84+k*.21,1.939,.92,.069,.040,.045,k%3===0?['#5ba888','#29684e','#89d3a4','#bbe3c2']:modernMetal);
// Panel and moulded lip. The display surfaces are ahead of the black surround
// and cannot disappear into it during normal camera movement.
mb(0,.66,1.48,3.27,1.14,.23,modernPanel);
mb(0,1.185,1.40,3.33,.115,.39,modernShell);
mb(0,1.247,1.37,3.26,.019,.27,modernTrim);
for(const [i,x] of [-.89,0,.89].entries()){
 mb(x,.73,1.334,.820,.783,.037,modernShell);
 mb(x,.735,1.305,.765,.714,.011,modernPanel);
 const l=x-.358,r=x+.358,top=1.075,bottom=.395,z=1.292;
 ms([[l,top,z],[r,top,z],[r,bottom,z],[l,bottom,z]],'#07151c',i);
 // Realistic slim glass-display bezels, with tactile soft keys below.
 for(let k=0;k<5;k++){
  mb(x-.245+k*.122,.347,1.283,.068,.026,.029,k===2?modernTrim:modernMetal);
 }
 for(const s of [-1,1])for(let k=0;k<3;k++)mb(x+s*.389,.51+k*.21,1.280,.027,.047,.027,modernTrim);
}
// A sloped FMC/CDU follows the centre pedestal angle, as in a real flight
// deck. The previous vertical block obscured the throttles when looking down.
mb(0,.085,.135,.80,.08,.92,modernPanel);
ms([[-.376,.468,.505],[.376,.468,.505],[.376,.208,-.231],[-.376,.208,-.231]],'#354754');
ms([[-.288,.491,.461],[.288,.491,.461],[.288,.274,-.184],[-.288,.274,-.184]],'#0a2327',3);
for(const side of [-1,1])for(let k=0;k<5;k++){
 const z=-.134+k*.133,y=.239+k*.047;
 mb(side*.339,y,z,.029,.026,.039,modernMetal);
}
// Auto-flight mode controller above the glass flight displays.
mb(0,1.322,1.47,2.54,.145,.23,modernPanel);
for(let k=0;k<7;k++){
 const x=(k-3)*.35;
 mb(x,1.393,1.359,.21,.073,.025,['#173a42','#214950','#2b5660','#385964']);
 mb(x+.118,1.332,1.322,.078,.080,.054,modernMetal);
 for(let t=0;t<7;t++){
  const a=t*tau/7,b=(t+1)*tau/7;
  ms([[x+.118+.034*Math.cos(a),1.331+.034*Math.sin(a),1.284],[x+.118+.034*Math.cos(b),1.331+.034*Math.sin(b),1.284],[x+.118+.026*Math.cos(b),1.331+.026*Math.sin(b),1.284],[x+.118+.026*Math.cos(a),1.331+.026*Math.sin(a),1.284]],'#a1b0b6');
 }
}
// A few guarded switches and oxygen / landing lights, not a solid ceiling slab.
for(let k=0;k<10;k++)mb(-1.23+k*.275,1.212,1.125,.076,.022,.069,k%4===0?['#cfaa58','#8d6b34','#f4d38b','#f7dd9f']:modernMetal);
for(const side of [-1,1]){
 mb(side*.52,.11,.13,.27,.16,.87,modernPanel);
 for(let k=0;k<4;k++)mb(side*.52,.19,-.19+k*.19,.16,.035,.074,modernMetal);
}
mb(0,-.065,-.50,.73,.16,1.94,modernShell);
ms([[-.358,.025,-.98],[.358,.025,-.98],[.358,.025,-.08],[-.358,.025,-.08]],'#101c27',5);
// Wheel-shaped Boeing yokes and Airbus sidesticks move with pilot inputs.
function modernControls(p){
 const m=[],airbus=fleet.value.startsWith('Airbus');
 for(const x of airbus?[-1.24,1.24]:[-.73,.73]){
  const turn=clamp(-p.bank*.70,-.52,.52),z=.52-p.pitch*.24;
  if(airbus){
   solid(x,.25,.61,.23,.17,.22,modernPanel,m);
   solid(x+turn*.06,.46,z,.075,.38,.08,modernShell,m,turn);
   solid(x+turn*.07,.65,z,.18,.08,.14,modernTrim,m,turn);
  }else{
   const cy=.50,ca=Math.cos(turn),sa=Math.sin(turn);
   const wheel=(dx,dy,depth=0)=>[x+dx*ca-dy*sa,cy+dx*sa+dy*ca,z+depth];
   solid(x,.24,z,.086,.40,.075,modernMetal,m);
   solid(x,.39,z,.16,.13,.13,modernShell,m);
   // Rounded aircraft yoke with leather grips, a lower arch and spokes.
   for(let j=0;j<22;j++){
    let a=tau*j/22,b=tau*(j+1)/22;
    const v=(t,k)=>wheel(.28*k*Math.cos(t),.176*k*Math.sin(t),.015);
    surface([v(a,1),v(b,1),v(b,.79),v(a,.79)],j%5===0?'#617786':'#263846',-1,m);
   }
   surface([wheel(-.26,-.025,.025),wheel(.26,-.025,.025),wheel(.26,.034,.025),wheel(-.26,.034,.025)],'#344753',-1,m);
   surface([wheel(-.06,-.12,.025),wheel(.06,-.12,.025),wheel(.06,.12,.025),wheel(-.06,.12,.025)],'#405461',-1,m);
   solid(x,cy,z+.060,.138,.10,.065,modernTrim,m,turn);
   for(const sign of [-1,1]){
    const grip=wheel(sign*.257,-.018);
    solid(grip[0],grip[1],z+.022,.052,.11,.095,modernShell,m,turn);
   }
  }
 }
 for(let k=0;k<spec.engines;k++){
  const x=(k-(spec.engines-1)/2)*(spec.engines===4?.095:.18),z=-.16+p.throttle*.26;
  solid(x,.22,z,.035,.22,.043,modernMetal,m);
  solid(x,.34,z,.094,.10,.115,modernShell,m);
 }
 solid(.30,.28,-.27+p.flapTarget*.07,.033,.21,.05,modernMetal,m);
 solid(.30,.39,-.27+p.flapTarget*.07,.11,.04,.085,modernShell,m);
 for(let k=0;k<3;k++)solid(1.27+k*.095,.98,1.258,.045,.025,.03,p.gear>.95?['#5bd49e','#34926f','#a3edca','#c7ffe1']:['#dc9f56','#98703c','#f4d2a5','#ffe4b8'],m);
 return m;
}
// Vector airliner avionics are painted at the actual viewport resolution.
// Unlike the small 170px texture atlas used in walk-around mode, these PFD,
// navigation and engine displays remain sharp on Retina / 4K screens.
function drawAvionicsScreen(g,type,x,y,w,h,p){
 const airbus=fleet.value.startsWith('Airbus'),green=airbus?'#51f49c':'#7ef3a8',cyan='#7ce6f2',amber='#ffd18a';
 g.save();g.translate(x,y);g.scale(w/320,h/300);g.beginPath();g.rect(0,0,320,300);g.clip();
 g.fillStyle='#01070c';g.fillRect(0,0,320,300);
 const line=(x1,y1,x2,y2,color='#b5cbd6',thick=1)=>{g.strokeStyle=color;g.lineWidth=thick;g.beginPath();g.moveTo(x1,y1);g.lineTo(x2,y2);g.stroke()};
 const txt=(s,x,y,size=12,color='#dcebf0',align='left',weight=600)=>{g.fillStyle=color;g.font=`${weight} ${size}px ui-monospace,SFMono-Regular,monospace`;g.textAlign=align;g.fillText(String(s),x,y)};
 const box=(x,y,w,h,fill='#091a24',stroke='#314c59')=>{g.fillStyle=fill;g.fillRect(x,y,w,h);g.strokeStyle=stroke;g.lineWidth=1;g.strokeRect(x+.5,y+.5,w-1,h-1)};
 const hdg=((p.heading*180/Math.PI)%360+360)%360,ias=Number(knots(indicatedSpeed(p))),alt=Math.max(0,p.y*3.28084),vs=p.vs*196.85;
 if(type===0){
  // Flight-mode annunciator and master warning strip.
  box(0,0,320,27,'#07131b','#273744');
  txt(p.stalled?'STALL':p.air?(airbus?'SRS':'THR REF'):'TO/GA',7,17,12,p.stalled?'#ff686c':green);
  txt(airbus?'NAV':'HDG SEL',125,17,12,green,'center');
  txt(p.air?'ALT':'TO/GA',250,17,12,green,'center');
  // Moving, banked earth/sky horizon with pitch ladder and roll scale.
  g.save();g.beginPath();g.rect(61,28,198,208);g.clip();
  const sky=g.createLinearGradient(0,28,0,180);sky.addColorStop(0,'#155f9e');sky.addColorStop(1,'#47a4d6');
  const ground=g.createLinearGradient(0,140,0,300);ground.addColorStop(0,'#98724c');ground.addColorStop(1,'#4b3a30');
  g.translate(160,131);g.rotate(-p.bank);g.translate(0,p.pitch*214);
  g.fillStyle=sky;g.fillRect(-380,-400,760,400);g.fillStyle=ground;g.fillRect(-380,0,760,400);
  line(-390,0,390,0,'#fff2d9',2.3);
  for(let a=-30;a<=30;a+=2.5){if(Math.abs(a)<.01)continue;
   const yy=-a*3.68,major=a%10===0,mid=a%5===0,ww=major?46:mid?31:17;
   line(-ww/2,yy,ww/2,yy,'#f4f1e7',major?2:1.2);
   if(major){txt(Math.abs(a),-ww/2-6,yy+4,10,'#fff6ea','right');txt(Math.abs(a),ww/2+6,yy+4,10,'#fff6ea')}
  }
  g.restore();
  for(const a of [-60,-45,-30,-20,-10,0,10,20,30,45,60]){
   const t=a*Math.PI/180,r=94,rr=r-(a%30===0?11:6);
   line(160+rr*Math.sin(t),123-r*Math.cos(t),160+r*Math.sin(t),123-r*Math.cos(t),'#e8f2f2',1.3);
  }
  g.save();g.translate(160,123);g.rotate(-p.bank);g.fillStyle='#ffedf0';g.beginPath();g.moveTo(0,-101);g.lineTo(-6,-90);g.lineTo(6,-90);g.closePath();g.fill();g.restore();
  // Central aircraft symbol and magenta flight director.
  line(104,131,144,131,'#ffdb74',4);line(176,131,216,131,'#ffdb74',4);line(143,131,160,140,'#ffdb74',4);line(177,131,160,140,'#ffdb74',4);
  line(159,112,159,151,'#d86dee',2);line(138,132,180,132,'#d86dee',2);
  // Airspeed and altitude tapes with true, continuously moving numbered scales.
  box(0,28,59,208,'#091923','#344a5c');box(261,28,59,208,'#091923','#344a5c');
  g.save();g.beginPath();g.rect(0,28,59,208);g.rect(261,28,59,208);g.clip();
  for(let v=Math.floor((ias-70)/10)*10;v<=ias+80;v+=10){if(v<0)continue;
   const yy=132-(v-ias)*2.20;if(yy<29||yy>236)continue;
   line(49,yy,58,yy,'#d4e6eb',1.2);if(v%20===0)txt(String(v),45,yy+4,12,'#f0f7f8','right');
  }
  for(let v=Math.floor((alt-1000)/100)*100;v<=alt+1000;v+=100){if(v<0)continue;
   const yy=132-(v-alt)*.27;if(yy<29||yy>236)continue;
   line(261,yy,270,yy,'#d4e6eb',1.2);if(v%200===0)txt(String(v),274,yy+4,11,'#f0f7f8');
  }
  g.restore();
  box(2,116,56,32,'#101d28','#d7f7fa');box(263,116,55,32,'#101d28','#d7f7fa');
  txt(String(ias),30,138,19,'#f6ffff','center');txt(Math.round(alt),291,138,17,'#f6ffff','center');
  txt('IAS',9,42,10,cyan);txt('ALT',277,42,10,cyan);
  txt('M',51,226,9,'#90b5bd','right');txt('STD',312,226,10,'#9dc5cd','right');
  // Vertical speed tape and bug at right edge.
  line(309,56,309,107,'#76929d',1);line(309,159,309,209,'#76929d',1);
  txt((vs>=0?'+':'')+Math.round(vs/10)*10,305,248,11,Math.abs(vs)>1500?amber:green,'right');
  // Horizontal heading ribbon with a magenta heading bug.
  box(0,240,320,46,'#091823','#3a5360');
  for(let diff=-60;diff<=60;diff+=10){const xx=160+diff*2.3;if(xx<8||xx>313)continue;
   const bearing=(Math.round(hdg+diff)+360)%360;
   line(xx,246,xx,254,'#a9d5db',1);if(diff%20===0)txt(String(bearing).padStart(3,'0'),xx,269,11,'#e7f4f4','center');
  }
  g.fillStyle='#e75bea';g.beginPath();g.moveTo(160,242);g.lineTo(151,231);g.lineTo(169,231);g.closePath();g.fill();
  box(128,263,64,25,'#0b1a22','#b7cdd7');txt(String(Math.round(hdg)%360).padStart(3,'0')+'°',160,282,16,'#f7feff','center');
  txt(airbus?'QNH 1013':'BARO 29.92',7,296,10,cyan);
  txt((p.loadFactor||1).toFixed(1)+' G',312,296,10,green,'right');
 }else if(type===1){
  // Heading-up terrain and route display. The underlying raster follows
  // actual Scottish elevation/shore data, darkened like a real aircraft ND.
  box(0,0,320,27,'#081924','#314856');txt(airbus?'ARC  /  GPS':'MAP  /  TRACK UP',9,18,12,green);
  txt('RANGE 20 NM',311,18,11,cyan,'right');
  const originX=160,originY=225,scale=.006,rangeNm=20;
  g.save();g.beginPath();g.rect(2,29,316,240);g.clip();
  const bg=g.createRadialGradient(160,225,14,160,225,258);bg.addColorStop(0,'#13343c');bg.addColorStop(1,'#081c25');g.fillStyle=bg;g.fillRect(0,29,320,240);
  g.save();g.translate(originX,originY);g.rotate(-p.heading);
  if(activeMap===0&&highlandMapImage.width){
   const a=highlandRaster;g.save();g.globalAlpha=.40;
   g.drawImage(highlandMapImage,(a.x0-p.x)*scale,-(a.z0+(a.height-1)*a.step-p.z)*scale,(a.width-1)*a.step*scale,(a.height-1)*a.step*scale);g.restore();
  }
  g.fillStyle='rgba(0,16,22,.48)';g.fillRect(-500,-500,1000,1000);
  // Magenta great-circle-style guidance towards the active aerodrome.
  const dest=destination(),dx=(dest.x-p.x)*scale,dy=-(dest.z-p.z)*scale;
  g.strokeStyle='#eb69e4';g.lineWidth=2.5;g.setLineDash([8,5]);g.beginPath();g.moveTo(0,0);g.lineTo(dx,dy);g.stroke();g.setLineDash([]);
  if(Math.hypot(dx,dy)<500){g.fillStyle='#eb84e5';g.beginPath();g.moveTo(dx,dy-7);g.lineTo(dx+7,dy);g.lineTo(dx,dy+7);g.lineTo(dx-7,dy);g.closePath();g.fill();}
  for(const a of regionalFields[activeMap]){
   const xx=(a.x-p.x)*scale,yy=-(a.z-p.z)*scale;if(Math.abs(xx)>350||Math.abs(yy)>330)continue;
   g.strokeStyle=a===dest?'#ffbbda':'#7edfc2';g.lineWidth=1.4;g.beginPath();g.moveTo(xx-4,yy);g.lineTo(xx+4,yy);g.moveTo(xx,yy-4);g.lineTo(xx,yy+4);g.stroke();
  }
  for(const t of traffic){const xx=(t.x-p.x)*scale,yy=-(t.z-p.z)*scale;if(Math.abs(xx)>350||Math.abs(yy)>330)continue;
   g.fillStyle=t.level===2?'#f56e6f':'#8ce8e9';g.fillRect(xx-3,yy-3,6,6);
  }
  g.restore();
  // Graticule, compass rose and range arcs are aircraft-fixed.
  for(const r of [56,113,173,230]){g.strokeStyle=r===230?'#82b9a57d':'#6baa996b';g.lineWidth=r===230?1.8:1;g.beginPath();g.arc(originX,originY,r,Math.PI,0);g.stroke()}
  line(originX,30,originX,249,'#4c898780',1);line(2,originY,318,originY,'#4c898780',1);
  for(let j=-90;j<=90;j+=15){const t=j*Math.PI/180,x=originX+228*Math.sin(t),y=originY-228*Math.cos(t);const rr=j%30===0?14:7;
   line(x,y,x-rr*Math.sin(t),y+rr*Math.cos(t),'#b0d3c7',j%30===0?1.8:1);
   if(j%30===0){const bearing=(Math.round(hdg+j)+360)%360;txt(String(bearing).padStart(3,'0'),x-rr*1.85*Math.sin(t),y+rr*1.85*Math.cos(t),11,'#cfe6de','center')}
  }
  // Ownship / heading bug and flight path vector.
  g.fillStyle='#ffe595';g.beginPath();g.moveTo(160,209);g.lineTo(154,226);g.lineTo(160,222);g.lineTo(166,226);g.closePath();g.fill();
  txt('10 NM',166,110,9,'#a7c8bb');txt('5 NM',166,169,9,'#a7c8bb');
  g.restore();
  box(0,269,320,31,'#091620','#334d5b');
  const km=Math.hypot(dest.x-p.x,dest.z-p.z)/1000;
  txt('GS '+knots(p.groundSpeed||p.speed)+' KT',8,282,11,green);
  txt('TRK '+String(Math.round(hdg)%360).padStart(3,'0')+'°',159,282,11,cyan,'center');
  txt((km/1.852).toFixed(1)+' NM',311,282,11,'#d3ccf0','right');
  txt(dest.name.toUpperCase().slice(0,24),8,295,10,'#db8ee0');
 }else{
  // Engine indicating and crew alerting system, with live damage and flight
  // configuration indications for different numbers of engines.
  box(0,0,320,27,'#091620','#2c4853');txt(airbus?'ECAM / ENGINE':'EICAS / ENGINE',9,18,12,green);
  txt('SYSTEM STATUS',310,18,10,cyan,'right');
  const n=spec.engines,positions=Array.from({length:n},(_,i)=>n===4?45+i*76:n===1?160:81+i*158),rr=n===4?31:49;
  const drawDial=(cx,cy,r,val,caption)=>{
   g.strokeStyle='#324d52';g.lineWidth=n===4?7:10;g.lineCap='round';g.beginPath();g.arc(cx,cy,r,Math.PI*.80,Math.PI*2.18);g.stroke();
   g.strokeStyle=val>95?'#ffd074':green;g.beginPath();g.arc(cx,cy,r,Math.PI*.80,Math.PI*(.80+1.38*clamp(val/100,0,1)));g.stroke();
   for(let j=0;j<7;j++){const a=Math.PI*(.80+j*1.38/6);line(cx+(r+6)*Math.cos(a),cy+(r+6)*Math.sin(a),cx+(r+12)*Math.cos(a),cy+(r+12)*Math.sin(a),'#9ab2b6',1)}
   txt(Math.round(val)+'%',cx,cy+7,n===4?18:26,'#f3faf8','center');txt(caption,cx,cy+r+28,n===4?10:13,'#bacfd0','center');
  };
  for(let i=0;i<n;i++)drawDial(positions[i],96,rr,p.power*100,'N1 '+(i+1));
  line(6,175,314,175,'#3b5961');
  const status=[['EGT',Math.round(470+p.power*280)+'°'],['FUEL',Math.round(72+p.power*18)+'%'],['OIL',Math.round(78+p.engineHP*.18)+'%']];
  for(let i=0;i<status.length;i++){const xx=13+i*105;txt(status[i][0],xx,193,11,'#8fbdc4');txt(status[i][1],xx,213,17,green)}
  line(6,225,314,225,'#3b5961');
  const gear=p.gear>.95?'DOWN':p.gear<.05?'UP':'TRANSIT';
  txt('GEAR',12,241,12,'#bdd1d5');txt(gear,66,241,13,gear==='DOWN'?green:amber);
  txt('FLAPS',177,241,12,'#bdd1d5');txt(flapNames[p.flapTarget],234,241,12,cyan);
  box(10,249,300,22,'#0b1d25','#34505b');
  const health=Math.min(p.engineHP,p.health,p.wingL,p.wingR,p.gearHP);
  g.fillStyle=health>50?'#32b98b':'#e4a24d';g.fillRect(14,253,292*clamp(health/100,0,1),14);
  txt('AIRCRAFT SYSTEMS '+Math.round(health)+'%',160,264,12,'#f4faf5','center');
  txt(p.stop?'CHECK AIRCRAFT':p.stalled?'STALL WARNING':'SYSTEMS NORMAL',160,292,12,p.stop||p.stalled?'#ff7a7a':green,'center');
 }
 g.restore();
}
// The forward pilot perspective uses a high-resolution, layered instrument
// panel. Canvas curves and lighting avoid the jagged box silhouettes produced
// by projecting all the bezels as separate low-polygon 3D blocks. When the
// player turns or walks around, the model fades into the actual 3D flight deck.
function drawModernFrontPanel(g,w,h,p){
 const dpr=Math.min(w/1360,h/920),s=v=>v*dpr;
 const rounded=(x,y,ww,hh,r)=>{r=Math.max(0,Math.min(r,ww/2,hh/2));g.beginPath();g.moveTo(x+r,y);g.lineTo(x+ww-r,y);g.quadraticCurveTo(x+ww,y,x+ww,y+r);g.lineTo(x+ww,y+hh-r);g.quadraticCurveTo(x+ww,y+hh,x+ww-r,y+hh);g.lineTo(x+r,y+hh);g.quadraticCurveTo(x,y+hh,x,y+hh-r);g.lineTo(x,y+r);g.quadraticCurveTo(x,y,x+r,y);g.closePath()};
 const pill=(text,x,y,color='#cee7ed',font=12)=>{g.fillStyle=color;g.font=`600 ${s(font)}px ui-monospace,monospace`;g.fillText(text,x,y)};
 const top=h*.568+eye.pitch*h*.26,strip=top-h*.080;
 // Soft, narrow window framing. The centre windscreen is deliberately free of
 // intrusive grey beams and the whole horizon is visible above the panel.
 let shade=g.createLinearGradient(0,0,0,h*.16);shade.addColorStop(0,'rgba(10,19,29,.70)');shade.addColorStop(1,'rgba(11,26,33,0)');g.fillStyle=shade;g.fillRect(0,0,w,h*.16);
 const edge=g.createLinearGradient(0,0,w,0);edge.addColorStop(0,'#172b37');edge.addColorStop(.54,'#566c79');edge.addColorStop(1,'#172b37');g.fillStyle=edge;
 g.beginPath();g.moveTo(0,0);g.lineTo(s(22),0);g.bezierCurveTo(s(11),h*.14,s(18),h*.31,s(32),top+20);g.lineTo(0,top+30);g.closePath();g.fill();
 g.beginPath();g.moveTo(w,0);g.lineTo(w-s(22),0);g.bezierCurveTo(w-s(11),h*.14,w-s(18),h*.31,w-s(32),top+20);g.lineTo(w,top+30);g.closePath();g.fill();
 // One continuous sculpted dashboard with a subtle textured light falloff.
 const shell=g.createLinearGradient(0,strip,0,h);shell.addColorStop(0,'#354957');shell.addColorStop(.12,'#172935');shell.addColorStop(.55,'#111d28');shell.addColorStop(1,'#09131c');
 g.fillStyle=shell;g.beginPath();g.moveTo(0,h);g.lineTo(0,top+s(22));g.bezierCurveTo(w*.10,top-s(16),w*.18,top-s(12),w*.28,top-s(20));g.bezierCurveTo(w*.48,top-s(35),w*.60,top-s(31),w*.77,top-s(22));g.bezierCurveTo(w*.90,top-s(14),w*.96,top+s(5),w,top+s(12));g.lineTo(w,h);g.closePath();g.fill();
 g.save();g.strokeStyle='rgba(153,191,205,.65)';g.lineWidth=s(2);g.beginPath();g.moveTo(0,top+s(24));g.bezierCurveTo(w*.16,top-s(18),w*.27,top-s(19),w*.50,top-s(33));g.bezierCurveTo(w*.75,top-s(36),w*.9,top-s(11),w,top+s(14));g.stroke();g.restore();
 const radial=g.createRadialGradient(w*.50,top+s(75),s(2),w*.50,h*.86,w*.65);radial.addColorStop(0,'rgba(126,162,177,.12)');radial.addColorStop(1,'rgba(0,0,0,.16)');g.fillStyle=radial;g.fillRect(0,top,w,h-top);
 // Floating mode-control unit, with active IAS/HDG/ALT values and tiny knobs.
 const ctrlX=w*.199,ctrlW=w*.602,ctrlY=strip+s(5),ctrlH=s(49);
 g.fillStyle='#111f29';rounded(ctrlX,ctrlY,ctrlW,ctrlH,s(10));g.fill();g.strokeStyle='#607480';g.lineWidth=s(1.5);g.stroke();
 const heading=((Math.round(p.heading*180/Math.PI)%360)+360)%360;
 const labels=[['SPD',knots(indicatedSpeed(p))+' KT'],['HDG',String(heading).padStart(3,'0')+'°'],['ALT',Math.round(p.y*3.281).toLocaleString('en-GB')+' FT'],['V/S',Math.round(p.vs*197)+' FPM']];
 for(let i=0;i<4;i++){
  const xx=ctrlX+ctrlW*(i+.12)/4,yy=ctrlY+s(7);
  g.fillStyle='#263a45';rounded(xx,yy,ctrlW*.172,ctrlH-s(14),s(4));g.fill();
  pill(labels[i][0],xx+s(8),yy+s(12),'#91aeb9',9);pill(labels[i][1],xx+s(8),yy+s(28),i===0?'#98f1d0':'#e5f0ef',13);
  const knobX=xx+ctrlW*.19,knobY=ctrlY+ctrlH*.50;g.fillStyle='#6e828c';g.beginPath();g.arc(knobX,knobY,s(10),0,tau);g.fill();g.strokeStyle='#c2ced1';g.lineWidth=s(2);g.beginPath();g.moveTo(knobX,knobY-s(6));g.lineTo(knobX,knobY-s(1));g.stroke();
 }
 // Deep anti-glare rim defines the boundary between exterior scenery and the
 // pilot's displays, instead of using a featureless rectangular solid.
 const rim=g.createLinearGradient(0,top-s(19),0,top+s(44));rim.addColorStop(0,'#526976');rim.addColorStop(.2,'#293e49');rim.addColorStop(1,'#0c1b25');g.fillStyle=rim;
 g.beginPath();g.moveTo(w*.09,top+s(44));g.quadraticCurveTo(w*.18,top-s(18),w*.34,top-s(15));g.quadraticCurveTo(w*.58,top-s(26),w*.77,top-s(15));g.quadraticCurveTo(w*.90,top-s(10),w*.94,top+s(43));g.closePath();g.fill();
 const unit=w*.217,ratio=unit*.95,space=w*.024,overall=unit*3+space*2,start=(w-overall)/2,screenY=top+s(37);
 for(let i=0;i<3;i++){
  const x=start+i*(unit+space),y=screenY;
  g.save();g.shadowColor='#000b15';g.shadowBlur=s(21);g.shadowOffsetY=s(8);g.fillStyle='#07121b';rounded(x-s(13),y-s(14),unit+s(26),ratio+s(28),s(9));g.fill();g.restore();
  g.fillStyle='#273e4b';rounded(x-s(10),y-s(11),unit+s(20),ratio+s(22),s(7));g.fill();
  g.fillStyle='#020d13';rounded(x-s(4),y-s(5),unit+s(8),ratio+s(10),s(3));g.fill();
  g.save();rounded(x,y,unit,ratio,s(3));g.clip();drawAvionicsScreen(g,i,x,y,unit,ratio,p);
  const glass=g.createLinearGradient(x,y,x+unit*.83,y+ratio);glass.addColorStop(0,'rgba(210,245,249,.13)');glass.addColorStop(.42,'rgba(255,255,255,0)');glass.addColorStop(1,'rgba(76,145,176,.035)');g.fillStyle=glass;g.fillRect(x,y,unit,ratio);g.restore();
  g.strokeStyle='#7e9aa6';g.lineWidth=s(1.25);rounded(x-s(5),y-s(6),unit+s(10),ratio+s(12),s(5));g.stroke();
  const systemsTitle=fleet.value.startsWith('Airbus')?'ECAM  /  SYSTEMS':spec.kind==='prop'?'ENGINE  /  PROPS':'EICAS  /  SYSTEMS';
  const legends=['PFD  /  PRIMARY FLIGHT','ND  /  ROUTE MAP',systemsTitle];
  pill(legends[i],x+s(8),y-s(19),'#c9dddf',10);
  for(let k=0;k<7;k++){
   const bx=x+(k+.5)*unit/7,by=y+ratio+s(13);
   g.fillStyle=k===3?'#9bafba':'#536875';rounded(bx-s(9),by,s(18),s(7),s(2));g.fill();
  }
  for(let k=0;k<4;k++)for(const side of [-1,1]){
   const bx=side<0?x-s(14):x+unit+s(6),by=y+(k+.7)*ratio/5;
   g.fillStyle='#718994';rounded(bx,by,s(8),s(15),s(2));g.fill();
  }
 }
 // Compact centre pedestal, throttle quadrant and ergonomic Boeing yoke.
 const py=h*.952,pw=unit*.58;
 g.fillStyle='#263c47';rounded(w*.5-pw*.5,py-s(37),pw,s(110),s(13));g.fill();
 g.fillStyle='#0c1921';rounded(w*.5-pw*.39,py-s(24),pw*.78,s(77),s(6));g.fill();
 for(let k=0;k<spec.engines;k++){
  const x=w*.5+(k-(spec.engines-1)/2)*s(spec.engines===4?13:25),y=py-s(1)-p.throttle*s(16);
  g.strokeStyle='#a5b6b9';g.lineWidth=s(4);g.beginPath();g.moveTo(x,py+s(24));g.lineTo(x,y);g.stroke();
  g.fillStyle='#c4d0ca';rounded(x-s(10),y-s(7),s(20),s(11),s(4));g.fill();
 }
 // The yoke is deliberately kept below the PFD so it never hides instruments.
 if(!fleet.value.startsWith('Airbus')){
  const yokeX=start+unit*.5,yokeY=h*.987;
  g.strokeStyle='#171f29';g.lineCap='round';g.lineWidth=s(28);g.beginPath();g.moveTo(yokeX,yokeY+s(35));g.lineTo(yokeX,yokeY-s(31));g.stroke();
  g.strokeStyle='#364953';g.lineWidth=s(19);g.beginPath();g.moveTo(yokeX-s(67),yokeY-s(31));g.quadraticCurveTo(yokeX,yokeY-s(50),yokeX+s(66),yokeY-s(31));g.stroke();
  g.strokeStyle='#80949b';g.lineWidth=s(4);g.beginPath();g.moveTo(yokeX-s(51),yokeY-s(39));g.quadraticCurveTo(yokeX,yokeY-s(51),yokeX+s(50),yokeY-s(39));g.stroke();
 }
 // Backlit flap, gear, and speed readouts remain visible at the screen base.
 const systemsY=Math.min(h-s(19),screenY+ratio+s(45));
 pill('FLAPS '+flapNames[p.flapTarget],start,systemsY,'#8bd1c0',11);
 pill('GEAR '+(p.gear>.95?'DOWN':p.gear<.05?'UP':'TRANSIT'),start+unit+space,systemsY,p.gear>.95?'#a6f1b7':'#edc17d',11);
 pill('ENGINE '+Math.round(p.power*100)+'%',start+2*(unit+space),systemsY,'#c1e2df',11);
}
// Combat aircraft receive a dedicated forward view rather than the airliner
// dash: HUD combiner glass, illuminated flight symbology, multifunction
// displays and a low centre console that leaves plenty of canopy visibility.
function drawFighterFrontPanel(g,w,h,p){
 const scale=Math.min(w/1360,h/920),s=v=>v*scale,neon='#93ffc4';
 const txt=(t,x,y,size=13,color=neon,align='left')=>{g.fillStyle=color;g.font=`600 ${s(size)}px ui-monospace,monospace`;g.textAlign=align;g.fillText(t,x,y)};
 const rr=(x,y,ww,hh,r)=>{r=Math.min(r,ww/2,hh/2);g.beginPath();g.moveTo(x+r,y);g.lineTo(x+ww-r,y);g.quadraticCurveTo(x+ww,y,x+ww,y+r);g.lineTo(x+ww,y+hh-r);g.quadraticCurveTo(x+ww,y+hh,x+ww-r,y+hh);g.lineTo(x+r,y+hh);g.quadraticCurveTo(x,y+hh,x,y+hh-r);g.lineTo(x,y+r);g.quadraticCurveTo(x,y,x+r,y);g.closePath()};
 // Tinted panoramic canopy bow, without an opaque overhead slab.
 let tint=g.createLinearGradient(0,0,0,h*.40);tint.addColorStop(0,'rgba(17,34,49,.18)');tint.addColorStop(1,'rgba(17,34,49,0)');g.fillStyle=tint;g.fillRect(0,0,w,h*.40);
 g.strokeStyle='#2a414e';g.lineWidth=s(21);g.beginPath();g.moveTo(w*.03,h*.51);g.bezierCurveTo(w*.04,-h*.10,w*.96,-h*.10,w*.97,h*.51);g.stroke();
 g.strokeStyle='#637e89';g.lineWidth=s(3);g.beginPath();g.moveTo(w*.03,h*.51);g.bezierCurveTo(w*.04,-h*.10,w*.96,-h*.10,w*.97,h*.51);g.stroke();
 // Glass combiner projects bright green instruments over the outside world.
 g.save();g.beginPath();g.moveTo(w*.355,h*.16);g.lineTo(w*.645,h*.16);g.lineTo(w*.618,h*.54);g.lineTo(w*.382,h*.54);g.closePath();g.fillStyle='rgba(28,92,99,.09)';g.fill();g.strokeStyle='rgba(126,237,191,.30)';g.lineWidth=s(2);g.stroke();g.clip();
 g.save();g.translate(w*.5,h*.335);g.rotate(-p.bank);g.translate(0,p.pitch*h*.46);g.strokeStyle='rgba(138,255,185,.78)';g.lineWidth=s(1.5);
 for(let deg=-30;deg<=30;deg+=5){const yy=-deg*s(3.5),long=deg%10===0,half=s(long?53:31);g.beginPath();g.moveTo(-half,yy);g.lineTo(half,yy);g.stroke();if(long){txt(Math.abs(deg),-half-s(17),yy+s(4),11);txt(Math.abs(deg),half+s(8),yy+s(4),11)}}
 g.restore();
 // Velocity vector, weapon-safe centre cross, pitch ladder and compass tape.
 const centreX=w*.5,centreY=h*.335;
 g.strokeStyle=neon;g.lineWidth=s(2);g.beginPath();g.arc(centreX,centreY,s(9),0,tau);g.moveTo(centreX-s(38),centreY);g.lineTo(centreX-s(12),centreY);g.moveTo(centreX+s(12),centreY);g.lineTo(centreX+s(38),centreY);g.moveTo(centreX,centreY+s(9));g.lineTo(centreX,centreY+s(20));g.stroke();
 txt(String(knots(indicatedSpeed(p))).padStart(3,'0'),w*.39,h*.325,24);txt('KTS',w*.39,h*.349,11);
 txt(String(Math.round(p.y*3.28084)).padStart(4,'0'),w*.61,h*.325,24,neon,'right');txt('FT',w*.61,h*.349,11,neon,'right');
 const hdg=((Math.round(p.heading*180/Math.PI)%360)+360)%360;
 txt(String(hdg).padStart(3,'0')+'°',w*.5,h*.20,20,neon,'center');
 txt((p.loadFactor||1).toFixed(1)+' G',w*.40,h*.485,13);txt(Math.round(p.vs*196.85)+' FPM',w*.60,h*.485,13,neon,'right');
 txt(p.stalled?'STALL':p.stop?'CAUTION':'FLIGHT · NAV',w*.5,h*.505,14,p.stalled||p.stop?'#ffbd74':neon,'center');g.restore();
 // Instrument coaming: smooth rounded matte carbon, not giant polygon blocks.
 const top=h*.615+eye.pitch*h*.20;
 const dash=g.createLinearGradient(0,top,0,h);dash.addColorStop(0,'#394d58');dash.addColorStop(.12,'#192b36');dash.addColorStop(.60,'#101c29');dash.addColorStop(1,'#091521');
 g.fillStyle=dash;g.beginPath();g.moveTo(0,h);g.lineTo(0,top+s(8));g.bezierCurveTo(w*.21,top-s(32),w*.33,top-s(26),w*.5,top-s(8));g.bezierCurveTo(w*.67,top-s(25),w*.81,top-s(31),w,top+s(8));g.lineTo(w,h);g.closePath();g.fill();
 g.strokeStyle='#8296a0';g.lineWidth=s(2.2);g.beginPath();g.moveTo(0,top+s(9));g.bezierCurveTo(w*.21,top-s(31),w*.33,top-s(25),w*.5,top-s(7));g.bezierCurveTo(w*.67,top-s(24),w*.81,top-s(30),w,top+s(9));g.stroke();
 const dx=w*.185,dw=w*.188,dh=h*.237,dy=top+s(42),gap=w*.034;
 for(let j=0;j<3;j++){
  const x=dx+j*(dw+gap),yy=dy;
  g.save();g.shadowColor='#000711';g.shadowBlur=s(20);g.fillStyle='#08151d';rr(x-s(13),yy-s(14),dw+s(26),dh+s(28),s(9));g.fill();g.restore();
  g.fillStyle='#324653';rr(x-s(8),yy-s(9),dw+s(16),dh+s(18),s(6));g.fill();
  g.save();rr(x,yy,dw,dh,s(3));g.clip();drawAvionicsScreen(g,j===0?1:j===1?0:2,x,yy,dw,dh,p);g.restore();
  txt(['RADAR / NAV','FLIGHT DATA','ENGINE / SYS'][j],x+s(5),yy-s(18),11,'#d0e4df');
  for(let k=0;k<6;k++){
   const bx=x+(k+.5)*dw/6;
   g.fillStyle=k===2?'#92aeb0':'#60757e';rr(bx-s(7),yy+dh+s(10),s(14),s(8),s(2));g.fill();
  }
 }
 // Glowing master caution, landing-gear lamps and throttle handles.
 const lampY=dy+dh+s(36);
 txt('MASTER  '+(p.stop?'WARN':'ARM'),w*.25,lampY,12,p.stop?'#ff956a':'#b5d5d4');
 txt('GEAR  '+(p.gear>.95?'DOWN':'UP'),w*.51,lampY,12,p.gear>.95?'#93ffc4':'#f0bd79','center');
 txt('N1  '+Math.round(p.power*100)+'%',w*.77,lampY,12,neon,'right');
 g.fillStyle='#1d3341';rr(w*.45,h*.924,w*.10,h*.13,s(12));g.fill();
 for(let k=0;k<2;k++){
  const bx=w*.486+k*s(26),by=h*.936-p.throttle*s(13);
  g.strokeStyle='#8da2aa';g.lineWidth=s(4);g.beginPath();g.moveTo(bx,h*.986);g.lineTo(bx,by);g.stroke();
  g.fillStyle='#bcc6c9';rr(bx-s(9),by-s(5),s(18),s(11),s(3));g.fill();
 }
}
function drawFighterSideView(g,w,h){
 // The low canopy rail stays outside the pilot's head and keeps side views
 // transparent. Old near-clipped polygons hid the entire lower window when
 // the pilot looked 90 degrees sideways.
 const s=Math.min(w/1360,h/920),side=Math.sign(eye.yaw)||1,rail=h*(.79+Math.min(.06,Math.abs(eye.pitch)*.10));
 const sill=g.createLinearGradient(0,rail,0,h);sill.addColorStop(0,'#536875');sill.addColorStop(.08,'#263f4c');sill.addColorStop(.30,'#142833');sill.addColorStop(1,'#08141f');
 g.fillStyle=sill;g.beginPath();g.moveTo(0,h);g.lineTo(0,rail+h*.028);g.bezierCurveTo(w*.29,rail-h*.035,w*.67,rail-h*.018,w,rail+h*.018);g.lineTo(w,h);g.closePath();g.fill();
 g.strokeStyle='#819aa7';g.lineWidth=2*s;g.beginPath();g.moveTo(0,rail+h*.028);g.bezierCurveTo(w*.29,rail-h*.035,w*.67,rail-h*.018,w,rail+h*.018);g.stroke();
 // A narrow forward canopy post indicates the direction of the nose.
 const edge=side>0?w*.98:w*.02;g.strokeStyle='rgba(47,67,79,.90)';g.lineWidth=13*s;g.beginPath();g.moveTo(edge,-h*.08);g.quadraticCurveTo(edge-side*w*.10,h*.38,edge-side*w*.06,rail);g.stroke();
 g.strokeStyle='rgba(172,199,207,.48)';g.lineWidth=2*s;g.stroke();
