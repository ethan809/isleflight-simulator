const svgParts=Object.fromEntries(['svgHorizon','svgSpeed','svgAltitude','svgCompassRose','svgBearingMarker','svgHeading','svgDestination','svgDistance','svgEngineArc','svgPower','svgGear','svgFlaps','svgVSpeed'].map(id=>[id,svgScope.querySelector('#'+id)]));
function updateSvgScope(p,gear){
 const heading=((p.heading*180/Math.PI)%360+360)%360,bank=p.bank*180/Math.PI;
 const dest=destination(),bearing=Math.atan2(dest.x-p.x,dest.z-p.z)*180/Math.PI;
 svgParts.svgHorizon.setAttribute('transform',`translate(90 84) rotate(${-bank.toFixed(2)}) translate(0 ${(p.pitch*210).toFixed(1)})`);
 svgParts.svgCompassRose.setAttribute('transform',`rotate(${-heading.toFixed(2)} 270 91)`);
 svgParts.svgBearingMarker.setAttribute('transform',`rotate(${(bearing-heading).toFixed(2)} 270 91)`);
 svgParts.svgSpeed.textContent=knots(indicatedSpeed(p))+' KT';svgParts.svgAltitude.textContent=Math.round(p.y*3.281)+' FT';
 svgParts.svgHeading.textContent=Math.round(heading).toString().padStart(3,'0')+'°';
