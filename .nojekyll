// Keep flight progress and the preferred paint for each class when changing aircraft.
const savedPaint={civil:'Ryanair',display:'Silver / orange'};
paint.replaceChildren(...Object.keys(schemes).map(name=>new Option(name,name)));
paint.value=savedPaint.civil;
function chooseAircraft(){
 const previousSpec=spec;
 const oldClass=spec.kind==='fighter'?'display':'civil';
 savedPaint[oldClass]=paint.value;
 spec=profiles[fleet.value]||transport;
 const newClass=spec.kind==='fighter'?'display':'civil';
 if(newClass!==oldClass){
  const choices=newClass==='display'?displayPaint:schemes;
  paint.replaceChildren(...Object.keys(choices).map(name=>new Option(name,name)));
  paint.value=savedPaint[newClass];
 }
 // Concorde originally flew with British Airways and Air France, not the
 // generic initial Ryanair preset. Keep any deliberately selected paint.
 if(fleet.value==='Concorde'&&paint.value==='Ryanair'){
  paint.value='British Airways';savedPaint.civil=paint.value;
 }
 if(spec.kind==='fighter'&&passenger)passenger=false;updateViewButtons();
 rollHelp.hidden=spec.kind!=='fighter';
 centreEye();centreOrbit();buildPlane();
 // Switching types is not a restart. Keep the current world position, heading,
 // flight mode, damage, flap/gear settings and throttle. Only ensure a heavier
 // aircraft has enough airspeed to avoid an instantaneous artificial stall.
 if(plane&&plane.air)plane.speed=Math.max(plane.speed,spec.stall*1.10);
 if(plane&&!plane.air)plane.y=Math.max(plane.y,terrainHeight(plane.x,plane.z,activeMap)+Math.max(0,spec.bodyHeight-previousSpec.bodyHeight)*.22);
 if(plane){plane.pitchRate=0;plane.rollRate=0;plane.propPhase=0}
 refreshQuickSwap();fleet.blur();
}
fleet.onchange=chooseAircraft;paint.onchange=()=>{savedPaint[spec.kind==='fighter'?'display':'civil']=paint.value;buildPlane();refreshQuickSwap();paint.blur()};buildPlane();void loadArtistAirframes();
const quickSwapBtn=document.getElementById('quickSwapBtn'),quickSwapPanel=document.getElementById('quickSwapPanel');
const quickFleet=document.getElementById('quickFleet'),quickPaint=document.getElementById('quickPaint'),quickClose=document.getElementById('quickClose');
function refreshQuickSwap(){
 quickFleet.replaceChildren(...Array.from(fleet.options).filter(o=>o.value).map(o=>new Option(o.textContent||o.text,o.value)));
 quickFleet.value=fleet.value;
 quickPaint.replaceChildren(...Array.from(paint.options).filter(o=>o.value).map(o=>new Option(o.textContent||o.text,o.value)));
 quickPaint.value=paint.value;
}
quickSwapBtn.onclick=()=>{const opening=quickSwapPanel.hidden;refreshQuickSwap();quickSwapPanel.hidden=!opening;quickSwapBtn.setAttribute('aria-expanded',String(opening));if(opening){setupPanel.hidden=true;setupButton.setAttribute('aria-expanded','false');if(!chartPanel.hidden)chartOpen(false);keys.clear()}};
quickClose.onclick=()=>{quickSwapPanel.hidden=true;quickSwapBtn.setAttribute('aria-expanded','false')};
quickFleet.onchange=()=>{fleet.value=quickFleet.value;chooseAircraft()};
quickPaint.onchange=()=>{paint.value=quickPaint.value;paint.onchange()};
refreshQuickSwap();
const driveBtn=document.getElementById('driveBtn'),drivePanel=document.getElementById('drivePanel'),driveClose=document.getElementById('driveClose');
const carChoice=document.getElementById('carChoice'),carTown=document.getElementById('carTown'),driveStart=document.getElementById('driveStart'),driveReturn=document.getElementById('driveReturn');
const driveLoading=document.getElementById('driveLoading');
const drivingTowns={Wick:[58.439,-3.091],Brora:[58.012,-3.852],Golspie:[57.972,-3.978],Dornoch:[57.883,-4.030],Inverness:[57.478,-4.225],Glasgow:[55.863,-4.251]};
function closeDriveMenu(){drivePanel.hidden=true;driveBtn.setAttribute('aria-expanded','false');keys.clear()}
driveClose.onclick=closeDriveMenu;
driveBtn.onclick=()=>{
 const open=drivePanel.hidden;drivePanel.hidden=!open;driveBtn.setAttribute('aria-expanded',String(open));
 driveReturn.hidden=!driving;driveStart.textContent=driving?'Change car / starting point':'🚗 Start driving';
 if(open){quickSwapPanel.hidden=true;quickSwapBtn.setAttribute('aria-expanded','false');setupPanel.hidden=true;setupButton.setAttribute('aria-expanded','false');if(!chartPanel.hidden)chartOpen(false)}keys.clear();
};
// Project onto actual OSM road centre-lines rather than inventing new streets.
// Other regions reuse their generated roadNetwork, and the driver can leave roads.
function nearestDriveRoad(px,pz,region){
 let closest=null,best=Infinity;
 const consider=(ax,az,bx,bz)=>{
  const dx=bx-ax,dz=bz-az,sq=dx*dx+dz*dz;if(sq<.7)return;
  const t=clamp(((px-ax)*dx+(pz-az)*dz)/sq,0,1),x=ax+dx*t,z=az+dz*t;
  const ds=(px-x)**2+(pz-z)**2;if(ds>=best||!landMask(x,z,region))return;
  best=ds;const d=Math.sqrt(sq),pxSide=-dz/d,pzSide=dx/d;
  closest={x:x+pxSide*1.5,z:z+pzSide*1.5,heading:Math.atan2(dx,dz)};
 };
 if(region===0){
  for(const r of realHighlandRoads){if(r[0]>3)continue;
   let ax=r[1]+r[3],az=r[2]+r[4];
   for(let j=5;j<r.length;j+=2){const bx=r[1]+r[j],bz=r[2]+r[j+1];consider(ax,az,bx,bz);ax=bx;az=bz}
  }
 }else for(const road of roadNetwork){if(road.region!==region)continue;
  for(const s of road.segments)consider(s.x,s.z,s.x+s.ux*s.len,s.z+s.uz*s.len);
 }
 return closest;
}
function boardCar(){
 const chosen=carChoice.value;
 if(!licensedCars.has(chosen)){driveLoading.textContent='The '+licensedCarNames[chosen]?.name+' model is still loading. Please try again shortly.';return}
 if(carTown.value!=='near'&&activeMap!==0){regionSelect.value='0';regionSelect.onchange()}
 let x=plane.x,z=plane.z;
 if(carTown.value!=='near'){
  const [lat,lon]=drivingTowns[carTown.value];x=(lon+5)*111320*Math.cos(57.75*Math.PI/180);z=(lat-57.75)*111200;
 }
 const target=nearestDriveRoad(x,z,activeMap);
 if(!target){driveLoading.textContent='Could not find a drivable road at this spot. Select another town.';return}
 Object.assign(driver,target,{model:chosen,speed:0,steering:0,accel:0,brake:0,stick:0,trigger:0,reverse:0,handbrake:false,cameraYaw:0,cameraPitch:-.30,cameraDistance:11,damage:0});
 driver.y=terrainHeight(driver.x,driver.z,activeMap)+.08;
 driving=true;carInside=false;onFoot=false;cockpit=false;passenger=false;keys.clear();
 closeDriveMenu();driveReturn.hidden=false;exitBtn.textContent='E · Exit car';updateViewButtons();
}
driveStart.onclick=boardCar;
driveReturn.onclick=()=>{driving=false;carInside=false;onFoot=false;driver.speed=0;driver.stick=driver.trigger=driver.reverse=0;closeDriveMenu();exitBtn.textContent='E · Exit';updateViewButtons()};
function collisionCarBuilding(x,z){
 const cell=buildingCells.get(buildingCellKey(activeMap,x,z));if(!cell)return null;
 for(const b of cell)if(!b.destroyed&&x>=b.minX-1&&x<=b.maxX+1&&z>=b.minZ-1&&z<=b.maxZ+1&&pointInsideBuilding(x,z,b.pts))return b;
 return null;
}
function stepCar(dt){
 const steering=Number(keys.has('d')||keys.has('arrowright'))-Number(keys.has('a')||keys.has('arrowleft'))+driver.stick;
 const accelerating=Math.max(Number(keys.has('w')||keys.has('arrowup')),driver.trigger);
 const reversing=Math.max(Number(keys.has('s')||keys.has('arrowdown')),driver.reverse);
 const braking=!!keys.has(' ')||driver.handbrake;
 const desiredSteer=clamp(steering,-1,1);
 driver.steering+=(desiredSteer-driver.steering)*(1-Math.exp(-dt*9));
 const drag=1.1+driver.speed*driver.speed*.0025;
 const deceleration=Math.sign(driver.speed)*drag;
 let force=accelerating*8.1-reversing*(driver.speed>1?12:4.0)-deceleration;
 if(braking)force-=Math.sign(driver.speed)*25;
 driver.speed=clamp(driver.speed+force*dt,-13,47);
 if(!accelerating&&!reversing&&Math.abs(driver.speed)<.34)driver.speed=0;
 if(braking&&Math.abs(driver.speed)<.65)driver.speed=0;
 const turn=Math.atan(driver.steering*.48),speedForTurn=driver.speed;
 driver.heading+=speedForTurn/2.85*Math.tan(turn)*dt;
 const x=driver.x+Math.sin(driver.heading)*driver.speed*dt,z=driver.z+Math.cos(driver.heading)*driver.speed*dt;
 if(!landMask(x,z,activeMap)){driver.speed*=-.22;driver.damage=clamp(driver.damage+dt*12,0,100)}
 else{
  const frontX=x+Math.sin(driver.heading)*2.15,frontZ=z+Math.cos(driver.heading)*2.15;
  const hit=collisionCarBuilding(frontX,frontZ);
  if(hit&&Math.abs(driver.speed)>6){explodeBuilding(hit);driver.damage=clamp(driver.damage+Math.abs(driver.speed)*.58,0,100);driver.speed*=-.12}
  else if(hit)driver.speed=0;
  else{driver.x=x;driver.z=z}
 }
 driver.y=terrainHeight(driver.x,driver.z,activeMap)+.08;
 trafficTime+=dt;updateBuildingFragments(dt);
}
// Closed flight plans with tangent-continuous turns. Each leg joins two airports via the runway approaches.
function serviceRoute(a,b,type,code,phase){const pts=[],sign=b.x>a.x?1:-1,dx=b.x-a.x,dz=b.z-a.z,len=Math.hypot(dx,dz),cruise=clamp(len*.065,590,1750),approach=Math.min(3300,Math.max(1600,len*.14));
 const stop=(f,end)=>{const side=end?sign:-sign;return [[f.x,f.z-950,8],[f.x,f.z+250,30],[f.x+side*200,f.z+approach,260]]};
 const ab=stop(a,0),ba=stop(b,1);
 pts.push(...ab,[a.x+dx*.44-sign*len*.12,a.z+dz*.44+approach,cruise],[b.x+sign*190,b.z-approach,224],...ba,[b.x-dx*.44+sign*len*.12,b.z-dz*.44+approach,cruise+95],[a.x-sign*190,a.z-approach,220]);
 const tangents=pts.map((p,j)=>{const prev=pts[(j+pts.length-1)%pts.length],next=pts[(j+1)%pts.length],v=p.map((n,k)=>next[k]-prev[k]),dist=Math.hypot(v[0],v[1])||1,reach=Math.min(Math.hypot(p[0]-prev[0],p[1]-prev[1]),Math.hypot(next[0]-p[0],next[1]-p[1]))*.84;return v.map((n,k)=>n/dist*reach)});
 const legs=pts.map((p,j)=>{const next=pts[(j+1)%pts.length],d=Math.hypot(next[0]-p[0],next[1]-p[1]),speed=(type===2?78:type===1?126:111)*((p[2]+next[2])<400?.68:1);return Math.max(3,d/speed)});return{pts,tangents,legs,duration:legs.reduce((v,n)=>v+n,0),type,code,phase}}
function sampleService(route,time){const {pts,tangents,legs,duration}=route;let remain=(time+route.phase*duration)%duration,leg=0;while(leg<legs.length-1&&remain>=legs[leg])remain-=legs[leg++];const next=(leg+1)%pts.length,t=remain/legs[leg],u=t*t,v=u*t;
