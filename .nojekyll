 const dream=fleet.value.includes('787'),a350=fleet.value.includes('350');
 const [tail,stripe,accent,belly]=schemes[paint.value];
 const white='#f0f3f1',upperWing='#d6e1e0',underWing='#899ca7';
 const profiles=[[-.50,.035,.10,.14],[-.484,.23,.30,.08],[-.452,.48,.58,.02],[-.420,.73,.81,-.025],[-.355,.94,.98,0],[-.255,1,1,0],[.075,1.015,1.02,0],[.280,1,1,0],[.349,.91,.95,-.025],[.409,.67,.75,-.11],[.458,.36,.42,-.17],[.490,.09,.14,-.19],[.50,.013,.025,-.19]];
 const sections=[];
 for(let k=0;k<profiles.length-1;k++){
  const a=profiles[k],b=profiles[k+1],before=profiles[Math.max(0,k-1)],after=profiles[Math.min(profiles.length-1,k+2)];
  const count=Math.max(3,Math.ceil((b[0]-a[0])*L/1.2));
