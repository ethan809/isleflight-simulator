  if(touching&&!runway){damage(p,'gearHP',65,'Off-field landing');compressAirframe(p,'belly',.32);compressAirframe(p,'nose',clamp(p.speed/440,.08,.55));skid(p,'Off-field slide');return}
  if(touching&&p.gear<.999){damage(p,'engineHP',52,'Nacelle scrape');compressAirframe(p,'belly',.56);compressAirframe(p,'engine',.45);skid(p,'Belly landing · fuselage scraped');return}
  if(touching&&Math.abs(p.bank)>.13)damage(p,p.bank>0?'wingL':'wingR',48,'Wingtip strike');
  if(touching&&(Math.abs(Math.sin(p.heading))>.12||Math.abs(p.groundVX)>5.5))damage(p,'gearHP',35,'Side-loaded gear');
