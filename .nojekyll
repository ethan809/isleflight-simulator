// Imported English OSM footprints: exact street-facing outlines, locally
// estimated heights where OSM lacks a height tag, and stable wall/roof LODs.
const englandOSMGroups=new Map();let realEnglandBuildingCount=0;
for(const [x,z,h,kind,...offsets] of realEnglandFootprints){
 if(offsets.length<6||!englandLand(x,z)||!englandAirportClear(x,z,125))continue;
 const pts=[];for(let k=0;k<offsets.length;k+=2)pts.push([x+offsets[k],z+offsets[k+1]]);
 if(pts.length<3||pts.length>48)continue;
 const gx=Math.floor(x/1700)*1700+850,gz=Math.floor(z/1700)*1700+850;
 const key=Math.floor(x/1700)+','+Math.floor(z/1700);
 let g=englandOSMGroups.get(key);
 if(!g){
  sceneryGroup({region:4},gx,gz,19000);g=scenicGroups[4][scenicGroups[4].length-1];
  g.farMesh=[];g.nearRange=9700;g.extent=1300;englandOSMGroups.set(key,g);
 }
 const base=Math.max(englandHeight(x,z),...pts.map(([a,b])=>englandHeight(a,b)))+.45;
 const upper=pts.map(([a,b])=>[a,base+h,b]),nearStart=g.mesh.length,farStart=g.farMesh.length;
 const colours=['#b6aaa0','#acaeaa','#b7b7ab','#d0bdac'],roofs=['#745f5e','#73716b','#777c7e','#827367'];
 const wall=colours[kind],roof=roofs[kind];
 for(let k=0;k<pts.length;k++){
  const q=(k+1)%pts.length,a=pts[k],b=pts[q],
   v=[[a[0],englandHeight(...a)+.08,a[1]],[b[0],englandHeight(...b)+.08,b[1]],upper[q],upper[k]];
  face(v,wall,g.mesh);face(v,wall,g.farMesh);
  if(k%2===0&&h>6&&Math.hypot(a[0]-b[0],a[1]-b[1])>9){
   const u=.21,v=.78,ax=mix(a[0],b[0],u),az=mix(a[1],b[1],u),bx=mix(a[0],b[0],v),bz=mix(a[1],b[1],v);
   face([[ax,base+h*.32,az],[bx,base+h*.32,bz],[bx,base+h*.77,bz],[ax,base+h*.77,az]],'#526d76',g.mesh);
  }
 }
 footprintRoof(g.mesh,pts,upper,roof);footprintRoof(g.farMesh,pts,upper,roof);
 registerBuilding(4,g,pts,base,h,nearStart,farStart);realEnglandBuildingCount++;
