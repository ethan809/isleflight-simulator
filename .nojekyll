  }
  part([[x,spec.bodyHeight*.92,spec.length*.35],[x,spec.bodyHeight*1.18,spec.length*.39],[x,spec.bodyHeight*1.15,spec.length*.43],[x,spec.bodyHeight*.89,spec.length*.41]],'#273a4a');
 }
 typeBadge.textContent=fleet.value.toUpperCase()+' · '+paint.value+' · REAL 3D MESH';
 return true;
}
async function loadArtistAirframes(){
 if(typeof fetch!=='function'||typeof Image!=='function'||typeof URL==='undefined'||typeof URL.createObjectURL!=='function')return;
 await Promise.all(Object.keys(artistFiles).map(async name=>{
  try{
   const response=await fetch('assets/'+artistFiles[name]);if(!response.ok)throw Error('HTTP '+response.status);
   const mesh=decodeAirframeGLB(await response.arrayBuffer());
   mesh.images=await Promise.all(mesh.imageBlobs.map(async blob=>{
    if(!blob)return null;const uri=URL.createObjectURL(blob),img=new Image();
    try{await new Promise((done,fail)=>{img.onload=done;img.onerror=fail;img.src=uri})}finally{URL.revokeObjectURL(uri)}
    return img;
   }));
   artistAirframes.set(name,mesh);
   installArtistTrafficMesh(name,mesh);
   if(artistSources[fleet.value]===name)buildPlane();
  }catch(err){console.warn('Airframe model unavailable:',name,err)}
 }));
}
// A dimensioned, genuinely 3D mesh for the twin-engined airliners. All sizes
