for(let i=0;i<3;i++){let x=(i-1)*.68;solid(x,.60,1.58,.64,.6,.09,dark);
 surface([[x-.29,.87,1.526],[x+.29,.87,1.526],[x+.29,.33,1.526],[x-.29,.33,1.526]],'#18242b',i)}
