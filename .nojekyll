   const [px,py,seed]=weatherParticles[i];
   const speed=snow?24:storm?180:105,drift=(trafficTime*(snow?8:17)*(1+seed*.5))%w;
   const x=((px*w+drift+(p.windX||0)*trafficTime*.6)%w+w)%w;
