function scaleAddedAircraft(){
 const name=fleet.value;if(!['Boeing 787-9','Airbus A350-900','Embraer E190','Airbus A220-300','Dash 8 Q400'].includes(name))return;
 const prop=spec.kind==='prop',sourceSpan=prop?27:36,sourceLength=prop?27:name.startsWith('Airbus')?36.4:35,sourceHeight=prop?2.22:2.95;
 const sx=spec.span/sourceSpan,sy=spec.bodyHeight/sourceHeight,sz=spec.length/sourceLength;
 for(const p of new Set(model.flatMap(face=>face.points))){p[0]*=sx;p[1]*=sy;p[2]*=sz;}
}
function limitAircraftBounds(){
 const vertices=[...new Set(model.flatMap(face=>face.points))];if(!vertices.length)return;
 const xs=vertices.map(v=>v[0]),zs=vertices.map(v=>v[2]);
 const width=Math.max(...xs)-Math.min(...xs),length=Math.max(...zs)-Math.min(...zs);
 const sx=width>spec.span*1.08?spec.span/width:1,sz=length>spec.length*1.08?spec.length/length:1;
 if(sx!==1||sz!==1)for(const v of vertices){v[0]*=sx;v[2]*=sz}
 if(spec.kind!=='fighter')wingView=model.filter(obj=>obj.points.some(v=>Math.abs(v[0])>spec.span*.105)&&obj.points.some(v=>v[2]>-spec.length*.29));
}
