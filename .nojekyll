function switchPassenger(){if(spec.kind==='fighter'||onFoot)return;passenger=!passenger;cockpit=true;centreEye();updateViewButtons()}
function updateViewButtons(){document.body.classList.toggle('driving',driving);if(carControlGuide)carControlGuide.hidden=!driving;interior.hidden=driving||!cockpit;walkHelp.hidden=driving||!cockpit&&!onFoot;viewBtn.textContent=driving?(carInside?'V · Chase':'V · Driver'):onFoot?'V · On foot':cockpit&&!passenger?'V · Chase':'V · Cockpit';cabinBtn.hidden=driving||onFoot||spec.kind==='fighter';cabinBtn.setAttribute('aria-pressed',String(passenger));walkHelp.textContent=onFoot?'ON FOOT · WASD walk · Shift sprint · Drag to look · E board plane or nearby car · Gamepad X board':passenger?'Drag to look · I/J/K/L move through the cabin · C window seat':'Drag to look · Scroll to zoom · I/J/K/L move in the flight deck · C centre'}
const originalViewButtons=updateViewButtons;
updateViewButtons=function(){originalViewButtons();gsVal.parentElement.querySelector('small').textContent=driving?'GS · MPH':'GS · KT';thrust.parentElement.querySelector('small').textContent=driving?'ACCEL':'THRUST';spd.parentElement.querySelector('small').textContent=driving?'GEAR':'IAS · KT';alt.parentElement.querySelector('small').textContent=driving?'ELEV · FT':'ALTITUDE · FT';condition.querySelector('small').textContent=driving?'CAR BODY':'AIRFRAME';if(!driving)typeBadge.textContent=fleet.value.toUpperCase()+' · '+paint.value+' · REAL 3D MESH'};
cabinBtn.onclick=switchPassenger;
const cabinCtx=interior.getContext('2d');
// A real depth buffer fixes cockpit panels bleeding through each other when
// the pilot looks up, down, back, or walks beside the centre console.
function cockpitDepthRenderer(){
