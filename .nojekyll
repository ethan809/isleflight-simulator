  for(const a of buildingFragments){
   if(a.region!==activeMap||Math.hypot(a.x-cx,a.z-cz)>3200)continue;
   const s=a.scale,t=a.ttl/6.5,bright=a.color==='#f2a84f'||a.color==='#f5a452';
   face([[a.x-s,a.y,a.z-s],[a.x+s,a.y+s*.6,a.z-s],[a.x,a.y+s*(bright?2:1),a.z+s]],bright&&t>.4?'#ffb260':a.color,shards);
  }
  draw(shards);
 }
 // Named city landmarks are anchored to verified real-world coordinates.
 // Their signs sit in the overlay, so the text can never z-fight with roofs.
 if((activeMap===0||activeMap===4)&&!cockpit){const labels=[];ctx.save();ctx.font='600 12px system-ui';
  for(const l of (activeMap===0?[...realCityLandmarks,...scottishRouteTowns]:[...englandCities,...englandLandmarks])){
   const distance=Math.hypot(l.x-cx,l.z-cz),town=activeMap===0&&!!l.route;
   const labelRange=town?distantTownVisibility:9000;
   if(distance>labelRange)continue;
   const point=camera([l.x,terrainHeight(l.x,l.z,activeMap)+(town?48:28),l.z]);if(point[2]<85||point[2]>labelRange+5000)continue;
   const px=width/2+f*point[0]/point[2],py=mid-f*point[1]/point[2];
   if(px<25||px>width-25||py<80||py>height-100)continue;
   const label=town&&distance>11500?l.name+' · '+Math.round(distance/1000)+' km':l.name;
   const tw=ctx.measureText(label).width,lx=clamp(px-tw/2-7,6,width-tw-20),ly=py-28;
   if(labels.some(b=>lx<b.x+b.w+8&&lx+tw+14>b.x&&Math.abs(ly-b.y)<27))continue;
   labels.push({x:lx,y:ly,w:tw+14});ctx.fillStyle='#14343de0';ctx.fillRect(lx,ly,tw+14,22);
   ctx.fillStyle='#ffe3a1';ctx.fillText(label,lx+7,ly+15);
   ctx.strokeStyle='#d1dbae';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(px,ly+22);ctx.lineTo(px,py);ctx.stroke();
   ctx.fillStyle='#ffe3a1';ctx.beginPath();ctx.arc(px,py,2.5,0,tau);ctx.fill();
  }ctx.restore();}
 for(const t of rotors){if(t.region!==activeMap||Math.hypot(t.x-cx,t.z-cz)>4200)continue;let blades=[];for(let j=0;j<3;j++){const a=t.phase+trafficTime*.68+tau*j/3;const tip=(r,dx)=>[t.x+r*Math.cos(a)-dx*Math.sin(a),t.y+r*Math.sin(a)+dx*Math.cos(a),t.z+1.2];blades.push({points:[tip(1,-.5),tip(6,-1.2),tip(22,-.2),tip(22,.3),tip(6,1.2)],color:'#e6e8de'})}draw(blades)}
 for(const car of civilianCars){const r=car.route;if(r.region!==activeMap)continue;
  const {x,z,heading}=sampleCar(car,trafficTime);if(Math.hypot(x-cx,z-cz)>2300)continue;const y=terrainHeight(x,z,activeMap)+.45,cs=Math.cos(heading),sn=Math.sin(heading);
  draw(car.model,([lx,ly,lz])=>[x+lx*cs+lz*sn,y+ly,z+lz*cs-lx*sn]);
 }
 if(driving&&!carInside){
  const carMesh=licensedCars.get(driver.model)||[],cs=Math.cos(driver.heading),sn=Math.sin(driver.heading);
  draw(carMesh,([lx,ly,lz])=>[driver.x+lx*cs+lz*sn,driver.y+ly,driver.z+lz*cs-lx*sn]);
 }
 // Parked aircraft and moving service traffic make the geolocated English
 // hubs feel active. Their wheels rest above the flat airport terrain.
 if(activeMap===4)for(const f of englandFields){
  if(Math.hypot(f.x-p.x,f.z-p.z)>2950)continue;
  const hub=['EGKK','EGLL','EGCC','EGBB','EGSS','EGGW','EGNX'].includes(f.code);
  for(let j=0;j<(hub?6:2);j++){
   const x=f.x+(hub?915:630)+(j%2)*240,z=f.z-920+j*(hub?325:850),y=f.elevation+3.05;
   if(Math.hypot(x-p.x,z-p.z)>2150)continue;
   const heading=j%2?Math.PI*.5:-Math.PI*.5,cs=Math.cos(heading),sn=Math.sin(heading),mesh=npcModels[j%3];
   draw(mesh,([lx,ly,lz])=>[x+lx*cs+lz*sn,y+ly,z+lz*cs-lx*sn]);
  }
  if(hub){
   const phase=(trafficTime*.013)%1,z=f.z-920+phase*1750,x=f.x+470,y=f.elevation+3.1;
   if(Math.hypot(x-p.x,z-p.z)<2300)draw(npcModels[2],([lx,ly,lz])=>[x+lx,y+ly,z+lz]);
  }
 }
 for(const [j,t] of traffic.entries()){if(Math.hypot(t.x-p.x,t.z-p.z)>8400)continue;
 const sn=Math.sin(t.heading),cs=Math.cos(t.heading),scale=t.type===1?1.55:t.type===2?.72:1;
 const cb=Math.cos(t.bank),sb=Math.sin(t.bank),ct=Math.cos(t.pitch),st=Math.sin(t.pitch);
 draw(npcModels[(j<12?j%6:t.type)],([x,y,z])=>{const bx=x*cb-y*sb,by=x*sb+y*cb,zz=z*ct-by*st;return[t.x+bx*cs+zz*sn,t.y+by*ct+z*st,t.z+zz*cs-bx*sn]});
 for(let side of [-1,1]){let [x,y,z]=camera([t.x+side*16*scale*cs,t.y+scale,t.z-side*16*scale*sn]);if(z>5){ctx.fillStyle=side<0?'#ff4249':'#39efab';ctx.beginPath();ctx.arc(width/2+f*x/z,mid-f*y/z,clamp(f*.6/z,1,5),0,tau);ctx.fill()}}
 }
 for(const field of regionalFields[activeMap]){let info=pathInfo(p,field);if(!info.visible)continue;
 let dir=Math.cos(p.heading)>=0?1:-1;
 for(let i=0;i<4;i++){let [x,y,z]=camera([field.x-dir*(45+i*10),1.35,field.z+(dir>0?-725:1125)]);if(z<1)continue;
 ctx.fillStyle=i<info.whites?'#fffce5':'#ff473b';ctx.beginPath();ctx.arc(width/2+f*x/z,mid-f*y/z,clamp(f*1.1/z,1,5),0,tau);ctx.fill()}}

 function paintAircraft(mesh,moving,transform){if(gpuActive&&sceneryGPU.aircraft){try{sceneryGPU.aircraft(mesh,moving,p,vector,false);ctx.save();ctx.setTransform(1,0,0,1,0,0);ctx.drawImage(sceneryGPU.aircraftSurface||sceneryGPU.surface,0,0);ctx.restore()}catch(e){ctx.restore();draw(mesh.concat(moving),transform)}}else draw(mesh.concat(moving),transform)}
 if(passenger&&wingView.length)paintAircraft(wingView,[],aircraft)
 // Soft aircraft ground shadow follows the actual type's wingspan and
 // orientation, and fades with AGL height. No more giant angular floor decal.
 const agl=Math.max(0,p.y-terrainHeight(p.x,p.z,activeMap));
 if(!cockpit&&!driving&&agl<180&&!onFoot){
  const S=spec.span,L=spec.length,delta=fleet.value==='Concorde';
  const half=delta?[[0,L*.50],[S*.035,L*.32],[S*.13,L*.14],[S*.47,-L*.15],[S*.49,-L*.27],[S*.10,-L*.22],[S*.06,-L*.41],[S*.14,-L*.45],[0,-L*.47]]:
   [[0,L*.5],[S*.045,L*.34],[S*.10,L*.18],[S*.46,-L*.04],[S*.49,-L*.105],[S*.13,-L*.075],[S*.075,-L*.34],[S*.20,-L*.43],[S*.20,-L*.47],[0,-L*.45]];
  const outline=half.concat(half.slice(1,-1).reverse().map(([x,z])=>[-x,z]));
  ctx.save();ctx.filter='blur('+clamp(3+agl*.045,3,12)+'px)';
  draw([{points:outline.map(([x,z])=>[x,0,z]),color:'rgba(19,33,35,'+(clamp(.25-agl*.0010,.06,.25)).toFixed(3)+')'}],v=>{
   const a=aircraft(v),gx=a[0]-2-agl*.12,gz=a[2]-3-agl*.24;
   return[gx,terrainHeight(gx,gz,activeMap)+.40,gz]});
  ctx.restore();
 }
 if(!cockpit&&!driving){
 let legs=[];
 const gearPoints=[[-spec.gearTrack,spec.mainZ],[spec.gearTrack,spec.mainZ],[0,spec.noseZ]];
 if(spec.engines===4)gearPoints.push([-2.35,spec.mainZ-2.3],[2.35,spec.mainZ-2.3]);
 if(p.gear>.01)for(let [x,z] of gearPoints){
 let y=-.38*spec.bodyHeight-(.62*spec.bodyHeight-spec.wheel)*p.gear,wx=x*(.5+.5*p.gear),wz=z+(1-p.gear)*1.3;
 face([[x-.12,-spec.bodyHeight*.35,z],[x+.12,-spec.bodyHeight*.35,z],[wx+.12,y,wz],[wx-.12,y,wz]],'#a9bac1',legs);
 for(let side of [-1,1]){let rim=[];for(let j=0;j<12;j++){let a=j*tau/12;rim.push([wx+side*.31,y+spec.wheel*Math.cos(a),wz+spec.wheel*Math.sin(a)])}face(rim,'#263038',legs)}
 face([[wx-.31,y+spec.wheel,wz],[wx+.31,y+spec.wheel,wz],[wx+.31,y,wz-spec.wheel],[wx+.31,y-spec.wheel,wz],[wx-.31,y-spec.wheel,wz],[wx-.31,y,wz-spec.wheel]],'#313b42',legs);
 }
 const exterior=bentAirframe(p);
 legs.push(...flapPanels(p));
 const raised=v=>{let pt=aircraft(v);if(p.skid)pt[1]-=1.25*(1-p.gear);return pt};if(spec.kind==='prop')legs.push(...propellers(p));paintAircraft(exterior,legs,raised);
 if(p.skid&&p.speed>4){for(let j=0;j<14;j++){let phase=(trafficTime*2+j*.073+p.z*.025)%1;if(phase<0)phase++;let [x,y,z]=camera(raised([(j%3-1)*2,.1-2.6+Math.sin(phase*Math.PI)*.65,-8-phase*12]));if(z>1){ctx.fillStyle=j%3?'#ffbf55':'#ffeaa4';ctx.fillRect(width/2+f*x/z,mid-f*y/z,2.5,1.4)}}}
 }
 if(p.ditching){
  // The hull continues below sea level while a fading ring of foam remains.
  if(!cockpit&&p.sinkTime<12){let q=camera([p.x,0,p.z]);if(q[2]>1){let sx=width/2+f*q[0]/q[2],sy=mid-f*q[1]/q[2];
   ctx.save();ctx.strokeStyle='rgba(224,251,251,'+(Math.max(0,.72-p.sinkTime*.055))+')';ctx.lineWidth=3;
   for(let i=0;i<4;i++){ctx.beginPath();ctx.ellipse(sx,sy,Math.max(2,f*(3+p.sinkTime*5+i*3)/q[2]),Math.max(1,f*(.7+p.sinkTime*.9+i)/q[2]),0,0,tau);ctx.stroke()}ctx.restore();
  }}
  if(cy<0){ctx.fillStyle='rgba(9,74,94,'+clamp(.24+(-cy)*.016,.24,.87)+')';ctx.fillRect(-extent,-extent,2*extent,2*extent)}
 }
 ctx.restore();
 drawWeatherOverlay(width,height,p);
 let gearLabel=p.gear===1?'DOWN':p.gear===0?'UP':p.gearTarget?'EXTENDING':'RETRACTING';
 flapBtn.textContent='F · Flaps '+flapNames[p.flapTarget].toLowerCase()+(Math.abs(p.flap-p.flapTarget*.5)>.015?' …':'');
 gearBtn.textContent='G · Gear '+gearLabel.toLowerCase();
 if(cockpit&&!passenger||svgScopeVisible)instruments(p,gearLabel);if(cockpit)drawCabin(width,height,f,basis,p);if(svgScopeVisible)updateSvgScope(p,gearLabel);
 gsVal.textContent=knots(p.groundSpeed||0);const indicated=indicatedSpeed(p);spd.textContent=knots(indicated);alt.textContent=Math.round(Math.max(0,p.y)*3.28084).toLocaleString('en-GB');hdg.textContent=String((Math.round(p.heading*360/tau)%360+360)%360).padStart(3,'0')+'°';
 thrust.textContent=Math.round(p.throttle*100)+'%';
 let msg=p.ditching?'WATER IMPACT · Aircraft sinking · R to restart':p.stop?p.stop+' · R to restart':p.landing&&!p.air?p.landing+(p.speed>1?' · Idle + Space to brake':' · Stopped'):!p.air?(indicated<rotateSpeed()?'W increases throttle · Rotate at '+knots(rotateSpeed())+' kt':'Hold ↓ to rotate'):p.landing&&p.arrived?p.landing:p.stallMargin<3?'Low speed · add thrust':p.vs<-.5&&p.y<45?(p.gear<.999?'Check landing gear':'Aim '+knots(landingSpeed())+' kt with landing flaps · flare gently'):'';
 let guidance=pathInfo(p,destination());if(!msg&&guidance.visible){msg=destination().name+' · '+(guidance.whites>2?'Above glide path':guidance.whites<2?'Below glide path':'On glide path')+' · '+(guidance.range/1000).toFixed(1)+' km to aiming point'}if(!p.stop&&p.air){if(p.stalled)msg='STALL · Hold ↑ to lower nose and W for thrust';else if(advisory)msg=advisory;else if(p.y>5&&p.stallMargin<5)msg='Low airspeed · approaching stall'}
 condition.hidden=p.health===100&&p.gearHP===100&&p.wingL===100&&p.wingR===100&&p.engineHP===100;integrity.textContent=Math.ceil(p.health)+'%';
 if(!p.stop&&p.damageNote&&!p.stalled&&!advisory)msg=p.damageNote+' · Gear '+Math.round(p.gearHP)+'% · Wings '+Math.round(Math.min(p.wingL,p.wingR))+'% · Engines '+Math.round(p.engineHP)+'%';
 if(!advisory&&p.vs<-.5&&p.air&&p.y<250&&!p.stalled&&!p.arrived&&p.speed*Math.sqrt(densityAt(p.y))>landingSpeed()*1.16)msg='SLOW DOWN · '+knots(indicatedSpeed(p))+' kt · target '+knots(landingSpeed())+' kt';
 else if(!advisory&&p.vs<-.5&&p.air&&p.y<120&&!p.stalled&&!p.arrived&&p.flap<.38)msg='SET LANDING FLAPS · F';
 if(p.air&&p.landing.startsWith('TOO FAST'))msg=p.landing;
 if(onFoot)msg=distanceToBoard()>14?'Walk back to the wingtip boarding point · E':'On foot · WASD move · Shift sprint · Drag to look · E to board';
 if(driving){
  const mph=Math.abs(driver.speed)*2.23694;
  typeBadge.textContent=licensedCarNames[driver.model].name.toUpperCase()+' · THIRD-PARTY 3D MODEL · DRIVING';
  gsVal.textContent=Math.round(mph);spd.textContent=driver.speed<-.3?'R':driver.speed>.3?'D':'N';
  thrust.textContent=Math.round(Math.max(Number(keys.has('w')),driver.trigger)*100)+'%';
  alt.textContent=Math.round(driver.y*3.28084).toLocaleString('en-GB');
  hdg.textContent=String((Math.round(driver.heading*360/tau)%360+360)%360).padStart(3,'0')+'°';
  condition.hidden=driver.damage<.5;integrity.textContent=Math.round(100-driver.damage)+'%';
  msg=driver.damage>55?'CAR DAMAGED · Drive carefully · E to exit':'DRIVING · '+licensedCarNames[driver.model].name+' · '+Math.round(mph)+' mph · E to get out · V camera';
  cue.style.background=driver.damage>65?'#752a32':'#153643e8';cue.textContent=msg;cue.hidden=false;return;
 }
 cue.style.background=p.stalled?'#972e36':advisory?'#784d18':'#153643e8';cue.textContent=msg;cue.hidden=!msg;
}
let chartPaint=0;
function frame(now){
 let dt=last?clamp((now-last)/1000,0,.12):0;last=now;pollController(dt);
 if(!chartPanel.hidden||!setupPanel.hidden){
  if(!chartPanel.hidden&&now-chartPaint>180){drawChart();chartPaint=now}
  requestAnimationFrame(frame);return;
 }
 if(cockpit)moveEye(dt);if(onFoot)moveWalker(dt);dt*=simRate;
 if(driving){const ticks=Math.max(1,Math.ceil(dt*80));for(let i=0;i<ticks;i++)stepCar(dt/ticks)}
 else if(!onFoot){const ticks=Math.max(1,Math.ceil(dt*120));for(let i=0;i<ticks;i++)step(dt/ticks)}
 camHeading+=Math.atan2(Math.sin(plane.heading-camHeading),Math.cos(plane.heading-camHeading))*(1-Math.exp(-3*dt));
 const began=performance.now();render();tuneResolution((performance.now()-began)/1000);
 requestAnimationFrame(frame);
}
updateTraffic(plane,0);requestAnimationFrame(frame);
</script></body></html>
