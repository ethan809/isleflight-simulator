 updateTraffic(p,dt);p.terrain=p.air?terrainHeight(p.x,p.z,activeMap):0;const wind=windVector(p,trafficTime);p.windX=wind[0];p.windZ=wind[1];p.rudder=mix(p.rudder,clamp(Number(keys.has('x'))-Number(keys.has('z'))+gamepadFlight.rudder,-1,1),1-Math.exp(-4*dt));p.gear+=clamp(p.gearTarget-p.gear,-dt*.44,dt*.44);const turn=clamp(Number(keys.has('d'))-Number(keys.has('a'))+gamepadFlight.roll,-1,1);
