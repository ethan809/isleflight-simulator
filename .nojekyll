 const read=(id)=>{const a=doc.accessors[id],b=doc.bufferViews[a.bufferView],n={SCALAR:1,VEC2:2,VEC3:3,VEC4:4}[a.type],bytes={5120:1,5121:1,5122:2,5123:2,5124:4,5125:4,5126:4}[a.componentType];
  if(!n||!bytes)throw Error('Unsupported GLB accessor');
  const result=new Array(a.count*n),base=binary+(b.byteOffset||0)+(a.byteOffset||0),stride=b.byteStride||n*bytes;
  for(let i=0;i<a.count;i++)for(let k=0;k<n;k++){const p=base+i*stride+k*bytes;
   let value=a.componentType===5126?view.getFloat32(p,true):a.componentType===5125?view.getUint32(p,true):a.componentType===5124?view.getInt32(p,true):a.componentType===5123?view.getUint16(p,true):a.componentType===5122?view.getInt16(p,true):a.componentType===5121?view.getUint8(p):view.getInt8(p);
