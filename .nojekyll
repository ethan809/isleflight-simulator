}
function windVector(p,time){const setting=Number(weather.value)||0;if(!setting)return [0,0];const swell=Math.sin(time*.20+p.z*.0005)+.52*Math.sin(time*.51+p.x*.00037),strength=setting===1?3.2:8.8;return [strength+swell*(setting===1?.6:1.5),-(setting===1?3.7:2.1)+.60*swell]}
