,-15.2,32.1,-19.2,67.7,-44.2,77.0,-48.5,84.3,-46.6],[5,11774,6937,-0.3,-0.4,-22.5,-9.3,-26.4,-15.7,-19.7,-21.4,-12.7,-20.9,-3.7,-13.3],[5,11749,6925,-0.1,-0.2,-6.8,-0.1,-15.4,4.1,-35.1,15.5,-43.6,15.1],[5,11817,6840,-0.2,0.3,9.6,2.8,19.0,9.1,27.0,17.1]];
/* END REAL HIGHLANDS ROADS */
const realRoadGroups=new Map(),highlandTrafficCells=new Map();
const roadMapInk=highlandMapImage.getContext('2d');roadMapInk.lineCap='round';roadMapInk.lineJoin='round';
let realRoadCount=0,realRoadSegments=0,highlandTrafficRoutes=0;
for(const [kind,roadX,roadZ,...offsets] of realHighlandRoads){
 if(offsets.length<4)continue;
 const pts=[];for(let j=0;j<offsets.length;j+=2)pts.push([roadX+offsets[j],roadZ+offsets[j+1]]);
 if(kind<=3){
  const r=highlandRaster;
  roadMapInk.strokeStyle=kind<=1?'#c7bda7':kind===2?'#b3ad9a':'#a1aa9a';
  roadMapInk.lineWidth=kind<=1?.82:kind===2?.55:.33;
  roadMapInk.beginPath();pts.forEach(([x,z],j)=>{
   const px=(x-r.x0)/r.step,py=r.height-1-(z-r.z0)/r.step;
   if(j)roadMapInk.lineTo(px,py);else roadMapInk.moveTo(px,py);
  });roadMapInk.stroke();
 }
 const fullWidth=[10,7.7,6.1,5,3.5,2.6][kind],colour=['#46585b','#526366','#5f6b68','#66716e','#777b6c','#817e68'][kind];
 let visible=0,totalLength=0;
 for(let j=1;j<pts.length;j++){
  const a=pts[j-1],b=pts[j],dx=b[0]-a[0],dz=b[1]-a[1],len=Math.hypot(dx,dz);
  if(len<.4)continue;
  totalLength+=len;
  const divisions=Math.max(1,Math.ceil(len/54)),sideX=-dz/len*fullWidth*.5,sideZ=dx/len*fullWidth*.5;
  for(let k=0;k<divisions;k++){
   const t=k/divisions,u=(k+1)/divisions,ax=mix(a[0],b[0],t),az=mix(a[1],b[1],t),bx=mix(a[0],b[0],u),bz=mix(a[1],b[1],u);
   const midX=(ax+bx)/2,midZ=(az+bz)/2;
   if(!landMask(midX,midZ,0)||realFields.some(f=>Math.abs(midX-f.x)<116&&Math.abs(midZ-f.z-200)<1650))continue;
   const tileX=Math.floor(midX/1900),tileZ=Math.floor(midZ/1900),key=tileX+','+tileZ;
   let mesh=realRoadGroups.get(key);
   if(!mesh){mesh=sceneryGroup({region:0},tileX*1900+950,tileZ*1900+950,7100);realRoadGroups.set(key,mesh)}
   const point=(x,z)=>[x,renderedHighlandGround(x,z)+.28,z];
   // Road paving gets its own depth layer, avoiding z-fighting with the
   // triangulated terrain beneath it on the steep Highland slopes.
   face([point(ax-sideX,az-sideZ),point(bx-sideX,bz-sideZ),point(bx+sideX,bz+sideZ),point(ax+sideX,az+sideZ)],colour,mesh);
   mesh[mesh.length-1].material=3;
   if(kind<=1&&((j+k)%3===0)&&len/divisions>13){
    const offX=dz/len*.19,offZ=-dx/len*.19;
    face([point(ax+offX,az+offZ),point(bx+offX,bz+offZ),point(bx-offX,bz-offZ),point(ax-offX,az-offZ)],'#d8d7c3',mesh);
    mesh[mesh.length-1].material=4;
   }
   visible++;realRoadSegments++;
  }
 }
 if(visible)realRoadCount++;
 // A limited, spatially distributed selection of mapped roads carries cars.
 if(visible&&kind<=2&&totalLength>360&&highlandTrafficRoutes<320){
  const cell=Math.floor(roadX/11500)+','+Math.floor(roadZ/11500),count=highlandTrafficCells.get(cell)||0;
  if(count<4){
   const road={region:0,len:0,segments:[]};
   for(let j=1;j<pts.length;j++){
    const a=pts[j-1],b=pts[j],dx=b[0]-a[0],dz=b[1]-a[1],len=Math.hypot(dx,dz);
    if(len<.4)continue;
    road.segments.push({x:a[0],z:a[1],ux:dx/len,uz:dz/len,px:-dz/len,pz:dx/len,len,offset:road.len});road.len+=len;
   }
   if(road.len>360){roadNetwork.push(road);highlandTrafficCells.set(cell,count+1);highlandTrafficRoutes++}
  }
