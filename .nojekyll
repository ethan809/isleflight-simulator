Object.assign(schemes,{'Aer Lingus':['#007567','#70bd42','#087b70','#d3e1db'],'Air France':['#e9ebec','#ce2837','#d7dcdd','#b7c3ce'],SWISS:['#c82132','#fffbec','#e4e5df','#bec9cb'],SAS:['#1b3278','#f5f6f0','#d6383c','#b8c4cc']});
function airlinerPaint(name,h,z,base){if(name==='KLM')return h>-.19?'#44afd6':h>-.30?'#254e75':'#eef3ee';if(name==='Ryanair')return h<-.53?'#253d67':h<-.44?'#e2b843':base;if(name==='Aer Lingus'&&z< -9+h*2)return '#086d69';if(name==='Delta'&&h<-.53)return '#273954';if(name==='TUI')return h<-.38?'#b4d7e3':'#f8fbfc';if(name==='Virgin Atlantic'&&h<-.54)return '#dee1e2';if(name==='Loganair'&&h<-.48)return '#d1d5dc';return base}
function tailArt(s,prop=false,jumbo=false){const code=airlineCodes[paint.value];const x=jumbo?.19:prop?.18:.19,front=jumbo?-25.6:prop?-11.29:-13.5,back=jumbo?-30.8:prop?-12.92:-15.69,top=jumbo?10.0:prop?4.52:5.88,bot=jumbo?6.2:prop?3.04:3.68;
 if(!code){if(['Jet2','Loganair','TUI','Virgin Atlantic'].includes(paint.value)){
  const t=document.createElement('canvas');t.width=512;t.height=256;
  const g=t.getContext('2d');g.fillStyle='#fff';g.textAlign='center';g.textBaseline='middle';g.font='bold 94px Arial, sans-serif';
  g.fillText(paint.value.toUpperCase(),256,128,490);
  patchSide(s,x,front,back,top,bot,t);
 }return}
 let image=insignia[code+'mark'];if(!image)return;
 if(['SAS','KLM','QFA'].includes(code)){const key=code+'white';if(!insignia[key]){const a=document.createElement('canvas');a.width=image.width;a.height=image.height;const g=a.getContext('2d');g.drawImage(image,0,0);g.globalCompositeOperation='source-in';g.fillStyle='#fafaf1';g.fillRect(0,0,a.width,a.height);insignia[key]=a}if(code!=='QFA')image=insignia[key]}
 patchSide(s,x,front,back,top,bot,image);
}
function airlineText(name){if(airlineCodes[name])return insignia[airlineCodes[name]+'title'];const tex=document.createElement('canvas');tex.width=512;tex.height=112;const g=tex.getContext('2d');g.clearRect(0,0,512,112);g.fillStyle=name==='Ryanair'?'#193c79':name==='KLM'?'#147cae':name==='Delta'?'#193c79':name==='Emirates'?'#c82029':'#bf1935';g.textAlign='center';g.textBaseline='middle';g.font='bold 74px Arial, sans-serif';g.fillText(name.toUpperCase(),256,56,490);return tex}
// A body station gives longitudinal position, half-width, half-height and centre height.
function shell(stations,offsetX,coat,sides=20){
 const rings=stations.map(([z,w,h,y])=>Array.from({length:sides},(_,i)=>{
  const a=tau*i/sides;return [offsetX+w*Math.cos(a),y+h*Math.sin(a),z];
 }));
 for(let k=1;k<rings.length;k++)for(let i=0;i<sides;i++){
  let j=(i+1)%sides;const angle=tau*(i+.5)/sides;
  part([rings[k-1][i],rings[k-1][j],rings[k][j],rings[k][i]],coat(angle,k,(stations[k][0]+stations[k-1][0])/2));
 }
}
function shade(hex,angle){
 const f=.82+.16*Math.sin(angle)+.065*Math.cos(angle);
 return '#'+[1,3,5].map(i=>clamp(Math.round(parseInt(hex.slice(i,i+2),16)*f),0,255).toString(16).padStart(2,'0')).join('');
}
function panelWing(plan,thick,upper,lower){
 const underside=plan.map(([x,y,z])=>[x,y-thick,z]);
 part(underside,lower);part(plan,upper);
 for(let i=0;i<plan.length;i++){
  const j=(i+1)%plan.length;part([plan[i],plan[j],underside[j],underside[i]],i===0?'#c1ccd1':lower);
 }
}
function patchSide(side,x,front,back,top,bottom,art){
 const left=side<0?front:back,right=side<0?back:front;
 decal([[side*x,top,left],[side*x,top,right],[side*x,bottom,right],[side*x,bottom,left]],art);
}
function cabinWindows(side,x,y,z0,count,spacing,size){
 for(let i=0;i<count;i++){
  const z=z0+i*spacing;
  part([[side*x,y,z],[side*x,y+size,z],[side*x,y+size,z+size*.63],[side*x,y,z+size*.63]],'#263f4f');
 }
}
function disk(x,y,z,r,color,segments=20){
 const ring=Array.from({length:segments},(_,i)=>[x+r*Math.cos(tau*i/segments),y+r*Math.sin(tau*i/segments),z]);
 part(ring,color);
}
function buildJumboOrProp(isProp){
 const [tail,stripe,accent,belly]=schemes[paint.value],airline={easyJet:'EZY','British Airways':'BAW',Lufthansa:'DLH'}[paint.value];
 const body=isProp?
  [[-13.8,.04,.08,.85],[-11.5,.65,.86,.55],[-7.4,1.28,1.36,.10],[-4,1.36,1.43,0],[6,1.36,1.43,0],[8.5,1.32,1.4,.01],[10.3,1.13,1.19,.02],[12.3,.65,.68,-.12],[13.45,.03,.06,-.23]]:
  [[-34,.09,.17,1.2],[-31,1.10,1.22,.82],[-25.5,2.4,2.53,.25],[-19,3.06,3.08,.03],[-4,3.16,3.14,.01],[5,3.16,3.14,.01],[9,3.15,3.33,.21],[12.6,3.15,3.89,.72],[22.9,3.08,3.94,.79],[26.5,2.85,3.65,.65],[29.8,2.42,3.03,.32],[32.3,1.58,1.62,-.20],[34.9,.06,.09,-.48]];
 shell(body,0,(a,k,z)=>{
  const h=Math.sin(a);let base='#f3f5f3';
