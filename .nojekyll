function englandLand(x,z){const lon=x/68600-2,lat=z/111200+52;
 if(lon< -5.9||lon>2||lat<49.9||lat>56)return 0;
 if(englandFields.some(f=>Math.abs(f.x-x)<1800&&Math.abs(f.z-z)<2300))return 1;
 let inside=false;for(let i=0,j=englandOutline.length-1;i<englandOutline.length;j=i++){
  const a=englandOutline[i],b=englandOutline[j];
  if((a[1]>lat)!==(b[1]>lat)&&lon<(b[0]-a[0])*(lat-a[1])/(b[1]-a[1])+a[0])inside=!inside;
 }return inside?1:0;
}
function englandHeight(x,z,knownLand=false){if(!knownLand&&!englandLand(x,z))return 0;
 const lon=x/68600-2,lat=z/111200+52,bell=(a,b,w)=>Math.exp(-Math.pow((a-b)/w,2));
 const detail=18*Math.sin(x*.00018+Math.sin(z*.00012))+13*Math.cos(z*.00021-x*.00008);
 const pennines=bell(lon,-2.1,.72)*bell(lat,54.0,1.05)*410;
 const lakes=bell(lon,-3.1,.35)*bell(lat,54.50,.34)*660;
 const moors=bell(lon,-.74,.65)*bell(lat,54.34,.48)*260;
 const wales=bell(lon,-3.77,.75)*bell(lat,52.6,.86)*780;
 const moorland=bell(lon,-3.92,.49)*bell(lat,50.55,.42)*205;
 let h=Math.max(8,20+pennines+lakes+moors+wales+moorland+detail);
 for(const f of englandFields){const dx=Math.abs(x-f.x),dz=Math.abs(z-f.z);
  if(dx>7800||dz>7800)continue;
  const outer=Math.hypot(Math.max(0,dx-1900),Math.max(0,dz-2750));
  h=mix(f.elevation,h,smooth(0,4900,outer));
 }
 return Math.max(.18,h);
}
function landMask(x,z,r){if(r===0)return highlandElevationAt(x,z)>0||realFields.some(f=>Math.abs(x-f.x)<420&&Math.abs(z-f.z-200)<1700)?1:0;if(r===3)return usaLand(x,z);if(r===4)return englandLand(x,z);for(const i of regionalIslands[r])if(Math.abs(x-i.x)<i.rx*1.23&&Math.abs(z-i.z)<i.rz*1.23){const d=radial(i,x,z);if(d<=1)return Math.max(.001,1-d)}return 0}
function smooth(a,b,v){const t=clamp((v-a)/(b-a),0,1);return t*t*(3-2*t)}
function highlandHeight(x,z){
 let h=highlandElevationAt(x,z);
 for(const f of realFields){const dx=Math.abs(x-f.x),dz=Math.abs(z-f.z-200);
  if(dx>2700||dz>3750)continue;
