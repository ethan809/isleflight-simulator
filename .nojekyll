const carMeshes=['#bfcbd0','#c54c42','#426d97','#e3c382','#566b63'].map(carModel);
const civilianCars=[];
for(const [i,route] of roadNetwork.entries()){
 const count=Math.max(3,Math.ceil(route.len/(route.region===4?1250:3200)));
 for(let k=0;k<count;k++)civilianCars.push({route,speed:11+(i*7+k*3)%13,phase:k/count,backward:k%2===1,model:carMeshes[(i+k)%carMeshes.length]});
