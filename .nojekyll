// it is not an official boundary survey or a photogrammetry scan.
const englandOutline=[
 [-5.72,50.07],[-5.47,50.12],[-5.11,50.22],[-4.75,50.32],[-4.30,50.31],
 [-3.97,50.25],[-3.49,50.42],[-3.14,50.61],[-2.76,50.58],[-2.41,50.53],
 [-1.99,50.59],[-1.62,50.68],[-1.16,50.67],[-.75,50.75],[-.12,50.82],
 [.36,50.93],[.86,51.02],[1.40,51.14],[1.41,51.35],[1.25,51.58],
 [1.16,51.91],[1.43,52.26],[1.77,52.46],[1.72,52.68],[1.43,52.95],
 [.92,53.06],[.48,53.22],[.12,53.52],[-.16,53.62],[-.18,53.78],
 [-.32,54.01],[-.39,54.27],[-.59,54.41],[-.89,54.54],[-1.17,54.63],
 [-1.31,54.83],[-1.51,55.03],[-1.82,55.31],[-1.92,55.58],[-2.03,55.76],
 [-2.28,55.75],[-2.65,55.54],[-3.04,55.12],[-3.40,54.94],[-3.59,54.84],
 [-3.38,54.63],[-3.35,54.41],[-3.18,54.20],[-3.30,53.95],[-3.05,53.63],
 [-3.09,53.40],[-3.57,53.33],[-3.95,53.33],[-4.25,53.32],[-4.43,53.15],
 [-4.54,52.87],[-4.43,52.57],[-4.75,52.17],[-5.23,51.78],[-5.40,51.67],
 [-4.95,51.58],[-4.35,51.55],[-3.77,51.47],[-3.03,51.41],[-2.80,51.28],
 [-3.04,51.08],[-3.46,51.03],[-3.95,51.16],[-4.35,51.17],[-4.79,50.94],
 [-5.12,50.74],[-5.43,50.41],[-5.72,50.07]
