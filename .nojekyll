const usaTileWidth=220000,usaTileRows=16,usaTileCols=24;
const usaCentresKm=Array.from({length:usaTileRows*usaTileCols},(_,j)=>[
 (-2640000+(j%usaTileCols+.5)*usaTileWidth)/1000,
 (-1760000+(Math.floor(j/usaTileCols)+.5)*usaTileWidth)/1000]);
const englandTileWidth=50000,englandTileCols=13,englandTileRows=15;
const englandCentresKm=Array.from({length:englandTileCols*englandTileRows},(_,j)=>[
 (-325000+(j%englandTileCols+.5)*englandTileWidth)/1000,
 (-250000+(Math.floor(j/englandTileCols)+.5)*englandTileWidth)/1000]);
const islandCentresKm=[
 highlandCentresKm,
 [[-42,-38],[49,30],[-70,74],[-159,110],[174,78],[87,-150],[22,117],[104,-12],[-134,-64],[-20,-122]],
 [[-71,-24],[39,-65],[24,57],[-171,76],[170,134],[112,-132],[-48,132],[109,34],[-142,-74],[-16,-117]],
 usaCentresKm,
 englandCentresKm
