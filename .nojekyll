const englandCities=englandCityData.map(([name,lat,lon,major])=>({name,lat,lon,major,
 x:(lon+2)*68600,z:(lat-52)*111200,region:4}));
function englandAirportClear(x,z,pad=0){return !englandFields.some(f=>Math.abs(x-f.x)<1950+pad&&Math.abs(z-f.z)<2850+pad)}
// Real surveyed building outlines replace hand-made blocks wherever mapped
