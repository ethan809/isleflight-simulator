// Terrain-following two-lane roads between airport towns. Keep the route graph
// as data so civilian cars travel on exactly the same visible roads.
// Connect neighbouring towns using the shortest clear path around protected runway rectangles.
const roadNetwork=[],roadKeys=new Set();
function roadPath(start,end,airports){const bounds=airports.map(f=>[f.x-100,f.x+310,f.z-1090,f.z+1490]),nodes=[start,end];
 for(const [a,b,c,d] of bounds)for(const x of [a-18,b+18])for(const z of [c-18,d+18])if(!bounds.some(([l,r,n,s])=>x>=l&&x<=r&&z>=n&&z<=s))nodes.push([x,z]);
 function clear(a,b){for(const box of bounds){let lo=0,hi=1;for(let k=0;k<2;k++){const delta=b[k]-a[k],l=box[k*2],r=box[k*2+1];if(Math.abs(delta)<.0001){if(a[k]<l||a[k]>r){hi=-1;break}}else{const u=(l-a[k])/delta,v=(r-a[k])/delta;lo=Math.max(lo,Math.min(u,v));hi=Math.min(hi,Math.max(u,v))}}if(lo<=hi)return false}return true}
 const cost=nodes.map(()=>Infinity),prev=nodes.map(()=>-1),done=new Set();cost[0]=0;
 while(true){let n=-1;for(let j=0;j<nodes.length;j++)if(!done.has(j)&&Number.isFinite(cost[j])&&(n<0||cost[j]<cost[n]))n=j;if(n<0)return [];if(n===1)break;done.add(n);
  for(let j=1;j<nodes.length;j++){if(done.has(j))continue;const a=nodes[n],b=nodes[j],c=cost[n]+Math.hypot(b[0]-a[0],b[1]-a[1]);if(c<cost[j]&&clear(a,b)){cost[j]=c;prev[j]=n}}}
 const route=[];for(let n=1;n!==-1;n=prev[n])route.unshift(nodes[n]);return route}
// The Highlands uses genuine OSM streets. Only the fictional maps get
// invented service roads between their airports.
for(const field of fictionalFields){const isle=regionalIslands[field.region][field.cluster],near=isle.fields.filter(f=>f!==field).sort((a,b)=>Math.hypot(a.x-field.x,a.z-field.z)-Math.hypot(b.x-field.x,b.z-field.z)).slice(0,2);
 if(!near.length)near.push({name:field.name+' service road',x:field.x+3100,z:field.z+1550});
 for(const other of near){const key=[field.name,other.name].sort().join('|');if(roadKeys.has(key))continue;roadKeys.add(key);const route=roadPath([field.x+545,field.z+490],[other.x+545,other.z+490],isle.fields);if(route.length<2)continue;
 const road={region:field.region,len:0,segments:[]};for(let j=1;j<route.length;j++){const [x,z]=route[j-1],[endX,endZ]=route[j],dx=endX-x,dz=endZ-z,len=Math.hypot(dx,dz),ux=dx/len,uz=dz/len,px=-uz,pz=ux;road.segments.push({x,z,ux,uz,px,pz,len,offset:road.len});road.len+=len;
 const steps=Math.ceil(len/140),mesh=isle.decor;
 function edge(t,side,dy){const xx=x+dx*t+px*side,zz=z+dz*t+pz*side;return[xx,terrainHeight(xx,zz,field.region)+dy,zz]}
 for(let k=0;k<steps;k++){const t=k/steps,u=(k+1)/steps;face([edge(t,-6,.38),edge(u,-6,.38),edge(u,6,.38),edge(t,6,.38)],'#586466',mesh);if(k%2===0)face([edge(t,-.32,.44),edge((t+u)*.5,-.32,.44),edge((t+u)*.5,.32,.44),edge(t,.32,.44)],'#d9d0a4',mesh)}
 }roadNetwork.push(road)}}
function sampleCar(car,time){const road=car.route,phase=(time*car.speed/road.len+car.phase+(car.backward?1:0))%2,back=phase>1,at=(back?2-phase:phase)*road.len;
 const segment=road.segments.find(s=>at<=s.offset+s.len)||road.segments[road.segments.length-1],d=at-segment.offset,lane=back?-2.7:2.7;
 return{x:segment.x+segment.ux*d+segment.px*lane,z:segment.z+segment.uz*d+segment.pz*lane,heading:Math.atan2(segment.ux,segment.uz)+(back?Math.PI:0)}}
// Local scenery clusters can be culled without traversing individual trees or buildings.
const scenicGroups=maps.map(()=>[]),landmarks=maps.map(()=>[]),rotors=[];
function sceneryGroup(i,x,z,range=4400){const g={x,z,range,mesh:[]};scenicGroups[i.region].push(g);return g.mesh}
// Index each physical building independently from the large scenery batches.
// Destroyed faces are replaced in a *new* mesh array: WebGL/WebGPU cache buffers
// by array identity, so mutating the original array would leave a ghost building.
const buildingCells=new Map(),buildingFragments=[],buildingBursts=[];
const buildingCellSize=280;
function buildingCellKey(region,x,z){return region+':'+Math.floor(x/buildingCellSize)+':'+Math.floor(z/buildingCellSize)}
function registerBuilding(region,group,pts,base,h,nearStart,farStart,ultraStart=-1){
 const xs=pts.map(p=>p[0]),zs=pts.map(p=>p[1]);
 const b={region,group,pts,base,h,nearStart,nearEnd:group.mesh.length,farStart,farEnd:group.farMesh?.length||0,
  ultraStart,ultraEnd:ultraStart<0?-1:(group.ultraFarMesh?.length||0),
  minX:Math.min(...xs),maxX:Math.max(...xs),minZ:Math.min(...zs),maxZ:Math.max(...zs),
  x:(Math.min(...xs)+Math.max(...xs))*.5,z:(Math.min(...zs)+Math.max(...zs))*.5,destroyed:false};
 const minX=Math.floor(b.minX/buildingCellSize),maxX=Math.floor(b.maxX/buildingCellSize),
  minZ=Math.floor(b.minZ/buildingCellSize),maxZ=Math.floor(b.maxZ/buildingCellSize);
 for(let a=minX;a<=maxX;a++)for(let c=minZ;c<=maxZ;c++){
  const key=region+':'+a+':'+c;if(!buildingCells.has(key))buildingCells.set(key,[]);
  buildingCells.get(key).push(b);
 }
 return b;
}
function pointInsideBuilding(x,z,pts){
 let inside=false;
 for(let i=0,j=pts.length-1;i<pts.length;j=i++){
  const a=pts[i],b=pts[j];if((a[1]>z)!==(b[1]>z)&&x<(b[0]-a[0])*(z-a[1])/(b[1]-a[1])+a[0])inside=!inside;
 }
 return inside;
}
function struckBuilding(p){
 // Sample the nose and wing roots as well as the aircraft centre. Using height
 // above the roof prevents invisible collisions when merely flying over a town.
 const sin=Math.sin(p.heading),cos=Math.cos(p.heading),nose=spec.noseZ*.8;
 const samples=[[p.x,p.z],[p.x+sin*nose,p.z+cos*nose],
  [p.x+cos*spec.span*.22,p.z-sin*spec.span*.22],[p.x-cos*spec.span*.22,p.z+sin*spec.span*.22]];
 const checked=new Set();
 for(const [x,z] of samples){
  const cell=buildingCells.get(buildingCellKey(activeMap,x,z));if(!cell)continue;
  for(const b of cell){
   if(b.destroyed||checked.has(b))continue;checked.add(b);
   if(x<b.minX-2||x>b.maxX+2||z<b.minZ-2||z>b.maxZ+2||
      p.y>b.base+b.h+spec.bodyHeight+2||p.y+spec.bodyHeight<b.base-5)continue;
   if(pointInsideBuilding(x,z,b.pts))return b;
  }
 }
 return null;
}
function releaseBuildingFragments(x,y,z,extent,colours){
 buildingBursts.push({x,y,z,size:clamp(extent*.7,9,55),age:0,region:activeMap});
 if(buildingBursts.length>28)buildingBursts.shift();
 const count=clamp(Math.round(12+extent*.17),13,36);
 for(let i=0;i<count;i++){
  const a=random()*tau,spread=3+random()*Math.min(40,extent*.65),rise=4+random()*27;
  buildingFragments.push({x:x+(random()-.5)*extent*.6,y:y+random()*extent*.65,z:z+(random()-.5)*extent*.6,
   vx:Math.cos(a)*spread,vy:rise,vz:Math.sin(a)*spread,scale:.7+random()*Math.min(4,extent*.1),
   ttl:3.3+random()*3.2,color:colours[i%colours.length],region:activeMap});
 }
 if(buildingFragments.length>650)buildingFragments.splice(0,buildingFragments.length-650);
}
function explodeBuilding(b){
 if(b.destroyed)return;
 b.destroyed=true;
 destroyedBuildings.push(b);
 if(!b.group.intactMesh){b.group.intactMesh=b.group.mesh;b.group.intactFarMesh=b.group.farMesh;b.group.intactUltraFarMesh=b.group.ultraFarMesh}
 const clear=(mesh,start,end)=>{
  const replacement=mesh.slice();
  for(let i=start;i<end;i++)replacement[i]={points:[],color:'#64605c'};
  // Low permanent rubble: no giant fireball or disappearing whole districts.
  const half=Math.min(15,Math.max(2,(b.maxX-b.minX+b.maxZ-b.minZ)*.11));
  const y=b.base+.18;
  face([[b.x-half,y,b.z-half],[b.x+half,y+.5,b.z-half],[b.x+half,y,b.z+half],[b.x-half,y+.3,b.z+half]],'#77716b',replacement);
  return replacement;
 };
 b.group.mesh=clear(b.group.mesh,b.nearStart,b.nearEnd);
 if(b.group.farMesh)b.group.farMesh=clear(b.group.farMesh,b.farStart,b.farEnd);
 if(b.ultraStart>=0&&b.group.ultraFarMesh)b.group.ultraFarMesh=clear(b.group.ultraFarMesh,b.ultraStart,b.ultraEnd);
 releaseBuildingFragments(b.x,b.base+b.h*.35,b.z,Math.max(9,b.h),['#d0b9a3','#8a8987','#766d67','#f2a84f','#e8d6b2']);
}
function repairBuildings(){
 const restored=new Set();
 for(const b of destroyedBuildings){
  b.destroyed=false;
  if(restored.has(b.group))continue;
  restored.add(b.group);b.group.mesh=b.group.intactMesh;b.group.farMesh=b.group.intactFarMesh;b.group.ultraFarMesh=b.group.intactUltraFarMesh;
  delete b.group.intactMesh;delete b.group.intactFarMesh;delete b.group.intactUltraFarMesh;
 }
 destroyedBuildings.length=0;buildingFragments.length=0;buildingBursts.length=0;
}
function updateBuildingFragments(dt){
 for(let i=buildingBursts.length-1;i>=0;i--){buildingBursts[i].age+=dt;if(buildingBursts[i].age>3.5)buildingBursts.splice(i,1)}
 for(let i=buildingFragments.length-1;i>=0;i--){
  const f=buildingFragments[i];f.ttl-=dt;
  if(f.ttl<=0){buildingFragments.splice(i,1);continue}
  f.vy-=19.6*dt;f.x+=f.vx*dt;f.y+=f.vy*dt;f.z+=f.vz*dt;
  const ground=terrainHeight(f.x,f.z,f.region)+.1;
  if(f.y<ground){f.y=ground;f.vy=Math.max(0,-f.vy*.21);f.vx*=Math.exp(-2.8*dt);f.vz*=Math.exp(-2.8*dt)}
 }
}
function prism(mesh,x,y,z,w,h,d,c,roof){const lower=[[x-w,y,z-d],[x+w,y,z-d],[x+w,y,z+d],[x-w,y,z+d]],upper=lower.map(([a,b,c])=>[a,b+h,c]);for(let j=0;j<4;j++)face([lower[j],lower[(j+1)%4],upper[(j+1)%4],upper[j]],c,mesh);face(upper,roof||c,mesh)}
function taper(mesh,x,y,z,a,b,h,c,n=9){for(let j=0;j<n;j++){let t=tau*j/n,u=tau*(j+1)/n;face([[x+a*Math.cos(t),y,z+a*Math.sin(t)],[x+a*Math.cos(u),y,z+a*Math.sin(u)],[x+b*Math.cos(u),y+h,z+b*Math.sin(u)],[x+b*Math.cos(t),y+h,z+b*Math.sin(t)]],c,mesh)}}
