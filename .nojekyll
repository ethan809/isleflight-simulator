  const noseGap=p.y-surfaceY+spec.noseZ*Math.sin(p.pitch);
  const touching=mainGap<=0||noseGap<=0;
  const runway=touching?fieldBelow:null;
  const overWater=touching&&!runway&&!landMask(p.x,p.z,activeMap);
  if(touching&&!runway&&overWater&&p.y<spec.bodyHeight+2){
   p.ditching=true;p.sinkTime=0;p.throttle=p.power=0;p.engineHP=Math.max(0,p.engineHP-65);p.gearHP=Math.max(0,p.gearHP-55);
   compressAirframe(p,'belly',clamp(.20+Math.abs(p.vs)/35,.2,.85));compressAirframe(p,'nose',clamp(.1+p.speed/330,.1,.6));
   p.crashed=true;p.health=Math.max(3,p.health-Math.min(90,25+Math.abs(p.vs)*3+p.speed*.2));p.damageNote='Water impact · fuselage buckled · sinking';p.landing='';p.air=false;return;
  }
