function coveredByMappedEnglishHouses(x,z){return realEnglandZones.some(a=>Math.abs(x-a[0])<a[2]&&Math.abs(z-a[1])<a[3])}
for(const [ci,city] of englandCities.entries()){
 const count=city.major?14:10,spacing=city.major?195:170,half=count*spacing/2;
 const mesh=sceneryGroup(city,city.x,city.z,city.major?17500:12000),group=scenicGroups[4][scenicGroups[4].length-1];
 group.farMesh=[];group.nearRange=city.major?10800:8500;group.extent=half*1.55;
 const material=['#a9aa9e','#b9aaa0','#b3bdb6','#989f9d','#a8b3b5','#c2bbae'];
 const roofing=['#696e73','#726764','#737b75','#7e6c60','#878580'];
 const ground=(x,z)=>englandHeight(x,z);
 const strip=(ax,az,bx,bz,width,colour,near=true)=>{
  const length=Math.hypot(bx-ax,bz-az),sections=Math.max(1,Math.ceil(length/55));
  const nx=-(bz-az)/length*width,nz=(bx-ax)/length*width;
  for(let k=0;k<sections;k++){
   const t=k/sections,u=(k+1)/sections,x=mix(ax,bx,t),z=mix(az,bz,t),xx=mix(ax,bx,u),zz=mix(az,bz,u);
   if(!englandLand((x+xx)*.5,(z+zz)*.5)||!englandAirportClear((x+xx)*.5,(z+zz)*.5,110))continue;
   const p=(x,z)=>[x,ground(x,z)+(near?.76:.81),z];
   face([p(x+nx,z+nz),p(xx+nx,zz+nz),p(xx-nx,zz-nz),p(x-nx,z-nz)],colour,mesh);
   mesh[mesh.length-1].material=near?3:4;
  }
 };
 for(let j=0;j<=count;j++){
  const at=-half+j*spacing;
  strip(city.x+at,city.z-half,city.x+at,city.z+half,city.major?9:7,'#4b5155');
  strip(city.x-half,city.z+at,city.x+half,city.z+at,city.major?9:7,'#4a5256');
  if(j%4===1){
   for(const horizontal of [false,true]){
    const a=horizontal?[city.x-half,city.z+at]:[city.x+at,city.z-half];
    const b=horizontal?[city.x+half,city.z+at]:[city.x+at,city.z+half];
    if(!englandAirportClear(...a,270)||!englandAirportClear(...b,270))continue;
    const dx=b[0]-a[0],dz=b[1]-a[1],len=Math.hypot(dx,dz),ux=dx/len,uz=dz/len;
    roadNetwork.push({region:4,len,segments:[{x:a[0],z:a[1],ux,uz,px:-uz,pz:ux,len,offset:0}]});
   }
  }
 }
 for(let row=0;row<count;row++)for(let col=0;col<count;col++){
  const hash=((row*1327+col*479+ci*9011)^((row+ci)*169))>>>0;
  if(hash%17===0)continue;
  const x=city.x+(row+.5)*spacing-half,z=city.z+(col+.5)*spacing-half;
  if(!englandLand(x,z)||!englandAirportClear(x,z,155)||coveredByMappedEnglishHouses(x,z))continue;
  const central=Math.hypot(row-count/2+.5,col-count/2+.5);
  const skyscraper=city.major&&central<3.6&&hash%7<=2;
  const commercial=city.major&&central<5.5||hash%9===2;
  const w=(commercial?45:27)+(hash%17),d=(commercial?42:27)+(hash%23);
  const h=skyscraper?65+hash%128:commercial?14+hash%44:7+hash%13;
  const highest=Math.max(ground(x-w,z-d),ground(x+w,z-d),ground(x+w,z+d),ground(x-w,z+d));
  const y=highest+.34,wall=skyscraper?'#839ba7':material[hash%material.length],roof=roofing[(hash>>>3)%roofing.length];
  const nearStart=mesh.length,farStart=group.farMesh.length;
  prism(mesh,x,y,z,w,h,d,wall,skyscraper?'#a0b1b8':roof);
  prism(group.farMesh,x,y,z,w,h,d,wall,skyscraper?'#a0b1b8':roof);
  const top=y+h;
  if(!commercial){
   const ridge=top+Math.min(4.8,3.1+h*.11);
   face([[x-w,top,z-d],[x, ridge,z-d],[x,ridge,z+d],[x-w,top,z+d]],'#82665c',mesh);
   face([[x,ridge,z-d],[x+w,top,z-d],[x+w,top,z+d],[x,ridge,z+d]],'#745e58',mesh);
   face([[x-w,top,z-d],[x, ridge,z-d],[x,ridge,z+d],[x-w,top,z+d]],'#82665c',group.farMesh);
   face([[x,ridge,z-d],[x+w,top,z-d],[x+w,top,z+d],[x,ridge,z+d]],'#745e58',group.farMesh);
  }else if(skyscraper){
   // Narrow, offset glazing bands give office towers independent facades.
   for(let floor=1;floor<Math.floor(h/5);floor++){
    const yy=y+floor*5.0,c=floor%4===0?'#617b89':'#546d79';
    face([[x-w-.18,yy,z-d+2],[x-w-.18,yy+2.2,z-d+2],[x-w-.18,yy+2.2,z+d-2],[x-w-.18,yy,z+d-2]],c,mesh);
    face([[x+w+.18,yy,z-d+2],[x+w+.18,yy+2.2,z-d+2],[x+w+.18,yy+2.2,z+d-2],[x+w+.18,yy,z+d-2]],c,mesh);
   }
   prism(mesh,x+1,top,z+1,w*.22,3.5,d*.24,'#82969c','#c2c9c8');
  }
  registerBuilding(4,group,[[x-w,z-d],[x+w,z-d],[x+w,z+d],[x-w,z+d]],y,h,nearStart,farStart);
 }
