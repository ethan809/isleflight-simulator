 ctx.strokeStyle='#73d5ab';ctx.beginPath();ctx.arc(x,53,r,Math.PI*.75,angle);ctx.stroke();ctx.lineWidth=1;
 label(Math.round(p.power*100)+'%',x-13,60,'#def8eb',spec.engines===4?10:13);label('ENG '+(side+1),x-16,90)}
 label('GEAR '+gear,8,108,gear==='DOWN'?'#91edba':'#f0ca76');label('FLP '+flapNames[p.flapTarget],89,108,'#a6cfbd',9);
 let info=pathInfo(p,destination());label(info.visible?'PATH  '+(info.whites>2?'HIGH':info.whites<2?'LOW':'ON SLOPE'):'DEST  '+destination().name,8,132,'#92d9f1',13);
 label(Math.round(p.vs*196.85/10)*10+' FT/MIN',8,154,'#90eab6',14)}
 ctx.restore()}
 if(spec.kind==='fighter'){
