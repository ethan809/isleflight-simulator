 svgParts.svgDistance.textContent=(Math.hypot(p.x-dest.x,p.z-dest.z)/1000).toFixed(1)+' KM';
 svgParts.svgEngineArc.setAttribute('stroke-dashoffset',(226.2*(1-clamp(p.power,0,1))).toFixed(2));
 svgParts.svgPower.textContent=Math.round(p.power*100)+'%';
