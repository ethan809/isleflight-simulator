function cloudSprite(index){const density=2,w=320*density,h=116*density,sheet=document.createElement('canvas');sheet.width=w;sheet.height=h;const b=sheet.getContext('2d'),pic=b.createImageData(w,h),pix=pic.data,lobes=[[160,68,124,17]];
 const s=index*1777;function hash(x,y){let h=Math.imul(x+23+s,1597334677)^Math.imul(y+11,3812015801);h=Math.imul(h^(h>>>16),2246822519);return (h>>>0)/4294967296}
 function noise(x,y){const a=Math.floor(x),b=Math.floor(y);let u=x-a,v=y-b;u=u*u*(3-2*u);v=v*v*(3-2*v);return mix(mix(hash(a,b),hash(a+1,b),u),mix(hash(a,b+1),hash(a+1,b+1),u),v)}
 for(let j=0;j<10;j++){const f=j/9,crown=Math.sin(Math.PI*f);lobes.push([25+f*269,68-crown*(8+hash(j,19)*21),23+crown*(8+hash(j,35)*11),13+crown*(6+hash(j,47)*19)])}
 for(let y=6*density;y<103*density;y++)for(let x=2*density;x<317*density;x++){const px=x/density,py=y/density;let field=-1;for(const [cx,cy,rx,ry] of lobes){const dx=(px-cx)/rx,dy=(py-cy)/ry;field=Math.max(field,1-dx*dx-dy*dy)}if(field<-.49)continue;
  const v=.53*noise(px*.034,py*.043)+.27*noise(px*.077,py*.083)+.14*noise(px*.17,py*.19)+.06*noise(px*.37,py*.42),thick=field+(v-.48)*1.23;
  const alpha=smooth(-.24,.55,thick)*.93;if(alpha<.008)continue;const light=clamp(.53+(56-py)*.010+(v-.46)*.85+.06*(1-Math.max(0,field)),.12,1),i=(y*w+x)*4;pix[i]=mix(177,255,light);pix[i+1]=mix(194,253,light);pix[i+2]=mix(207,243,light);pix[i+3]=alpha*255;
 }b.putImageData(pic,0,0);return sheet}
const cloudSheets=Array.from({length:4},(_,i)=>cloudSprite(i));
const clouds=Array.from({length:112},(_,i)=>[(random()-.5)*46000,500+random()*2100,(random()-.5)*46000,750+random()*1900,i%4]);
const waveSpecks=Array.from({length:260},()=>({x:(random()-.5)*12400,z:(random()-.5)*12400,length:3+random()*14,phase:random()*tau}));
function tiled(position,eye,period){return position+Math.round((eye-position)/period)*period}
let wingView=[],model=[];function part(pts,c){face(pts,c,model)}
function tube(stations,ox,oy,colors){const n=48;let fine=[stations[0]],segments=[];for(let k=1;k<stations.length;k++){let a=stations[k-1],b=stations[k],count=Math.ceil((b[0]-a[0])/(ox?1.5:1.0));for(let j=1;j<=count;j++){fine.push(a.map((v,i)=>mix(v,b[i],j/count)));segments.push(k)}}let rings=fine.map(([z,r,h])=>Array.from({length:n},(_,i)=>[ox+r*Math.cos(tau*i/n),oy+h*Math.sin(tau*i/n),z]));for(let k=1;k<rings.length;k++)for(let i=0;i<n;i++){let j=(i+1)%n;part([rings[k-1][i],rings[k-1][j],rings[k][j],rings[k][i]],colors(Math.floor(i/2),segments[k-1],(i+.5)*tau/n,fine[k][0]))}}
